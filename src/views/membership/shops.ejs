<div class="hero">
  <h1><%= t('membership.shops.title') %></h1>
  <p class="tagline"><%= t('membership.shops.tagline') %></p>
  <% if (shopPlan) { %>
  <p class="price"><strong><%= fmtMoney(shopPlan.price_cents) %></strong> / <%= t('membership.per_year') %></p>
  <% } %>
  <% if (loggedIn && paypalReady) { %>
  <form method="post" action="/membership/subscribe/tattoo_shop">
    <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
    <button class="btn btn-primary" type="submit"><%= t('membership.shops.cta') %></button>
  </form>
  <% } else if (!loggedIn) { %>
  <p><a class="btn btn-primary" href="/signup?plan=tattoo_shop"><%= t('membership.shops.cta') %></a></p>
  <p class="muted"><%= t('membership.shops.login_note') %></p>
  <% } %>
</div>

