<h1>Membership</h1>
<div class="card">
  <h2>Which plan is for me?</h2>
  <ul>
    <li><strong>I want to sell my art and earn 60% per sale</strong> → Design artist, $5/month.</li>
    <li><strong>I own a tattoo shop and want 20% on every sale I refer</strong> → Tattoo shop, $99.99/year.</li>
    <li><strong>I just want custom designs, pre-made designs, and early access</strong> → Customer, $5/month.</li>
  </ul>
  <p class="muted">Uploading art is free for every account — a plan is only needed to earn commission.</p>
</div>
<% if (!paypalReady) { %>
<div class="card"><p><strong>Payments are being set up.</strong> Membership checkout via PayPal will be available soon — your account works for browsing in the meantime.</p></div>
<% } %>

<h2>Plans</h2>
<% if (firstMonthEligible) { %>
<div class="card"><p><strong>New here?</strong> Your first month of the Customer monthly plan is <strong><%= money(firstMonthPrice) %></strong>, then <%= money(500) %>/month. One per account.</p></div>
<% } %>
<% if (foundingShop) { %>
<div class="card"><p><strong>Founding tattoo shops:</strong> join now and your first year is <strong><%= money(foundingPrice) %></strong> (normally $99.99/year). Renews at the regular price. Offer ends <%= new Date(foundingEnds).toLocaleDateString() %>.</p></div>
<% } %>
<div class="grid">
  <% plans.forEach(function(p) { %>
  <div class="card">
    <h3><%= p.name %></h3>
    <p><strong><%= money(p.price_cents) %></strong> / <%= p.interval %></p>
    <p class="muted"><%= p.description %></p>
    <% if (p.slug === 'tattoo_shop' && foundingShop) { %>
    <p><strong>First year <%= money(foundingPrice) %></strong> for founding shops — renews at <%= money(p.price_cents) %>/year.</p>
    <% } %>
    <% if (p.slug === 'customer' && firstMonthEligible) { %>
    <p><strong>First month <%= money(firstMonthPrice) %></strong>, then <%= money(p.price_cents) %>/month.</p>
    <% } %>
    <% if (p.slug === 'customer_annual' && !annualReady) { %>
    <p class="muted"><strong>Annual plan coming soon</strong> — the yearly plan is being set up. The monthly plan is ready now.</p>
    <% } else if (paypalReady) { %>
    <form method="post" action="/membership/subscribe/<%= p.slug %>">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button class="btn" type="submit">Subscribe</button>
    </form>
    <% } %>
  </div>
  <% }); %>
</div>

<h2>Refer a friend — earn a free month</h2>
<div class="card">
  <p>Share your personal link. When a friend becomes a paying member, <strong>you get one free month</strong> of membership.</p>
  <p><strong>Your link:</strong> <input type="text" readonly value="<%= baseUrl %>/signup?ref=<%= referralCode %>" onclick="this.select()" style="width:100%"></p>
  <p class="muted">Your code: <strong><%= referralCode %></strong></p>
  <% if (redemptions.length) { %>
  <h3>Free months earned</h3>
  <ul>
    <% redemptions.forEach(function(r) { %>
    <li>One free month (through <%= new Date(r.free_month_end).toLocaleDateString() %>) — <span class="badge <%= r.status === 'active' ? 'ok' : '' %>"><%= r.status %></span></li>
    <% }); %>
  </ul>
  <% } %>
</div>

<h2>Your subscriptions</h2>
<% if (!subs.length) { %><p class="muted">No subscriptions yet.</p><% } %>
<table>
  <thead><tr><th>Plan</th><th>Status</th><th>Renews</th><th></th></tr></thead>
  <tbody>
  <% subs.forEach(function(s) { %>
    <tr>
      <td><%= s.plan_name %></td>
      <td><span class="badge <%= s.status === 'active' ? 'ok' : 'warn' %>"><%= s.status %></span></td>
      <td><%= s.current_period_end ? new Date(s.current_period_end).toLocaleDateString() : '—' %></td>
      <td>
        <% if (s.status === 'active') { %>
        <form method="post" action="/membership/cancel/<%= s.id %>" onsubmit="return confirm('Cancel this membership? All memberships are final and non-refundable.')">
          <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <button class="btn btn-secondary" type="submit">Cancel</button>
        </form>
        <% } %>
      </td>
    </tr>
  <% }); %>
  </tbody>
</table>
<p class="muted">All memberships are final and non-refundable. Canceling stops renewal; access continues until the period ends.</p>
