<h1><%= t('membership.title') %></h1>
<div class="card">
  <h2><%= t('membership.which') %></h2>
  <ul>
    <li><strong><%= t('membership.sell_art') %></strong> <%= t('membership.sell_art_tail', {price: fmtMoney(567)}) %></li>
    <li><strong><%= t('membership.own_shop') %></strong> <%= t('membership.own_shop_tail', {price: fmtMoney(10398)}) %> <strong><%= t('membership.includes_artist') %></strong>
      <br><a href="/membership/shops"><%= t('membership.shop_page_link') %></a></li>
    <li><strong><%= t('membership.just_customer') %></strong> <%= t('membership.just_customer_tail', {price: fmtMoney(567)}) %></li>
  </ul>
  <p class="muted"><%= t('membership.upload_free') %></p>
</div>
<% if (!paypalReady) { %>
<div class="card"><p><strong><%= t('membership.payments_setup') %></strong> <%= t('membership.payments_setup_tail') %></p></div>
<% } %>

<h2><%= t('membership.plans') %></h2>
<% if (firstMonthEligible) { %>
<div class="card"><p><strong><%= t('membership.new_here') %></strong> <%= t('membership.first_month_tail', {first: fmtMoney(firstMonthPrice), price: fmtMoney(customerPlanPrice)}) %></p></div>
<% } %>
<% if (foundingShop) { %>
<div class="card"><p><strong><%= t('membership.founding') %></strong> <%= t('membership.founding_tail', {price: fmtMoney(foundingPrice), regular: fmtMoney(10398), left: fmtNum(shopsLeft), date: new Date(foundingEnds).toLocaleDateString(localeTag)}) %></p></div>
<% } %>
<div class="grid">
  <% plans.forEach(function(p) { %>
  <div class="card">
    <h3><%= p.name %></h3>
    <p><strong><%= fmtMoney(p.price_cents) %></strong> / <%= p.interval === 'month' ? t('membership.per_month') : t('membership.per_year') %></p>
    <p class="muted"><%= p.description %></p>
    <% if (p.slug === 'tattoo_shop' && foundingShop) { %>
    <p><strong><%= t('membership.first_year', {price: fmtMoney(foundingPrice)}) %></strong> — <%= t('membership.renews_at', {price: fmtMoney(p.price_cents)}) %></p>
    <% } %>
    <% if (p.slug === 'customer' && firstMonthEligible) { %>
    <p><strong><%= t('membership.first_month_plan', {price: fmtMoney(firstMonthPrice)}) %></strong><%= t('membership.then', {price: fmtMoney(p.price_cents)}) %></p>
    <% } %>
    <% if (vatNote) { %><p class="muted fineprint"><%= vatNote %></p><% } %>
    <% if (p.slug === 'customer_annual' && !annualReady) { %>
    <p class="muted"><strong><%= t('membership.annual_soon') %></strong> <%= t('membership.annual_soon_tail') %></p>
    <% } else if (paypalReady) { %>
    <% const _pfx = fxNote(p.price_cents); if (_pfx) { %><p class="muted fineprint"><%= _pfx %></p><% } %>
    <form method="post" action="/membership/subscribe/<%= p.slug %>">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button class="btn" type="submit"><%= t('membership.subscribe') %></button>
    </form>
    <% } %>
    <% if (typeof creditBaseBySlug !== 'undefined' && creditBaseBySlug[p.slug]) { %>
    <form method="post" action="/membership/credit/<%= p.slug %>" onsubmit="return confirm('Pay one <%= p.interval %> of <%= p.name %> with site credit (<%= fmtMoney(creditBaseBySlug[p.slug]) %>)? No auto-renewal.')">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <p><button class="btn btn-secondary" type="submit"><%= t('membership.pay_credit', {price: fmtMoney(creditBaseBySlug[p.slug])}) %></button><br>
      <span class="muted"><%- t('membership.credit_note', {interval: p.interval === 'month' ? t('membership.per_month') : t('membership.per_year'), credit: fmtMoney(typeof creditBalance !== 'undefined' ? creditBalance : 0), redeem: '<a href="/gift-cards/redeem">' + t('membership.redeem') + '</a>'}) %></span></p>
    </form>
    <% } %>
  </div>
  <% }); %>
</div>

<h2><%= t('membership.refer') %></h2>
<div class="card">
  <p><%= t('membership.refer_text') %></p>
  <p><strong><%= t('membership.your_link') %></strong> <input type="text" readonly value="<%= baseUrl %>/signup?ref=<%= referralCode %>" onclick="this.select()" style="width:100%"></p>
  <p class="muted"><%= t('membership.your_code') %> <strong><%= referralCode %></strong></p>
  <% if (redemptions.length) { %>
  <h3><%= t('membership.free_months') %></h3>
  <ul>
    <% redemptions.forEach(function(r) { %>
    <li><%= t('membership.free_month', {date: new Date(r.free_month_end).toLocaleDateString(localeTag)}) %> <span class="badge <%= r.status === 'active' ? 'ok' : '' %>"><%= r.status %></span></li>
    <% }); %>
  </ul>
  <% } %>
</div>

<h2><%= t('membership.your_subs') %></h2>
<% if (!subs.length) { %><p class="muted"><%= t('membership.no_subs') %></p><% } %>
<table>
  <thead><tr><th><%= t('membership.th_plan') %></th><th><%= t('membership.th_status') %></th><th><%= t('membership.th_renews') %></th><th></th></tr></thead>
  <tbody>
  <% subs.forEach(function(s) { %>
    <tr>
      <td><%= s.plan_name %></td>
      <td><span class="badge <%= s.status === 'active' ? 'ok' : 'warn' %>"><%= s.status %></span></td>
      <td><%= s.current_period_end ? new Date(s.current_period_end).toLocaleDateString(localeTag) : '—' %></td>
      <td>
        <% if (s.status === 'active') { %>
        <form method="post" action="/membership/cancel/<%= s.id %>" onsubmit="return confirm('Cancel this membership? All memberships are final and non-refundable.')">
          <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <button class="btn btn-secondary" type="submit"><%= t('membership.cancel') %></button>
        </form>
        <% } else if (s.status === 'pending') { %>
        <a class="btn" href="/membership/resume/<%= s.id %>"><%= t('membership.complete_payment') %></a>
        <form method="post" action="/membership/cancel/<%= s.id %>" onsubmit="return confirm('Cancel this pending subscription?')" style="display:inline">
          <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <button class="btn btn-secondary" type="submit"><%= t('membership.cancel') %></button>
        </form>
        <% } %>
      </td>
    </tr>
  <% }); %>
  </tbody>
</table>
<p class="muted"><%= t('membership.final_note') %></p>
