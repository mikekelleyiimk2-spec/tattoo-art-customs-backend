<h1><%= t('merch.title') %></h1>
<h2><%= t(product.nameKey) %></h2>
<p class="muted"><%= t(product.blurbKey) %></p>
<p class="muted"><%= t('merch.fee_note') %></p>

<form method="post" action="/merch/catalog">
  <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
  <input type="hidden" name="product_id" value="<%= product.id %>">

  <div class="two-col">
    <div>
      <label for="tee-size"><%= t('merch.size') %></label>
      <select id="tee-size" name="size" required>
        <% sizes.forEach(function(s) { %>
        <option value="<%= s %>"<%= s === 'M' ? ' selected' : '' %>><%= s %> — <%= fmtMoney(withFee(priceFor(s))) %></option>
        <% }); %>
      </select>
    </div>
    <div>
      <label for="tee-color"><%= t('merch.color') %></label>
      <select id="tee-color" name="color" required>
        <% colors.forEach(function(c) { %>
        <option value="<%= c %>"><%= c.charAt(0).toUpperCase() + c.slice(1) %></option>
        <% }); %>
      </select>
    </div>
  </div>

  <div>
    <label for="tee-qty"><%= t('merch.qty') %></label>
    <input type="number" id="tee-qty" name="quantity" value="1" min="1" max="10" required>
  </div>

  <h2><%= t('merch.ship_h') %></h2>
  <div>
    <label for="ship-name"><%= t('merch.full_name') %></label>
    <input type="text" id="ship-name" name="ship_name" required maxlength="120" autocomplete="name">
  </div>
  <div>
    <label for="ship-address1"><%= t('merch.street') %></label>
    <input type="text" id="ship-address1" name="ship_address1" required maxlength="160" autocomplete="street-address">
  </div>
  <div>
    <label for="ship-address2"><%= t('merch.apt') %></label>
    <input type="text" id="ship-address2" name="ship_address2" maxlength="160">
  </div>
  <div class="two-col">
    <div>
      <label for="ship-city"><%= t('merch.city') %></label>
      <input type="text" id="ship-city" name="ship_city" required maxlength="80" autocomplete="address-level2">
    </div>
    <div>
      <label for="ship-state"><%= t('merch.state') %></label>
      <input type="text" id="ship-state" name="ship_state" maxlength="80" autocomplete="address-level1">
    </div>
  </div>
  <div class="two-col">
    <div>
      <label for="ship-zip"><%= t('merch.zip') %></label>
      <input type="text" id="ship-zip" name="ship_zip" required maxlength="20" autocomplete="postal-code">
    </div>
    <div>
      <label for="ship-country"><%= t('merch.country') %></label>
      <input type="text" id="ship-country" name="ship_country" value="US" maxlength="60" autocomplete="country-name">
    </div>
  </div>

  <p><button class="btn" type="submit"><%= t('merch.continue_payment') %></button></p>
  <% if (typeof paypalClientId !== 'undefined' && paypalClientId) { %><div data-pp-message data-pp-placement="product" data-pp-amount="25.00"></div><% } %>
</form>
<% if (vatNote) { %><p class="muted fineprint"><%= vatNote %></p><% } %>
<p class="muted"><%= t('merch.made_order') %></p>
