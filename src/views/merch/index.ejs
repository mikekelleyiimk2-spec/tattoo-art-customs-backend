<h1><%= t('merch.title') %></h1>
<img src="/img/logos/mikes-custom-tees-hero.webp" alt="Mike's Custom Tees™ logo" style="max-width:420px;width:100%;height:auto;display:block;margin:0 auto 1.5rem;" />

<% if (configured) { %>
<p><%= t('merch.intro') %></p>

<h2><%= t('merch.tee_h') %></h2>
<ul>
  <% sizes.forEach(function(s) { %>
  <li><strong><%= s %></strong> — <%= fmtMoney(withFee(priceFor(s))) %> <span class="muted"><%= t('merch.includes_fee') %></span></li>
  <% }); %>
</ul>
<p class="muted"><%= t('merch.colors', {colors: colors.join(', ')}) %></p>
<% if (vatNote) { %><p class="muted fineprint"><%= vatNote %></p><% } %>

<% if (typeof currentUser !== 'undefined' && currentUser) { %>
  <% if (ownedCount > 0) { %>
  <p><%- t(ownedCount === 1 ? 'merch.owned_one' : 'merch.owned_many', {count: fmtNum(ownedCount), account: '<a href="/account">' + t('merch.account') + '</a>'}) %></p>
  <% } else { %>
  <p><a class="btn" href="/gallery"><%= t('home.browse_gallery') %></a> <%= t('merch.browse_tail') %></p>
  <% } %>
<% } else { %>
<p><a class="btn" href="/login?next=<%= encodeURIComponent('/merch') %>"><%= t('merch.login') %></a> <%= t('merch.login_tail') %></p>
<% } %>

<% } else { %>
<h2><%= t('merch.soon_title') %></h2>
<p><%= t('merch.soon_text') %></p>
<form method="post" action="/merch/notify">
  <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
  <div>
    <label for="notify-email"><%= t('merch.notify_email') %></label>
    <input type="email" id="notify-email" name="email" required maxlength="160" autocomplete="email">
  </div>
  <p><button class="btn" type="submit"><%= t('merch.notify_me') %></button></p>
</form>
<% } %>

<p class="muted"><%= t('merch.made_order') %></p>
