<% var lc = (typeof likeCounts !== 'undefined' && likeCounts) || {}; %>
<h1><%= t('merch.title') %></h1>
<img src="/img/logos/mikes-custom-tees-hero.webp" alt="Mike's Custom Tees™ logo" style="max-width:420px;width:100%;height:auto;display:block;margin:0 auto 1.5rem;" />

<div class="card" style="border:2px solid #f5b942;background:#221a10;margin-bottom:1.5rem;">
  <h2 style="margin-top:0;"><%= t('merch.kids_h') %></h2>
  <p><%= t('merch.kids_text') %></p>
  <p><a class="btn" href="/doodle-to-tattoo"><%= t('merch.kids_cta') %></a></p>
</div>

<h2><%= t('merch.story_h') %></h2>
<p><%= t('merch.story_text') %></p>

<% if (configured) { %>
<p><%= t('merch.intro') %></p>

<h2><%= t('merch.tee_h') %></h2>
<ul>
  <% sizes.forEach(function(s) { %>
  <li><strong><%= s %></strong> — <%= fmtMoney(withFee(priceFor(s))) %> <span class="muted"><%= t('merch.includes_fee') %></span></li>
  <% }); %>
</ul>
<p class="muted"><%= t('merch.colors', {colors: colors.join(', ')}) %></p>
<% if (vatNote) { %><p class="muted fineprint"><%= vatNote %></p><% } %>

<% if (typeof currentUser !== 'undefined' && currentUser) { %>
  <% if (ownedCount > 0) { %>
  <p><%- t(ownedCount === 1 ? 'merch.owned_one' : 'merch.owned_many', {count: fmtNum(ownedCount), account: '<a href="/account">' + t('merch.account') + '</a>'}) %></p>
  <% } else { %>
  <p><a class="btn" href="/gallery"><%= t('home.browse_gallery') %></a> <%= t('merch.browse_tail') %></p>
  <% } %>
<% } else { %>
<p><a class="btn" href="/login?next=<%= encodeURIComponent('/merch') %>"><%= t('merch.login') %></a> <%= t('merch.login_tail') %></p>
<% } %>

<h2><%= t('merch.poster_h') %></h2>
<p><%= t('merch.poster_desc', {price: fmtMoney(posterPrice)}) %></p>
<% if (typeof currentUser !== 'undefined' && currentUser && ownedDesigns && ownedDesigns.length) { %>
<p class="muted"><%= t('merch.poster_pick') %></p>
<ul>
  <% ownedDesigns.forEach(function(d) { %>
  <li><strong><%= d.title %></strong> — <a class="btn btn-secondary" href="/prints/order/design/<%= d.id %>"><%= t('merch.poster_cta') %></a></li>
  <% }); %>
</ul>
<% } %>

<% } else { %>
<h2><%= t('merch.soon_title') %></h2>
<p><%= t('merch.soon_text') %></p>
<form method="post" action="/merch/notify">
  <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
  <div>
    <label for="notify-email"><%= t('merch.notify_email') %></label>
    <input type="email" id="notify-email" name="email" required maxlength="160" autocomplete="email">
  </div>
  <p><button class="btn" type="submit"><%= t('merch.notify_me') %></button></p>
</form>
<% } %>

<p class="muted"><%= t('merch.made_order') %></p>

<div class="card" style="margin-bottom:1rem;">
  <h3 style="margin-top:0;"><%= t('bcards.card_title') %></h3>
  <p><%= t('bcards.card_blurb') %></p>
  <p><a class="btn" href="/merch/business-cards"><%= t('bcards.card_cta') %></a></p>
</div>

<% if (affiliates && affiliates.length) { %>
<h2><%= t('merch.aff_h') %></h2>
<p class="muted"><%= t('merch.aff_disclosure') %></p>
<% affiliates.forEach(function(a) { %>
<div class="card" style="position:relative;margin-bottom:1rem;">
  <button type="button" class="fav-heart" data-fav-id="<%= a.id %>" data-fav-type="merch" aria-pressed="false" aria-label="<%= t('fav.add') %>" title="<%= t('fav.add') %>"></button><span class="like-count" data-like-count="<%= a.id %>" title="<%= t('toploved.loves', {count: lc[a.id] || 0}) %>">♥ <%= lc[a.id] || 0 %></span>
  <h3 style="margin-top:0;"><%= t(a.nameKey) %></h3>
  <p><%= t(a.blurbKey) %></p>
  <p><a class="btn" href="<%= a.url %>" target="_blank" rel="noopener nofollow sponsored"><%= t(a.ctaKey) %></a></p>
</div>
<% }); %>
<% } %>

<% if (podProducts && podProducts.length) { %>
<h2><%= t('merch.cat_h') %></h2>
<p class="muted"><%= t('merch.cat_sub') %></p>
<% podProducts.forEach(function(p) { %>
<div class="card" style="position:relative;margin-bottom:1rem;">
  <button type="button" class="fav-heart" data-fav-id="<%= p.id %>" data-fav-type="merch" aria-pressed="false" aria-label="<%= t('fav.add') %>" title="<%= t('fav.add') %>"></button><span class="like-count" data-like-count="<%= p.id %>" title="<%= t('toploved.loves', {count: lc[p.id] || 0}) %>">♥ <%= lc[p.id] || 0 %></span>
  <img src="<%= p.image %>" alt="<%= t(p.nameKey) %>" loading="lazy" style="max-width:320px;width:100%;height:auto;display:block;margin-bottom:0.75rem;">
  <h3 style="margin-top:0;"><%= t(p.nameKey) %></h3>
  <p><%= t(p.blurbKey) %></p>
  <% if (p.status === 'live' && printfulOk) { %>
  <p><a class="btn" href="/merch/catalog/<%= p.id %>"><%= t('merch.cat_order') %></a></p>
  <% } else { %>
  <p><span class="badge"><%= t('merch.cat_soon_badge') %></span></p>
  <form method="post" action="/merch/notify" style="margin-top:0.5rem;">
    <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
    <input type="email" name="email" required maxlength="160" autocomplete="email" placeholder="<%= t('merch.notify_email') %>" style="max-width:280px;">
    <button class="btn btn-secondary" type="submit"><%= t('merch.notify_me') %></button>
  </form>
  <% } %>
</div>
<% }); %>
<% } %>

<% if (typeof sheinProducts !== 'undefined' && sheinProducts && sheinProducts.length) { %>
<h2><%= t('merch.shein_h') %></h2>
<p class="muted"><%= t('merch.shein_sub') %></p>
<% sheinProducts.forEach(function(p) { %>
<div class="card" style="position:relative;margin-bottom:1rem;">
  <button type="button" class="fav-heart" data-fav-id="<%= p.id %>" data-fav-type="merch" aria-pressed="false" aria-label="<%= t('fav.add') %>" title="<%= t('fav.add') %>"></button><span class="like-count" data-like-count="<%= p.id %>" title="<%= t('toploved.loves', {count: lc[p.id] || 0}) %>">♥ <%= lc[p.id] || 0 %></span>
  <img src="<%= p.image %>" alt="<%= t(p.nameKey) %>" loading="lazy" style="max-width:320px;width:100%;height:auto;display:block;margin-bottom:0.75rem;">
  <h3 style="margin-top:0;"><%= t(p.nameKey) %></h3>
  <p><%= t(p.blurbKey) %></p>
  <p><a class="btn" href="<%= p.url %>" target="_blank" rel="noopener nofollow sponsored"><%= t(p.ctaKey) %></a></p>
</div>
<% }); %>
<% } %>

<% /* Ad placement (Polish Day 2026-10-27): one in-content unit after the
     full product lineup, above the tip jar — content first, ad last. */ %>
<%- include('../partials/ad-slot', {slot: 'merch_inline'}) %>

<%- include('../partials/tip-jar') %>
