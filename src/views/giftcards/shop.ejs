<h1><%= t('giftcards.shop_title') %></h1>
<p class="muted"><%- t('giftcards.shop_stats', {count: '<strong>' + fmtNum(cards.filter(c => c.status !== 'pending').length) + '</strong>', total: '<strong>' + fmtMoney(totalSold) + '</strong>', redeemed: '<strong>' + fmtNum(redeemedCount) + '</strong>'}) %></p>
<p class="muted"><%= t('giftcards.shop_note') %></p>
<% if (!cards.length) { %><p class="muted"><%= t('giftcards.shop_empty') %></p><% } %>
<% for (const c of cards) { %>
<section class="card">
  <h2><%= fmtMoney(c.amount_cents) %> — <code><%= c.code %></code></h2>
  <p class="muted"><%= t('giftcards.status') %> <%= c.status %> · <%= t('giftcards.bought_by', {name: c.purchaser_name || t('giftcards.a_customer'), date: new Date(c.created_at).toLocaleDateString(localeTag)}) %></p>
</section>
<% } %>
