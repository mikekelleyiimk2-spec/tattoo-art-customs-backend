<h1><%= t('giftcards.redeem_title') %></h1>
<p class="muted"><%= t('giftcards.redeem_sub') %></p>
<form method="post" action="/giftcards/redeem" class="form">
  <label><%= t('giftcards.code_label') %>
    <input type="text" name="code" maxlength="20" required placeholder="XXXX-XXXX-XXXX" style="text-transform:uppercase">
  </label>
  <label><%= t('giftcards.apply_to') %>
    <select name="booking_id" required>
      <% if (!bookings.length) { %><option value=""><%= t('giftcards.no_bookings') %></option><% } %>
      <% for (const b of bookings) { %>
      <option value="<%= b.id %>"><%= b.shop_name %> — <%= new Date(b.start_at).toLocaleString(localeTag, { timeZone: 'America/Chicago' }) %></option>
      <% } %>
    </select>
  </label>
  <button type="submit"><%= t('giftcards.redeem_btn') %></button>
</form>
