<h1>Redeem a Gift Card</h1>
<p class="muted">The full card value applies to your booking — no fees on redemption.</p>
<form method="post" action="/giftcards/redeem" class="form">
  <label>Gift card code
    <input type="text" name="code" maxlength="20" required placeholder="XXXX-XXXX-XXXX" style="text-transform:uppercase">
  </label>
  <label>Apply to booking
    <select name="booking_id" required>
      <% if (!bookings.length) { %><option value="">No upcoming bookings</option><% } %>
      <% for (const b of bookings) { %>
      <option value="<%= b.id %>"><%= b.shop_name %> — <%= new Date(b.start_at).toLocaleString('en-US', { timeZone: 'America/Chicago' }) %></option>
      <% } %>
    </select>
  </label>
  <button type="submit">Redeem</button>
</form>
