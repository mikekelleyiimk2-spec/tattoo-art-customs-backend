<h1><%= t('giftcards.success_title') %></h1>
<% if (already) { %><p class="muted"><%= t('giftcards.already') %></p><% } %>
<section class="card">
  <h2><%= t('giftcards.gift_card', {amount: fmtMoney(amount_cents)}) %></h2>
  <p><%= t('giftcards.your_code') %></p>
  <p><input type="text" readonly value="<%= code %>" onclick="this.select()" aria-label="<%= t('giftcards.code_label') %>" style="font-size:1.4rem;letter-spacing:.15em"></p>
  <p class="muted"><%- t('giftcards.emailed', {recipient: (typeof recipient !== 'undefined' && recipient) ? t('giftcards.recipient_tail') : '', redeem: '<a href="/giftcards/redeem">' + t('giftcards.redeem_a') + '</a>'}) %></p>
</section>
