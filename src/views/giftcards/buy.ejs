<h1><%= t('giftcards.buy_title') %></h1>
<p class="muted"><%= t('giftcards.buy_sub') %></p>

<form method="post" action="/giftcards/buy" class="form">
  <fieldset>
    <legend><%= t('giftcards.amount') %></legend>
    <% for (const p of presets) { %>
    <label><input type="radio" name="preset" value="<%= p %>" <%= p === 5000 ? 'checked' : '' %>> <%= fmtMoney(p) %></label>
    <% } %>
    <label><input type="radio" name="preset" value="" id="custom-radio"> <%= t('giftcards.custom') %>
      <input type="number" name="custom_amount" id="custom-amount" min="<%= minCustom / 100 %>" max="<%= maxCustom / 100 %>" step="1" placeholder="<%= minCustom / 100 %>–<%= maxCustom / 100 %>">
    </label>
  </fieldset>

  <div id="fee-preview" class="card">
    <h2><%= t('giftcards.what_pay') %></h2>
    <p><%= t('giftcards.card_value') %> <strong id="fp-base"><%= fmtMoney(defaultFees.base) %></strong><br>
    <%= t('giftcards.platform_fee') %> <span id="fp-fee"><%= fmtMoney(defaultFees.platformFee) %></span><br>
    <%= t('giftcards.processing') %> <span id="fp-proc"><%= fmtMoney(defaultFees.processing) %></span><br>
    <strong><%= t('giftcards.total') %> <span id="fp-total"><%= fmtMoney(defaultFees.total) %></span></strong></p>
  </div>

  <label><%= t('giftcards.recipient') %>
    <input type="email" name="recipient_email" maxlength="200" placeholder="friend@example.com">
  </label>

  <label><%= t('giftcards.for_shop') %>
    <select name="shop_user_id">
      <option value=""><%= t('giftcards.any_shop') %></option>
      <% for (const s of shops) { %>
      <option value="<%= s.id %>"><%= s.display_name %></option>
      <% } %>
    </select>
  </label>

  <% const _gfx = fxNote(defaultFees.total); if (_gfx) { %><p class="muted fineprint"><%= _gfx %></p><% } %>
  <% if (vatNote) { %><p class="muted fineprint"><%= vatNote %></p><% } %>
  <button type="submit"><%= t('giftcards.continue_paypal') %></button>
</form>

<script>
(function () {
  var presets = document.querySelectorAll('input[name="preset"]');
  var custom = document.getElementById('custom-amount');
  function currentCents() {
    var sel = document.querySelector('input[name="preset"]:checked');
    if (sel && sel.value) return parseInt(sel.value, 10);
    var v = parseFloat(custom.value || '0');
    return Math.round(v * 100);
  }
  async function refresh() {
    var cents = currentCents();
    if (!cents || cents <= 0) return;
    try {
      var r = await fetch('/giftcards/fees?amount_cents=' + cents);
      var j = await r.json();
      if (!j.ok) return;
      document.getElementById('fp-base').textContent = j.baseFmt;
      document.getElementById('fp-fee').textContent = j.platformFeeFmt;
      document.getElementById('fp-proc').textContent = j.processingFmt;
      document.getElementById('fp-total').textContent = j.totalFmt;
    } catch (e) { /* preview is best-effort */ }
  }
  presets.forEach(function (p) { p.addEventListener('change', refresh); });
  custom.addEventListener('input', function () {
    document.getElementById('custom-radio').checked = true;
    refresh();
  });
})();
</script>
