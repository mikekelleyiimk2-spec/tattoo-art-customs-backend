<h1><%= t('contests.enter_title') %></h1>
<p class="muted"><%= t('contests.enter_sub') %></p>

<form method="post" action="/contests/<%= contestId %>/enter" enctype="multipart/form-data">
  <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
  <div>
    <label for="entry-image"><%= t('contests.entry_image') %></label>
    <input type="file" id="entry-image" name="entry_image" accept="image/jpeg,image/png,image/webp" required>
  </div>
  <div>
    <label for="entry-note"><%= t('contests.entry_note') %></label>
    <textarea id="entry-note" name="note" rows="3" maxlength="500" placeholder="<%= t('contests.entry_note_ph') %>"></textarea>
  </div>
  <p><button class="btn" type="submit"><%= t('contests.submit_entry_btn') %></button></p>
</form>
