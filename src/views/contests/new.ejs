<h1><%= t('contests.new_title') %></h1>
<p class="muted"><%= t('contests.new_sub') %></p>

<form method="post" action="/contests">
  <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">

  <div>
    <label for="contest-title"><%= t('contests.f_title') %></label>
    <input type="text" id="contest-title" name="title" required maxlength="120" placeholder="<%= t('contests.f_title_ph') %>">
  </div>

  <div>
    <label for="contest-desc"><%= t('contests.f_brief') %></label>
    <textarea id="contest-desc" name="description" required rows="6" maxlength="4000" placeholder="<%= t('contests.f_brief_ph') %>"></textarea>
  </div>

  <div class="two-col">
    <div>
      <label for="contest-style"><%= t('contests.f_style') %></label>
      <select id="contest-style" name="style">
        <option value=""><%= t('contests.any_style') %></option>
        <% styles.forEach(function(s) { %><option value="<%= s %>"><%= s %></option><% }); %>
      </select>
    </div>
    <div>
      <label for="contest-placement"><%= t('contests.f_placement') %></label>
      <input type="text" id="contest-placement" name="size_placement" maxlength="200" placeholder="<%= t('contests.f_placement_ph') %>">
    </div>
  </div>

  <div>
    <label for="contest-prize"><%= t('contests.f_prize', {min: fmtMoney(minPrize)}) %></label>
    <select id="contest-prize" name="prize_cents" required>
      <% suggestions.forEach(function(s, i) { %>
      <option value="<%= s.prize %>"<%= i === 0 ? ' selected' : '' %>><%= t('contests.prize_option', {prize: fmtMoney(s.prize), total: fmtMoney(s.quote.totalCents)}) %></option>
      <% }); %>
    </select>
    <p class="muted"><%= t('contests.escrow_note') %></p>
  </div>

  <% const _cfx = typeof suggestions !== 'undefined' && suggestions.length ? fxNote(suggestions[0].quote.totalCents) : ''; if (_cfx) { %><p class="muted fineprint"><%= _cfx %></p><% } %>
  <% if (vatNote) { %><p class="muted fineprint"><%= vatNote %></p><% } %>
  <p><button class="btn" type="submit"><%= t('contests.post_pay') %></button></p>
</form>
<p class="muted"><%= t('contests.final_note') %></p>
