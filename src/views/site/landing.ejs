<style>
/* Below-the-fold sections (custom, steps, offer cards, work-with-us strip,
   guides row) — restyled dark by /css/home.css (.lp2-rest). */
.lp-offer-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem; margin: 1rem 0 1.5rem; }
.lp-offer { border: 1px solid var(--border, #2b241c); border-radius: 10px; padding: 1rem; background: var(--surface, #171310); }
.lp-offer h3 { margin: 0 0 .35rem; }
.lp-offer p { margin: 0 0 .7rem; }
.lp-offer .price { font-weight: bold; }
.lp-steps { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; margin: 1rem 0 1.5rem; }
.lp-step { text-align: center; padding: 1rem; }
.lp-step .num { display: inline-block; width: 2.2rem; height: 2.2rem; line-height: 2.2rem; border-radius: 50%; background: var(--accent); color: #fff; font-weight: bold; margin-bottom: .5rem; }
.lp-work ul { margin: .4rem 0 .8rem; padding-left: 1.15rem; }
.lp-guides-row { margin: 1rem 0 1.5rem; }
.lp-guides-row a { white-space: nowrap; }
</style>

<%# ================= HOME FACE (owner-approved standard, 2026-10-27) ====
    Dark, photographic, art-first: full-bleed koi hero with the brush
    wordmark over the real artwork, one pill search, the live hearts
    numbers (stated ONCE, here in the hero), and a row of REAL top-hearted
    color designs. Decluttered 2026-10-27: one job per section below. %>
<section class="lp2-hero">
  <img src="/img/landing/hero.webp" alt="<%= t('landing.hero.img_alt') %>" width="1200" height="514" fetchpriority="high" decoding="async">
  <div class="lp2-hero-scrim" aria-hidden="true"></div>
  <div class="lp2-hero-inner">
    <% const _brandWords = String(t('landing.hero.brand')).split(' '); %>
    <h1 class="lp2-wordmark brush"><%= _brandWords.slice(0, 2).join(' ') %> <br><%= _brandWords.slice(2).join(' ') %></h1>
    <p class="lp2-sub"><%= t('landing.face.subline') %></p>
    <form class="lp2-search" method="get" action="/gallery" role="search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      <input type="search" name="q" placeholder="<%= t('landing.face.search_placeholder') %>" aria-label="<%= t('landing.hero.search_aria') %>">
      <button type="submit" aria-label="<%= t('landing.hero.search_aria') %>"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg></button>
    </form>
    <% if (typeof heartsTotal !== 'undefined' && heartsTotal > 0) { %>
    <div class="lp2-live" role="img" aria-label="Most-loved design: <%= topHearts %> of <%= heartsGoal %> hearts toward becoming merch">
      <span>❤️ <strong><%= fmtNum(heartsTotal) %> hearts cast so far</strong> · the most-loved design has <%= fmtNum(topHearts) %> — at <%= fmtNum(heartsGoal) %> it becomes merch.</span>
      <div class="bar"><i style="width: <%= Math.min(100, Math.round(topHearts / heartsGoal * 100)) %>%"></i></div>
    </div>
    <% } %>
  </div>
</section>

<%- include('../partials/ad-slot', {slot: 'leaderboard'}) %>

<% if (typeof featuredDesigns !== 'undefined' && featuredDesigns.length) { %>
<section class="lp2-featured">
  <p class="lp2-eyebrow"><%= t('landing.face.featured_eyebrow') %></p>
  <h2 class="brush"><%= t('landing.face.featured_title') %></h2>
  <div class="lp2-row">
    <% featuredDesigns.forEach(function(d) { %>
    <figure class="lp2-card">
      <a href="/design/<%= d.id %>"><img src="/img/designs/thumb/<%= d.colorFile %>" alt="<%= t('home.design_alt', {title: d.title}) %>" loading="lazy" decoding="async"></a>
      <button type="button" class="fav-heart" data-fav-id="<%= d.id %>" aria-pressed="false" aria-label="<%= t('fav.add') %>" title="<%= t('fav.add') %>"></button><span class="like-count" data-like-count="<%= d.id %>" title="<%= t('toploved.loves', {count: d.like_count || 0}) %>">♥ <%= d.like_count || 0 %></span>
      <figcaption><%= d.title %></figcaption>
    </figure>
    <% }); %>
  </div>
  <p class="lp2-cta"><a class="btn-brush" href="/gallery"><%= t('landing.face.view_gallery') %> →</a></p>
</section>
<% } %>

<div class="lp2-rest">

<%# Custom designs — the second job on the door (declutter spine, 2026-10-27):
    48-hour pitch + the settled $150 price, one CTA to the custom desk. %>
<section>
  <h2><%= t('home.custom_section_title') %></h2>
  <p><%= t('home.custom_section_text') %></p>
  <p class="price"><%= t('landing.offers.custom.price', {price: fmtMoney(15000), sale: fmtMoney(12500)}) %></p>
  <p><a class="btn" href="/orders/custom"><%= t('landing.offers.custom.btn') %></a></p>
</section>

<h2><%= t('landing.steps.title') %></h2>
<div class="lp-steps">
  <div class="lp-step"><span class="num">1</span><h3><%= t('landing.steps.s1.title') %></h3><p><%= t('landing.steps.s1.text') %></p></div>
  <div class="lp-step"><span class="num">2</span><h3><%= t('landing.steps.s2.title') %></h3><p><%= t('landing.steps.s2.text') %></p></div>
  <div class="lp-step"><span class="num">3</span><h3><%= t('landing.steps.s3.title') %></h3><p><%= t('landing.steps.s3.text') %></p></div>
</div>

<h2><%= t('landing.offers.title') %></h2>
<div class="lp-offer-grid">
  <div class="lp-offer">
    <h3><%= t('landing.offers.premade.title') %></h3>
    <p><%= t('landing.offers.premade.text', {count: fmtNum(typeof designCount !== 'undefined' ? designCount : 0)}) %></p>
    <p class="price"><%= t('landing.offers.premade.price', {price: fmtMoney(7500), sale: fmtMoney(5000)}) %></p>
    <p><a class="btn" href="/gallery"><%= t('landing.offers.premade.btn') %></a></p>
  </div>
  <div class="lp-offer">
    <h3><%= t('landing.offers.custom.title') %></h3>
    <p><%= t('landing.offers.custom.text') %></p>
    <p class="price"><%= t('landing.offers.custom.price', {price: fmtMoney(15000), sale: fmtMoney(12500)}) %></p>
    <p><a class="btn" href="/orders/custom"><%= t('landing.offers.custom.btn') %></a></p>
  </div>
  <div class="lp-offer">
    <h3><%= t('landing.offers.membership.title') %></h3>
    <p><%= t('landing.offers.membership.text') %></p>
    <p class="price"><%= t('landing.offers.membership.price', {price: fmtMoney(567)}) %></p>
    <p><a class="btn" href="/membership"><%= t('landing.offers.membership.btn') %></a></p>
  </div>
  <div class="lp-offer">
    <h3><%= t('landing.offers.shops.title') %></h3>
    <p><%= t('landing.offers.shops.text') %></p>
    <p class="price"><%= t('landing.offers.shops.price', {price: fmtMoney(10398)}) %></p>
    <p><a class="btn" href="/shop"><%= t('landing.offers.shops.btn') %></a></p>
  </div>
  <div class="lp-offer">
    <h3><%= t('landing.offers.tees.title') %></h3>
    <p><%= t('landing.offers.tees.text') %></p>
    <p><a class="btn" href="/merch"><%= t('landing.offers.tees.btn') %></a></p>
  </div>
</div>

<%# Studio story, compressed (declutter 2026-10-27): one short paragraph,
    below the product sections — the long version lives on /about. %>
<section class="lp-story">
  <h3><%= t('landing.story.title') %></h3>
  <p><%= t('landing.story.p1', {count: fmtNum(typeof designCount !== 'undefined' ? designCount : 0)}) %></p>
</section>

<%# Work with us (declutter merge 2026-10-27): the three "For …" sections
    become one strip — three columns, condensed bullets, one CTA each. %>
<h2><%= t('landing.workwithus.title') %></h2>
<div class="lp-offer-grid lp-work">
  <div class="lp-offer">
    <h3><%= t('landing.forshops.title') %></h3>
    <p class="price"><%= t('landing.forshops.price', {price: fmtMoney(10398)}) %></p>
    <ul>
      <li><%= t('landing.forshops.b1') %></li>
      <li><%= t('landing.forshops.b2') %></li>
      <li><%= t('landing.forshops.b3') %></li>
      <li><%= t('landing.forshops.b4') %></li>
    </ul>
    <p><a class="btn" href="/shop"><%= t('landing.forshops.cta') %></a></p>
  </div>
  <div class="lp-offer">
    <h3><%= t('landing.forcustomers.title') %></h3>
    <p class="price"><%= t('landing.forcustomers.price', {price: fmtMoney(567)}) %></p>
    <ul>
      <li><%= t('landing.forcustomers.b1', {price: fmtMoney(7500), sale: fmtMoney(5000)}) %></li>
      <li><%= t('landing.forcustomers.b2', {price: fmtMoney(15000)}) %></li>
      <li><%= t('landing.forcustomers.b3') %></li>
    </ul>
    <p><a class="btn" href="/membership"><%= t('landing.forcustomers.cta') %></a></p>
  </div>
  <div class="lp-offer">
    <h3><%= t('landing.fordesigners.title') %></h3>
    <p class="price"><%= t('landing.fordesigners.price', {price: fmtMoney(567)}) %></p>
    <ul>
      <li><%= t('landing.fordesigners.b1') %></li>
      <li><%= t('landing.fordesigners.b2') %></li>
      <li><%= t('landing.fordesigners.b3') %></li>
    </ul>
    <p><a class="btn" href="/membership"><%= t('landing.fordesigners.cta') %></a></p>
  </div>
</div>

<h2><%= t('landing.partners.title') %></h2>
<p><%= t('landing.partners.text') %></p>
<p class="lp-partner-links">
  <a href="https://baselabs.is/?coupon=TAC20" target="_blank" rel="noopener nofollow sponsored"><%= t('discounts.baselabs_h') %> — TAC20</a> ·
  <a href="https://club.co/s/R6gQCOlWghEC9" target="_blank" rel="noopener nofollow sponsored"><%= t('discounts.electrum_h') %> — TATART20</a> ·
  <a href="https://www.drtattooskin.com/TATTOOARTCUSTOMS" target="_blank" rel="noopener nofollow sponsored"><%= t('discounts.drtattoo_h') %></a> ·
  <a href="https://lasso.to/auGY590feE/" target="_blank" rel="noopener nofollow sponsored"><%= t('discounts.recovery_h') %></a> ·
  <a href="https://lasso.to/RfUlWaYEwK/" target="_blank" rel="noopener nofollow sponsored"><%= t('discounts.leda_h') %></a> ·
  <a href="https://monstersink.com/michael" target="_blank" rel="noopener nofollow sponsored"><%= t('discounts.monstersink_h') %> — tattoo.art</a> ·
  <a href="https://www.amazon.com/s?k=tattoo+aftercare&tag=tattooartcust-20" target="_blank" rel="noopener nofollow sponsored"><%= t('discounts.amazon_h') %></a>
</p>
<p><a href="/discounts"><%= t('landing.partners.btn') %></a> · <a href="/aftercare"><%= t('landing.partners.aftercare_btn') %></a></p>
<p class="fineprint"><%= t('discounts.disclosure') %></p>
<p class="fineprint"><%= t('discounts.monstersink_note') %></p>

<h2><%= t('landing.appbuttons.title') %></h2>
<p><%= t('landing.appbuttons.sub') %></p>
<% const _apps = [
  { name: 'Tattoo Art Customs', href: '/tac-android', kind: 'free' },
  { name: 'Tattoo Art Customs Pro', href: '/tac-android-pro', kind: 'buy', cents: 199 },
  { name: 'Tattoo Art Customs for iPhone', href: '/ios-app', kind: 'buy', cents: 167 },
]; %>
<div class="lp-offer-grid">
  <% _apps.forEach(function(a) { %>
  <div class="lp-offer">
    <h3><%= a.name %></h3>
    <p><% if (a.kind === 'buy') { %><a class="btn" href="<%= a.href %>"><%= t('landing.appbuttons.buy', {price: fmtMoney(a.cents)}) %></a><% } else if (a.kind === 'free') { %><a class="btn" href="<%= a.href %>"><%= t('landing.appbuttons.free_dl') %></a><% } else { %><a class="btn" href="<%= a.href %>"><%= t('landing.appbuttons.see_apps') %></a><% } %></p>
  </div>
  <% }); %>
</div>
<p class="muted"><%= t('landing.appbuttons.note') %></p>

<h2><%= t('landing.watch.title') %></h2>
<p><%= t('landing.watch.text') %></p>
<div style="max-width:720px;margin:0 auto 1rem;">
  <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:8px;">
    <iframe style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;" src="https://www.youtube-nocookie.com/embed/<%= watchFeature.id %>" title="<%= watchFeature.title %>" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </div>
  <p style="margin-top:0.5rem;"><strong><%= watchFeature.title %></strong></p>
</div>
<div style="display:flex;gap:1rem;flex-wrap:wrap;justify-content:center;">
  <% watchShorts.forEach(function (v) { %>
  <div style="width:240px;max-width:80vw;">
    <div style="position:relative;padding-bottom:177.78%;height:0;overflow:hidden;border-radius:8px;">
      <iframe style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;" src="https://www.youtube-nocookie.com/embed/<%= v.id %>" title="<%= v.title %>" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
    <p style="margin-top:0.5rem;"><strong><%= v.title %></strong></p>
  </div>
  <% }); %>
</div>
<p style="text-align:center;margin-top:1rem;"><a class="btn" href="/watch"><%= t('landing.watch.more_btn') %></a> <a class="btn btn-secondary" href="https://www.youtube.com/@rook9860?sub_confirmation=1" target="_blank" rel="noopener"><%= t('landing.offers.watch.btn1') %></a> <a class="btn btn-secondary" href="<%= tacChannelUrl %>?sub_confirmation=1" target="_blank" rel="noopener"><%= t('landing.offers.watch.btn2') %></a> <a class="btn btn-secondary" href="<%= (typeof littleInkersYoutubeUrl !== 'undefined' && littleInkersYoutubeUrl ? littleInkersYoutubeUrl : 'https://www.youtube.com/@littleinkersapp') + '?sub_confirmation=1' %>" target="_blank" rel="noopener"><%= t('landing.offers.watch.btn3') %></a> <a class="btn btn-secondary" href="https://www.youtube.com/@ZiggyPoppy-l3b?sub_confirmation=1" target="_blank" rel="noopener"><%= t('landing.offers.watch.btn4') %></a></p>

<p class="lp-guides-row"><strong><%= t('landing.guides.title') %>:</strong> <a href="/guides/aftercare"><%= t('footer.aftercare_guide') %></a> · <a href="/guides/choosing-a-design"><%= t('footer.choosing_guide') %></a> · <a href="/guides/custom-design-process"><%= t('footer.custom_guide') %></a> · <a href="/guides/for-tattoo-shops"><%= t('footer.shops_guide') %></a></p>

<%# Penny Sweeper cluster (declutter 2026-10-27): the house slot and the
    mk4 tip jar stay on the door — demoted to compact modules at the foot
    of the page, never deleted. %>
<%- include('../partials/house-ad', {slot: 'home_inline'}) %>

<%- include('../partials/tip-jar') %>
</div>
