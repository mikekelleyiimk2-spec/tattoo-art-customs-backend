<style>
/* Below-the-fold sections kept from the classic face (offers, steps, CTA
   bands, hearts banner) — restyled dark by /css/home.css (.lp2-rest). */
.lp-offer-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem; margin: 1rem 0 1.5rem; }
.lp-offer { border: 1px solid var(--border, #2b241c); border-radius: 10px; padding: 1rem; background: var(--surface, #171310); }
.lp-offer h3 { margin: 0 0 .35rem; }
.lp-offer p { margin: 0 0 .7rem; }
.lp-offer .price { font-weight: bold; }
.lp-steps { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem; margin: 1rem 0 1.5rem; }
.lp-step { text-align: center; padding: 1rem; }
.lp-step .num { display: inline-block; width: 2.2rem; height: 2.2rem; line-height: 2.2rem; border-radius: 50%; background: var(--accent); color: #fff; font-weight: bold; margin-bottom: .5rem; }
.lp-cta-band { text-align: center; padding: 2rem 1rem; border-radius: 12px; background: var(--surface, #171310); border: 1px solid var(--border, #2b241c); margin-bottom: 1.5rem; }
.lp-hearts-banner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .8rem 1.2rem; border-radius: 10px; margin-bottom: 1.2rem; border: 1px solid var(--accent); }
.lp-hearts-banner .btn-small { padding: .4rem .9rem; font-size: .9rem; white-space: nowrap; }
.lp-hearts-links { display: flex; gap: .5rem; flex-shrink: 0; }
</style>

<%# ================= HOME FACE (owner-approved standard, 2026-10-27) ====
    Dark, photographic, art-first: full-bleed koi hero with the brush
    wordmark over the real artwork, one pill search, the live hearts
    numbers, a row of REAL top-hearted color designs, and YOU PICK. %>
<section class="lp2-hero">
  <img src="/img/landing/hero.webp" alt="<%= t('landing.hero.img_alt') %>" width="1200" height="514" fetchpriority="high" decoding="async">
  <div class="lp2-hero-scrim" aria-hidden="true"></div>
  <div class="lp2-hero-inner">
    <% const _brandWords = String(t('landing.hero.brand')).split(' '); %>
    <h1 class="lp2-wordmark brush"><%= _brandWords.slice(0, 2).join(' ') %><br><%= _brandWords.slice(2).join(' ') %></h1>
    <p class="lp2-sub"><%= t('landing.face.subline') %></p>
    <form class="lp2-search" method="get" action="/gallery" role="search">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      <input type="search" name="q" placeholder="<%= t('landing.face.search_placeholder') %>" aria-label="<%= t('landing.hero.search_aria') %>">
      <button type="submit" aria-label="<%= t('landing.hero.search_aria') %>"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg></button>
    </form>
    <% if (typeof heartsTotal !== 'undefined' && heartsTotal > 0) { %>
    <div class="lp2-live" role="img" aria-label="Most-loved design: <%= topHearts %> of <%= heartsGoal %> hearts toward becoming merch">
      <span>❤️ <strong><%= fmtNum(heartsTotal) %> hearts cast so far</strong> · the most-loved design has <%= fmtNum(topHearts) %> — at <%= fmtNum(heartsGoal) %> it becomes merch.</span>
      <div class="bar"><i style="width: <%= Math.min(100, Math.round(topHearts / heartsGoal * 100)) %>%"></i></div>
    </div>
    <% } %>
  </div>
</section>

<%- include('../partials/ad-slot', {slot: 'leaderboard'}) %>

<% if (typeof featuredDesigns !== 'undefined' && featuredDesigns.length) { %>
<section class="lp2-featured">
  <p class="lp2-eyebrow"><%= t('landing.face.featured_eyebrow') %></p>
  <h2 class="brush"><%= t('landing.face.featured_title') %></h2>
  <div class="lp2-row">
    <% featuredDesigns.forEach(function(d) { %>
    <figure class="lp2-card">
      <a href="/design/<%= d.id %>"><img src="/img/designs/thumb/<%= d.colorFile %>" alt="<%= t('home.design_alt', {title: d.title}) %>" loading="lazy" decoding="async"></a>
      <button type="button" class="fav-heart" data-fav-id="<%= d.id %>" aria-pressed="false" aria-label="<%= t('fav.add') %>" title="<%= t('fav.add') %>"></button><span class="like-count" data-like-count="<%= d.id %>" title="<%= t('toploved.loves', {count: d.like_count || 0}) %>">♥ <%= d.like_count || 0 %></span>
      <figcaption><%= d.title %></figcaption>
    </figure>
    <% }); %>
  </div>
  <p class="lp2-cta"><a class="btn-brush" href="/gallery"><%= t('landing.face.view_gallery') %> →</a></p>
</section>
<% } %>

<section class="lp2-youpick">
