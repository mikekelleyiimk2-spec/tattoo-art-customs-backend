<% if (typeof jsonLd !== 'undefined' && jsonLd) { %>
<script type="application/ld+json"><%- safeJson(jsonLd) %></script>
<% } %>
<div class="two-col">
  <div>
    <img class="detail-img" src="/img/designs/<%= imgFile || design.linework_wm_path.split('/').pop() %>" alt="<%= t('design.linework_alt', {title: design.title}) %>" decoding="async">
    <% if (blurred) { %>
    <p class="muted"><strong><%= t('design.blurred_note') %></strong>
      <a href="/account#content"><%= t('design.verify_age') %></a> <%= t('design.blurred_tail') %></p>
    <% } else { %>
    <p class="muted"><%= t('design.linework_note') %></p>
    <% } %>
  </div>
  <div>
    <h1><%= design.title %></h1>
    <% design.categories.forEach(function(c) { %><span class="tag"><%= c %></span><% }); %>
    <p><%= design.description %></p>
    <% if (artist) { %><p class="muted"><%= t('design.by') %> <a href="/artists/<%= design.artist_id %>"><%= artist.display_name %></a>
      <% if (currentUser && currentUser.id !== design.artist_id) { %>
      <form method="post" action="/messages/start" style="display:inline">
        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <input type="hidden" name="to_user_id" value="<%= design.artist_id %>">
        <input type="hidden" name="subject" value="Question about &quot;<%= design.title %>&quot;">
        <button class="linklike" type="submit"><%= t('design.message_artist') %></button>
      </form>
      <% } %></p><% } %>
    <p><strong><%= fmtMoney(priceTotal) %></strong> <span class="muted"><%= t('design.price_includes', {fee: fmtMoney(priceFee)}) %></span> <% if (sale) { %><span class="badge ok"><%= t('design.sale_price') %></span><% } %> <% if (typeof isCustom !== 'undefined' && isCustom) { %><span class="badge"><%= t('design.custom_portfolio') %></span><% } %></p>
    <% if (vatNote) { %><p class="muted fineprint"><%= vatNote %></p><% } %>
    <% if (currentUser) { %>
    <form method="post" action="/orders/buy/<%= design.id %>">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <% if (design.color_source === 'none') { %>
      <p class="muted"><%= t('design.no_color') %></p>
      <label><input type="radio" name="linework_only" value="1" checked>
        <strong><%= t('design.linework_only', {price: fmtMoney(lineworkTotal)}) %></strong> <span class="muted"><%= t('design.incl_fee') %></span></label>
      <% } else { %>
      <label><input type="radio" name="linework_only" value="0" checked>
        <strong><%= t('design.full_color', {price: fmtMoney(priceTotal)}) %></strong> <span class="muted"><%= t('design.incl_fee') %></span></label>
      <label><input type="radio" name="linework_only" value="1">
        <strong><%= t('design.linework_only', {price: fmtMoney(lineworkTotal)}) %></strong>
        <span class="muted"><%= t('design.linework_off') %></span></label>
      <% } %>
      <% const _fx = fxNote(priceTotal); if (_fx) { %><p class="muted fineprint"><%= _fx %></p><% } %>
      <p><button class="btn" type="submit"><%= t('design.buy_now') %></button></p>
      <% if (typeof creditBalance !== 'undefined' && creditBalance >= lineworkPrice) { %>
      <p><button class="btn btn-secondary" type="submit" name="use_credit" value="1"><%= t('design.pay_credit', {balance: fmtMoney(creditBalance)}) %></button></p>
      <% } %>
    </form>
    <% } else { %>
    <p><a class="btn" href="/login?next=<%= encodeURIComponent('/design/' + design.id) %>"><%= t('design.login_to_buy') %></a></p>
    <% } %>
    <% if (typeof owned !== 'undefined' && owned) { %>
    <p><a class="btn btn-secondary" href="/prints/order/design/<%= design.id %>"><%= t('design.order_print') %></a>
    <a class="btn btn-secondary" href="/merch/tee/<%= design.id %>"><%= t('design.get_tee') %></a></p>
    <% } %>
  </div>
</div>

<%- include('../partials/ad-slot', {slot: 'design_page'}) %>
