<div class="two-col">
  <div>
    <img class="detail-img" src="/img/designs/<%= design.linework_wm_path.split('/').pop() %>" alt="Tattoo design linework: <%= design.title %>">
    <p class="muted">Linework preview shown. Full color delivered after purchase.</p>
  </div>
  <div>
    <h1><%= design.title %></h1>
    <% design.categories.forEach(function(c) { %><span class="tag"><%= c %></span><% }); %>
    <p><%= design.description %></p>
    <% if (artist) { %><p class="muted">By <%= artist.display_name %></p><% } %>
    <p><strong><%= money(priceTotal) %></strong> <span class="muted">(includes <%= money(priceFee) %> processing fee)</span> <% if (sale) { %><span class="badge ok">Saturday sale price</span><% } %> <% if (typeof isCustom !== 'undefined' && isCustom) { %><span class="badge">custom portfolio piece — delivered instantly</span><% } %></p>
    <% if (currentUser) { %>
    <form method="post" action="/orders/buy/<%= design.id %>">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <% if (design.color_source === 'none') { %>
      <p class="muted">This piece has no color version — you get the clean linework at 3% off.</p>
      <label><input type="radio" name="linework_only" value="1" checked>
        <strong>Clean linework only — <%= money(lineworkTotal) %></strong> <span class="muted">(incl. fee)</span></label>
      <% } else { %>
      <label><input type="radio" name="linework_only" value="0" checked>
        <strong>Full color + clean linework — <%= money(priceTotal) %></strong> <span class="muted">(incl. fee)</span></label>
      <label><input type="radio" name="linework_only" value="1">
        <strong>Clean linework only — <%= money(lineworkTotal) %></strong>
        <span class="muted">(3% off, incl. fee)</span></label>
      <% } %>
      <p><button class="btn" type="submit">Buy now</button></p>
      <% if (typeof creditBalance !== 'undefined' && creditBalance >= lineworkPrice) { %>
      <p><button class="btn btn-secondary" type="submit" name="use_credit" value="1">Pay with site credit (<%= money(creditBalance) %> available)</button></p>
      <% } %>
    </form>
    <% } else { %>
    <p><a class="btn" href="/login?next=<%= encodeURIComponent('/design/' + design.id) %>">Log in to buy</a></p>
    <% } %>
    <% if (typeof owned !== 'undefined' && owned) { %>
    <p><a class="btn btn-secondary" href="/prints/order/design/<%= design.id %>">Order a print</a></p>
    <% } %>
  </div>
</div>

<%- include('../partials/ad-slot', {slot: 'design_page'}) %>
