<% if (typeof jsonLd !== 'undefined' && jsonLd) { %>
<script type="application/ld+json"><%- safeJson(jsonLd) %></script>
<% } %>
<div class="two-col">
  <div>
    <div class="design-swipe" id="designSwipe"<% if (typeof prevId !== 'undefined' && prevId) { %> data-prev="/design/<%= prevId %>"<% } %><% if (typeof nextId !== 'undefined' && nextId) { %> data-next="/design/<%= nextId %>"<% } %>>
      <span class="living-frame"><img class="detail-img living-picture" src="/img/designs/<%= imgFile || design.linework_wm_path.split('/').pop() %>" alt="<%= t('design.linework_alt', {title: design.title}) %>" decoding="async"><span class="living-atmosphere" aria-hidden="true"></span></span>
      <% if (typeof prevId !== 'undefined' && prevId) { %><a class="swipe-arrow left" href="/design/<%= prevId %>" aria-label="<%= t('design.prev_design') %>">‹</a><% } %>
      <% if (typeof nextId !== 'undefined' && nextId) { %><a class="swipe-arrow right" href="/design/<%= nextId %>" aria-label="<%= t('design.next_design') %>">›</a><% } %>
    </div>
    <script>
    (function () {
      var el = document.getElementById('designSwipe');
      if (!el) return;
      var sx = null, sy = null;
      el.addEventListener('touchstart', function (e) {
        var t = e.changedTouches[0]; sx = t.clientX; sy = t.clientY;
      }, { passive: true });
      el.addEventListener('touchend', function (e) {
        if (sx === null) return;
        var t = e.changedTouches[0];
        var dx = t.clientX - sx, dy = t.clientY - sy; sx = null;
        if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.5) {
          var url = dx < 0 ? el.dataset.next : el.dataset.prev;
          if (url) window.location.href = url;
        }
      }, { passive: true });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft' && el.dataset.prev) window.location.href = el.dataset.prev;
        else if (e.key === 'ArrowRight' && el.dataset.next) window.location.href = el.dataset.next;
      });
    })();
    </script>
    <% if (blurred) { %>
    <p class="muted"><strong><%= t('design.blurred_note') %></strong>
      <a href="/account#content"><%= t('design.verify_age') %></a> <%= t('design.blurred_tail') %></p>
    <% } else { %>
    <p class="muted"><%= t('design.linework_note') %></p>
    <% } %>
  </div>
  <div>
    <h1><%= design.title %><button type="button" class="fav-heart fav-heart-inline" data-fav-id="<%= design.id %>" aria-pressed="false" aria-label="<%= t('fav.add') %>" title="<%= t('fav.add') %>"></button></h1>
    <% if (design.show_featured) { %><p><a href="/show-designs" class="badge ok" style="text-decoration:none"><%= t('show.badge') %></a></p><% } %>
    <% design.categories.forEach(function(c) { %><span class="tag"><%= c %></span><% }); %>
    <p><%= design.description %></p>
    <% if (artist) { %><p class="muted"><%= t('design.by') %> <a href="/artists/<%= design.artist_id %>"><%= artist.display_name %></a>
      <% if (currentUser && currentUser.id !== design.artist_id) { %>
      <form method="post" action="/messages/start" style="display:inline">
        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <input type="hidden" name="to_user_id" value="<%= design.artist_id %>">
        <input type="hidden" name="subject" value="Question about &quot;<%= design.title %>&quot;">
        <button class="linklike" type="submit"><%= t('design.message_artist') %></button>
      </form>
      <% } %></p><% } %>
    <p><strong><%= fmtMoney(priceTotal) %></strong> <span class="muted"><%= t('design.price_includes', {fee: fmtMoney(priceFee)}) %></span> <% if (sale) { %><span class="badge ok"><%= t('design.sale_price') %></span><% } %> <% if (typeof isCustom !== 'undefined' && isCustom) { %><span class="badge"><%= t('design.custom_portfolio') %></span><% } %></p>
    <% if (typeof paypalClientId !== 'undefined' && paypalClientId && priceTotal >= 3000) { %><div data-pp-message data-pp-amount="<%= (priceTotal/100).toFixed(2) %>"></div><% } %>
    <% if (typeof showDiscountApplied !== 'undefined' && showDiscountApplied) { %><p><span class="badge ok"><%= t('show.member_save', {pct: showDiscountPct}) %></span></p><% } %>
    <% if (design.show_featured && !(typeof showDiscountApplied !== 'undefined' && showDiscountApplied) && typeof showAired !== 'undefined' && !showAired) { %><p class="muted"><%= t('show.starts_when_airs') %></p><% } %>
    <% if (design.show_featured && !(typeof showDiscountApplied !== 'undefined' && showDiscountApplied) && (typeof showAired === 'undefined' || showAired)) { %><p class="muted"><%= t('show.member_callout', {pct: typeof showDiscountPct !== 'undefined' ? showDiscountPct : 20}) %></p><% } %>
    <% if (vatNote) { %><p class="muted fineprint"><%= vatNote %></p><% } %>
    <% if (currentUser) { %>
    <% if (design.request_only) { %>
    <div class="card">
      <p><strong><%= t('design.request_only_title') %></strong></p>
      <p class="muted"><%= t('design.request_only_note') %></p>
      <p><a class="btn" href="/orders/custom?design=<%= design.id %>"><%= t('design.request_this_design') %></a></p>
    </div>
    <% } else { %>
    <form method="post" action="/orders/buy/<%= design.id %>">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <% if (design.color_source === 'none') { %>
      <p class="muted"><%= t('design.no_color') %></p>
      <label><input type="radio" name="linework_only" value="1" checked>
        <strong><%= t('design.linework_only', {price: fmtMoney(lineworkTotal)}) %></strong> <span class="muted"><%= t('design.incl_fee') %></span></label>
      <% } else { %>
      <label><input type="radio" name="linework_only" value="0" checked>
        <strong><%= t('design.full_color', {price: fmtMoney(priceTotal)}) %></strong> <span class="muted"><%= t('design.incl_fee') %></span></label>
      <label><input type="radio" name="linework_only" value="1">
        <strong><%= t('design.linework_only', {price: fmtMoney(lineworkTotal)}) %></strong>
        <span class="muted"><%= t('design.linework_off') %></span></label>
      <% } %>
      <% const _fx = fxNote(priceTotal); if (_fx) { %><p class="muted fineprint"><%= _fx %></p><% } %>
      <p><button class="btn" type="submit"><%= t('design.buy_now') %></button></p>
      <p class="muted fineprint"><%= t('design.license_line') %> <a href="/terms#license">Terms</a></p>
      <% if (typeof creditBalance !== 'undefined' && creditBalance >= lineworkPrice) { %>
      <p><button class="btn btn-secondary" type="submit" name="use_credit" value="1"><%= t('design.pay_credit', {balance: fmtMoney(creditBalance)}) %></button></p>
      <% } %>
    </form>
    <% } %>
    <% if (typeof canBuyForClient !== 'undefined' && canBuyForClient && !design.request_only) { %>
    <details class="card" style="margin-top:1rem">
      <summary><strong><%= t('design.buy_for_client') %></strong></summary>
      <p class="muted"><%= t('design.buy_for_client_note') %></p>
      <form method="post" action="/orders/buy-for-client/<%= design.id %>" class="form">
        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <label><%= t('design.client_email') %>
          <input type="email" name="client_email" required maxlength="160" placeholder="client@example.com">
        </label>
        <p><button class="btn" type="submit"><%= t('design.buy_for_client_btn') %></button></p>
      </form>
    </details>
    <% } %>
    <% } else { %>
    <p><a class="btn" href="/login?next=<%= encodeURIComponent('/design/' + design.id) %>"><%= t('design.login_to_buy') %></a></p>
    <% } %>
    <% if (typeof owned !== 'undefined' && owned) { %>
    <p><a class="btn btn-secondary" href="/prints/order/design/<%= design.id %>"><%= t('design.order_print') %></a>
    <a class="btn btn-secondary" href="/merch/tee/<%= design.id %>"><%= t('design.get_tee') %></a></p>
    <% } %>
    <% if (!design.request_only) { %>
    <details class="card" style="margin-top:1rem">
      <summary><strong><%= t('design.send_to_app') %></strong></summary>
      <p class="muted"><%= t('design.send_to_app_note', {price: fmtMoney(sendToAppTotal)}) %></p>
      <form method="post" action="/orders/send-to-app/<%= design.id %>">
        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <p><button class="btn btn-secondary" type="submit"><%= t('design.send_to_app_btn') %></button></p>
      </form>
    </details>
    <% } %>
  </div>
</div>

<%- include('../partials/ad-slot', {slot: 'design_page'}) %>
