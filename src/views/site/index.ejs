<section class="hero">
  <h1>Original tattoo designs, made to be worn.</h1>
  <p><% if (designCount > 0) { %>Browse <%= designCount %>+ original designs.<% } else { %>New original designs landing daily.<% } %> Custom designs are <strong><%= money(customPrice) %></strong><% if (sale) { %> — Saturday sale price<% } %> — 50% deposit, 48-hour delivery.</p>
  <% if (sale) { %>
  <div class="sale-banner" role="status">🔥 Saturday sale is ON — premade designs $52.24 until 5 AM CT Sunday.</div>
  <% } %>
  <p><a class="btn" href="/gallery">Browse the gallery</a> <a class="btn btn-secondary" href="/orders/custom">Order a custom design</a></p>
</section>

<h2>Fresh designs</h2>
<div class="grid">
  <% designs.forEach(function(d) { %>
  <article class="design-card">
    <a href="/design/<%= d.id %>"><img src="/img/designs/<%= d.linework_wm_path.split('/').pop() %>" alt="Tattoo design: <%= d.title %>" loading="lazy"></a>
    <div class="pad">
      <h3><a href="/design/<%= d.id %>"><%= d.title %></a></h3>
      <p class="muted"><%= money(premadePrice) %><% if (sale) { %> <span class="badge ok">Sale</span><% } %></p>
    </div>
  </article>
  <% }); %>
</div>

<section class="card">
  <h2>Artists &amp; shops: join and earn</h2>
  <ul>
    <li><strong>Design artists</strong> — $5.67/month to upload your art, write a bio, and earn <strong>60% commission</strong> per sale.</li>
    <li><strong>Tattoo shops</strong> — $103.98/year, earn <strong>20% on every verified sale</strong> you refer.</li>
  </ul>
  <p><a class="btn" href="/membership">Join as a design artist</a> <a class="btn btn-secondary" href="/membership">Join as a tattoo shop</a></p>
</section>
