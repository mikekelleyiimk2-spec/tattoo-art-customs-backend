<section class="hero">
  <h1><%= t('home.hero_title') %></h1>
  <p><% if (designCount > 0) { %><%= t('home.hero_sub', {count: fmtNum(designCount)}) %><% } else { %><%= t('home.hero_sub_empty') %><% } %> <%= t(sale ? 'home.hero_custom_sale' : 'home.hero_custom', {price: fmtMoney(customPrice)}) %></p>
  <% if (sale) { %>
  <div class="sale-banner" role="status"><%= t('home.sale_banner', {price: fmtMoney(premadePrice)}) %></div>
  <% } %>
  <p><a class="btn" href="/gallery"><%= t('home.browse_gallery') %></a> <a class="btn btn-secondary" href="/orders/custom"><%= t('home.order_custom') %></a></p>
  <% if (vatNote) { %><p class="muted fineprint"><%= vatNote %></p><% } %>
</section>

<section class="card" id="app">
  <% if (playStoreUrl || appStoreUrl) { %>
  <h2><%= t('home.app_title_live') %></h2>
  <p><%= t('home.app_text_live') %></p>
  <p><% if (playStoreUrl) { %><a class="btn" href="<%= playStoreUrl %>"><%= t('home.get_play') %></a><% } %> <% if (appStoreUrl) { %><a class="btn" href="<%= appStoreUrl %>"><%= t('home.get_appstore') %></a><% } %></p>
  <% if (!appStoreUrl) { %>
  <p class="muted"><%= t('home.ios_soon') %></p>
  <form method="post" action="/app-notify" class="form">
    <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
    <input type="hidden" name="platform" value="ios">
    <input type="email" name="email" maxlength="120" required placeholder="you@example.com" aria-label="<%= t('home.ios_soon') %>">
    <button type="submit"><%= t('home.notify_me') %></button>
  </form>
  <% } %>
  <% } else { %>
  <h2><%= t('home.app_title_soon') %></h2>
  <p><%= t('home.app_text_soon') %></p>
  <form method="post" action="/app-notify" class="form">
    <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
    <input type="email" name="email" maxlength="120" required placeholder="you@example.com" aria-label="<%= t('home.notify_me') %>">
    <button type="submit"><%= t('home.notify_me') %></button>
  </form>
  <% } %>
</section>

<% if (youtubeUrl) { %>
<section class="card" id="youtube">
  <h2><%= t('home.yt_title') %></h2>
  <p><%= t('home.yt_text') %></p>
  <p><a class="btn" href="<%= youtubeUrl %>?sub_confirmation=1" target="_blank" rel="noopener"><%= t('home.yt_subscribe') %></a></p>
</section>
<% } %>

<h2><%= t('home.fresh') %></h2>
<div class="grid">
  <% designs.forEach(function(d) { %>
  <article class="design-card">
    <a href="/design/<%= d.id %>"><img src="/img/designs/<%= d.thumb || d.linework_wm_path.split('/').pop() %>" alt="<%= t('home.design_alt', {title: d.title}) %>" loading="lazy" decoding="async"></a>
    <div class="pad">
      <h3><a href="/design/<%= d.id %>"><%= d.title %></a></h3>
      <p class="muted"><%= fmtMoney(premadePrice) %><% if (sale) { %> <span class="badge ok"><%= t('common.sale') %></span><% } %></p>
    </div>
  </article>
  <% }); %>
</div>

<section class="card">
  <h2><%= t('home.artists_title') %></h2>
  <ul>
    <li><%= t('home.artists_designer', {price: fmtMoney(567)}) %></li>
    <li><%= t('home.artists_shop', {price: fmtMoney(10398)}) %></li>
  </ul>
  <p><a class="btn" href="/membership"><%= t('home.join_artist') %></a> <a class="btn btn-secondary" href="/membership"><%= t('home.join_shop') %></a></p>
</section>

<section class="card">
  <h2><%= t('home.custom_section_title') %></h2>
  <p><%= t('home.custom_section_text') %></p>
  <p><a class="btn btn-secondary" href="/orders/custom"><%= t('home.start_custom') %></a></p>
</section>
