<%# FillMyList landing (RENAMED 2026-10-28, was "Tester Hub", owner
    strike) — trickle-down pass 3 (2026-10-27): the face now
    rides the shipped anchor system (home header + page-dark field +
    /css/th.css, FillMyList's own violet-and-gold system). The hero carries
    the ONE job in the first viewport: headline, the real live pool
    count, and the signup itself. The board below is the living surface
    — real fill events from fillCycle.lightBoard, never seeded.
    Wiring is byte-identical to the previous face: same form action,
    same JS pipe (POST /api/testers/signup), same download tap. %>
<section class="th-hero" id="join">
  <p class="th-eyebrow">FILLMYLIST · USEFUL APPZ</p>
  <h1>BECOME A TESTER — <span class="th-gold">FIRST IN LINE</span> TO TRY THE NEWEST APPS.</h1>
  <p class="th-sub">New apps drop here before they drop anywhere else. First eyes. First hands. First in line — every time.</p>
  <% if (poolCount > 0) { %>
  <p class="th-pill">🔥 <span id="th-count"><%= poolCount %></span> tester<%= poolCount === 1 ? '' : 's' %> already in line</p>
  <% } else { %>
  <p class="th-pill">✨ THE FOUNDING BOARD IS OPEN</p>
  <% } %>
  <div class="th-join">
    <% if (joined) { %>
    <div class="th-joined" role="status">
      <p style="font-size:1.2rem;margin:.2rem 0;"><strong>🎉 YOU'RE IN — the next drop finds you first.</strong></p>
      <p style="margin:.2rem 0;">There are now <strong><%= poolCount %></strong> tester<%= poolCount === 1 ? '' : 's' %> in line — and you're one of them. First eyes. First hands. Yours.</p>
    </div>
    <% } %>
    <% if (joinError) { %>
    <div class="th-error" role="alert">
      <% if (joinError === 'gmail') { %><strong>That address didn't take.</strong> The line runs on Gmail — the Google account on your phone. Check it and go again.<% } else if (joinError === 'name') { %><strong>One thing missing: your name.</strong> Any name you like — it's the one that goes up in lights.<% } else { %><strong>That signup didn't land.</strong> Give it another go — your place in line is waiting.<% } %>
    </div>
    <% } %>
    <div id="th-live-joined" class="th-joined" role="status" hidden>
      <p style="font-size:1.2rem;margin:.2rem 0;"><strong>🎉 YOU'RE IN — the next drop finds you first.</strong></p>
      <p style="margin:.2rem 0;">There are now <strong id="th-live-count"></strong> testers in line — and you're one of them. First eyes. First hands. Yours.</p>
    </div>
    <p id="th-live-error" class="th-error" role="alert" hidden></p>
    <form id="th-join-form" method="post" action="/tester-hub/join">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <p>
        <label for="th-name"><strong>Your name</strong></label><br>
        <input class="th-input" id="th-name" type="text" name="name" maxlength="80" autocomplete="name" placeholder="The name that goes up in lights">
      </p>
      <p>
        <label for="th-gmail"><strong>Your Gmail</strong> — the one on your Android phone</label><br>
        <input class="th-input" id="th-gmail" type="email" name="gmail" required maxlength="120" autocomplete="email" placeholder="you@gmail.com">
      </p>
      <p><button class="th-join-btn" type="submit">PUT ME FIRST IN LINE →</button></p>
    </form>
    <p class="th-deal">One signup, every app: joining puts your Gmail on the tester list of each new app in FillMyList the moment it drops — that's the whole deal, stated plain. Leaving is just as easy, whenever you like: one tap in the FillMyList app and you're out — no hard feelings.</p>
  </div>
</section>

<section class="th-board" aria-label="The board, live">
  <h2>THE BOARD — LIVE</h2>
  <% if (board.tester && board.tester.length) { %>
    <% board.tester.forEach(function (f) { %>
  <p style="margin:.4rem 0 0;"><strong><%= f.app_name %></strong> — <%= f.confirmed %>/<%= f.target %><% if (f.confirmed >= f.target) { %> — FULL 🎉<% } else if (f.confirmed >= 9) { %> — almost full<% } %></p>
  <div class="th-bar-track"><div class="th-bar-fill" style="width:<%= Math.min(100, Math.round(100 * f.confirmed / f.target)) %>%;"></div></div>
    <% }) %>
  <% } %>
  <% if (!board.founding && board.new_apps_today > 0) { %>
  <p>🆕 <strong><%= board.new_apps_today %></strong> new app<%= board.new_apps_today === 1 ? '' : 's' %> dropped today — first in line gets first pick.</p>
  <% } %>
  <% if (board.founding) { %>
  <p style="font-size:1.1rem;"><strong>THE FOUNDING BOARD</strong> — the first names in lights go right here. <strong>Be the first name on it.</strong></p>
  <% } %>
</section>

<% if (apps && apps.length) { %>
<h2>IN FILLMYLIST RIGHT NOW</h2>
<div class="th-apps">
  <% apps.forEach(function (a) { %>
  <div class="th-app">
    <p style="margin-top:0;"><strong><%= a.app_name %></strong> <span class="th-badge">IN FILLMYLIST</span></p>
    <% if (a.blurb) { %><p><%= a.blurb %></p><% } %>
    <% if (a.pool_snapshot > 0) { %><p class="muted" style="margin-bottom:0;">Dropped to <%= a.pool_snapshot %> testers already in line.</p><% } %>
  </div>
  <% }) %>
</div>
<% } %>

<section class="th-download">
  <h2>TAKE FILLMYLIST WITH YOU</h2>
  <p>The FillMyList app puts every new drop in your pocket the moment it opens — and your place in line travels with you.</p>
  <p><a class="th-dl-btn" href="/tester-hub/download">⬇ GET THE FILLMYLIST APP — ANDROID</a></p>
  <p style="margin-bottom:0;">One family: the <a href="/folder">Useful Appz Folder</a> keeps every Useful Appz app on your phone current, so the newest versions always reach you first — and the <a href="/apps">apps page</a> carries the whole lineup.</p>
</section>

<%- include('../partials/rolodex-placements') %>

<div class="th-sweep">
  <%- include('../partials/house-ad', {slot: 'tester_hub'}) %>
  <%- include('../partials/sponsor-slot') %>
  <%- include('../partials/tip-jar') %>
</div>

<section class="th-dev">
  <h2>TIRED OF LOOKING FOR TESTERS?</h2>
  <p><strong>Building an app of your own?</strong> One payment inside the FillMyList app fills your tester list to FULL — $24.99, one app, testers cycled in waves until 12 confirmed, and kept full through your 14 days. The Fill lives in the FillMyList app — nowhere else.</p>
  <p style="margin-bottom:0;"><a class="th-dev-btn" href="/testers">Fill your list →</a></p>
</section>

<script>
(function () {
  var form = document.getElementById('th-join-form');
  if (!form) return;
  var joinedPanel = document.getElementById('th-live-joined');
  var liveCount = document.getElementById('th-live-count');
  var errPanel = document.getElementById('th-live-error');
  var heroCount = document.getElementById('th-count');
  form.addEventListener('submit', function (ev) {
    ev.preventDefault();
    var name = document.getElementById('th-name').value;
    var gmail = document.getElementById('th-gmail').value;
    errPanel.hidden = true;
    fetch('/api/testers/signup', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: name, gmail: gmail, source: 'web' })
    }).then(function (r) { return r.json().then(function (j) { return { status: r.status, j: j }; }); })
    .then(function (out) {
      if (out.j && out.j.ok) {
        form.hidden = true;
        joinedPanel.hidden = false;
        if (out.j.pool_count != null) {
          liveCount.textContent = out.j.pool_count;
          if (heroCount) heroCount.textContent = out.j.pool_count;
        }
        joinedPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else {
        var msg = (out.j && out.j.error) || '';
        errPanel.textContent = /gmail/i.test(msg)
          ? "That address didn't take. The line runs on Gmail — the Google account on your phone. Check it and go again."
          : (/name/i.test(msg)
            ? 'One thing missing: your name. Any name you like — it\u2019s the one that goes up in lights.'
            : "That signup didn't land. Give it another go — your place in line is waiting.");
        errPanel.hidden = false;
      }
    }).catch(function () {
      form.submit();
    });
  });
})();
</script>
