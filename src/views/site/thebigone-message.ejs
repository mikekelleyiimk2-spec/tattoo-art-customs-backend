<%# Dawnfold — single-message page in the publication's face
    (e.g. an expired sign-in link). %>
<header class="masthead">
  <div class="mast-top">
    <span>VOL. I — NO. 1</span>
    <span class="mast-open">★ DAWNFOLD ★</span>
    <span>ABBEVILLE, LOUISIANA</span>
  </div>
  <h1 class="mast-name" style="font-size:38px;">Dawnfold</h1>
  <p class="mast-date"><a href="/dawnfold">← Back to today's edition</a></p>
</header>
<div class="tbo-doors">
  <div class="tbo-card">
    <h4><%= heading %></h4>
    <p><%= body %></p>
    <p><a class="tbo-btn gold" href="/dawnfold">Back to Dawnfold</a></p>
  </div>
</div>
