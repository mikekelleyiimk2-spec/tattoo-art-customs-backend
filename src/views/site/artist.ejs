<div class="two-col">
  <div>
    <h1><%= artist.display_name || 'Artist' %></h1>
    <% if (artist.is_founding_artist) { %><p><span class="badge ok">Founding Artist</span></p><% } %>
    <% if (bio) { %><p><%= bio %></p><% } else { %><p class="muted">Tattoo design artist on Tattoo Art Customs.</p><% } %>
  </div>
  <div>
    <p class="muted">Custom portfolio pieces sell at the custom-design price and are delivered instantly after payment. Pre-designs are also listed on the main gallery.</p>
  </div>
</div>
<% if (!pieces.length) { %>
<p class="muted">No pieces published yet — check back soon.</p>
<% } %>
<div class="grid">
<% pieces.forEach(function(p) { %>
  <div class="card">
    <a href="/design/<%= p.id %>"><img src="/img/designs/<%= p.linework_wm_path.split('/').pop() %>" alt="Tattoo design linework: <%= p.title %>" loading="lazy"></a>
    <h3><a href="/design/<%= p.id %>"><%= p.title %></a></h3>
    <p><strong><%= money(p.price) %></strong>
      <% if (p.listing_type === 'custom') { %><span class="badge">custom piece</span><% } else { %><span class="badge">pre-design</span><% } %>
      <% if (sale) { %><span class="badge ok">sale</span><% } %>
    </p>
  </div>
<% }); %>
</div>
