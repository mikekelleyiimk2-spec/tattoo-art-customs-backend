<h1><%= t('raffle.title') %></h1>

<% if (raffleDrawn) { %>
<p><span class="badge ok"><%= t('raffle.drawn') %></span> <%= t('raffle.drawn_text') %></p>
<% } else if (raffleOpen) { %>
<p><span class="badge ok"><%= t('raffle.entries_open') %></span> <%= t('raffle.open_text') %></p>
<% } else { %>
<p><span class="badge ok"><%= t('raffle.closed') %></span> <%= t('raffle.closed_text') %></p>
<% } %>

<section class="card">
  <h2><%= t('raffle.how_title') %></h2>
  <p><a href="/signup"><%= t('raffle.create_enter') %></a></p>
  <p><%= t('raffle.how_text') %></p>
  <p><%= t('raffle.how_fine') %></p>
</section>

<section class="card">
  <h2><%= t('raffle.progress_title') %></h2>
  <p><strong><%= t('raffle.entries_so_far', {entries: fmtNum(raffleEntries), target: fmtNum(entryTarget)}) %></strong></p>
  <% const pct = Math.min(100, (raffleEntries / entryTarget) * 100); %>
  <div style="background:#eee;border-radius:6px;height:14px;overflow:hidden">
    <div style="background:#2a7;height:100%;width:<%= pct.toFixed(4) %>%"></div>
  </div>
  <p class="muted"><%= t('raffle.progress_note') %></p>
</section>

<section class="card">
  <h2><%= t('raffle.prizes_title') %></h2>
  <ul>
    <li><strong><%= t('raffle.grand') %></strong> <%= t('raffle.grand_text') %></li>
    <li><strong><%= t('raffle.runners') %></strong> <%= t('raffle.runners_text') %></li>
  </ul>
</section>

<% if (!raffleDrawn && raffleOpen) { %>
<section class="card">
  <h2><%= t('raffle.get_in') %></h2>
  <% if (alreadyEntered) { %>
  <p><span class="badge ok"><%= t('raffle.youre_in') %></span> <%= t('raffle.already') %></p>
  <% } else { %>
  <p><a class="btn" href="/signup"><%= t('raffle.create_enter') %></a></p>
  <% } %>
</section>
<% } %>

<% if (winners && winners.length) { %>
<section class="card">
  <h2><%= t('raffle.winners') %></h2>
  <ul>
  <% winners.forEach(function(w) { %>
    <li><strong><%= w.display_name || t('raffle.lucky') %></strong> —
      <% if (w.prize_won === 'grand') { %><%= t('raffle.grand_won') %>
      <% } else { %><%= t('raffle.runner_won') %><% } %></li>
  <% }); %>
  </ul>
</section>
<% } %>
