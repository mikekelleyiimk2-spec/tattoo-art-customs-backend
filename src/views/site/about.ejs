    <img src="/img/logos/tattoo-art-customs-card.webp" alt="Tattoo Art Customs™ logo" style="max-width:170px;width:100%;height:auto;" />
    <p><strong>Tattoo Art Customs™</strong></p>
    <p><a class="btn" href="/gallery">Shop tattoo designs</a></p>
  </div>
  <div style="text-align:center;">
    <img src="/img/logos/mikes-customs-card.webp" alt="Mike's Customs™ logo" style="max-width:170px;width:100%;height:auto;" />
    <p><strong>Mike's Customs™</strong></p>
    <p><a class="btn" href="/orders/custom">Order a custom</a></p>
  </div>
  <div style="text-align:center;">
    <img src="/img/logos/mikes-custom-tees-card.webp" alt="Mike's Custom Tees™ logo" style="max-width:170px;width:100%;height:auto;" />
    <p><strong>Mike's Custom Tees™</strong></p>
    <p><a class="btn" href="/merch">Shop tees</a></p>
  </div>
  <div style="text-align:center;">
    <img src="/img/logos/usefulappz-card.webp" alt="Usefulappz™ logo" style="max-width:170px;width:100%;height:auto;" />
    <p><strong>Usefulappz™</strong></p>
    <p><a class="btn" href="/apps">Get our apps</a></p>
  </div>
</div>
