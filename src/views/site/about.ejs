<h1><%= t('about.title') %></h1>
<img src="/img/logos/tattoo-art-customs-hero.webp" alt="Tattoo Art Customs™ logo" style="max-width:420px;width:100%;height:auto;display:block;margin:0 auto 1.5rem;" />
<p><%= t('about.intro', {custom: fmtMoney(15574), sale: fmtMoney(12987)}) %></p>
<h2>Our brands</h2>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1.5rem;margin:1.5rem 0;">
