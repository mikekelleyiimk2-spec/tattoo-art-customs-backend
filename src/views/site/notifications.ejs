<h1>Notifications</h1>
<div class="card" id="push-card">
  <h3>Push notifications</h3>
  <p class="muted" id="push-status">Checking push status on this device…</p>
  <p><button class="btn btn-secondary" id="push-toggle" type="button" style="display:none">Enable push notifications</button></p>
  <p><button class="btn" id="push-test" type="button" style="display:none">Send me a test push</button></p>
  <p class="muted" id="push-test-status"></p>
</div>
<script>
(function () {
  var statusEl = document.getElementById('push-status');
  var btn = document.getElementById('push-toggle');
  if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
    statusEl.textContent = 'Push notifications are not supported in this browser.';
    return;
  }
  function urlBase64ToUint8Array(base64String) {
    var padding = '='.repeat((4 - base64String.length % 4) % 4);
    var base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
    var rawData = window.atob(base64);
    var outputArray = new Uint8Array(rawData.length);
    for (var i = 0; i < rawData.length; ++i) outputArray[i] = rawData.charCodeAt(i);
    return outputArray;
  }
  var currentSub = null;
  var pendingSub = null;
  var testBtn = document.getElementById('push-test');
  var testStatus = document.getElementById('push-test-status');
  function refresh() {
    navigator.serviceWorker.ready.then(function (reg) {
      return reg.pushManager.getSubscription();
    }).then(function (sub) {
      currentSub = sub;
      if (sub) {
        statusEl.textContent = 'Push notifications are ON for this device.';
        btn.textContent = 'Turn off push notifications';
        testBtn.style.display = '';
      } else {
        statusEl.textContent = 'Push notifications are OFF for this device. Admins: turn them on to get pushed the moment a design needs review.';
        btn.textContent = 'Enable push notifications';
        testBtn.style.display = 'none';
        testStatus.textContent = '';
      }
      btn.style.display = '';
    }).catch(function () {
      statusEl.textContent = 'Could not check push status.';
    });
  }
  testBtn.addEventListener('click', function () {
    testStatus.textContent = 'Sending test push…';
    fetch('/api/push/test', { method: 'POST' })
      .then(function (r) { return r.json().then(function (d) { return { status: r.status, body: d }; }); })
      .then(function (res) {
        if (res.status === 200 && res.body.ok) {
          testStatus.textContent = res.body.sent > 0
            ? 'Test push sent — it should arrive on this device in a few seconds.'
            : 'Test push accepted but no subscription was found on the server — try turning push off and on again.';
        } else {
          testStatus.textContent = 'Test push failed: ' + ((res.body && res.body.error) || ('server ' + res.status));
        }
      })
      .catch(function (e) { testStatus.textContent = 'Test push failed: ' + e.message; });
  });
  btn.addEventListener('click', function () {
    if (currentSub) {
      var endpoint = currentSub.endpoint;
      currentSub.unsubscribe().then(function () {
        return fetch('/api/push/unsubscribe', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ endpoint: endpoint }),
        });
      }).then(refresh).catch(refresh);
      return;
    }
    Notification.requestPermission().then(function (perm) {
      if (perm !== 'granted') { statusEl.textContent = 'Permission denied — push stays off.'; return; }
      return fetch('/api/push/vapid-key').then(function (r) { return r.json(); });
    }).then(function (data) {
      if (!data || !data.publicKey) throw new Error('no key');
      return navigator.serviceWorker.ready.then(function (reg) {
        return reg.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: urlBase64ToUint8Array(data.publicKey),
        });
      });
    }).then(function (sub) {
      pendingSub = sub;
      return fetch('/api/push/subscribe', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ subscription: sub.toJSON() }),
      });
    }).then(function (r) {
      return r.json().then(function (d) {
        if (!r.ok || !d.ok) throw new Error((d && d.error) || ('server ' + r.status));
      });
    }).then(refresh).catch(function (e) {
      // Never leave a lying browser-side subscription: if the server didn't
      // save it, no push will ever arrive, so drop it and say what happened.
      var drop = pendingSub ? pendingSub.unsubscribe().catch(function () {}) : Promise.resolve();
      pendingSub = null;
      return drop.then(function () {
        currentSub = null;
        statusEl.textContent = 'Could not enable push: ' + e.message;
        btn.style.display = '';
      });
    });
  });
  navigator.serviceWorker.register('/sw.js').then(refresh).catch(function () {
    statusEl.textContent = 'Could not register the push service worker.';
  });
})();
</script>
<% if (!notifications.length) { %><p class="muted">Nothing yet.</p><% } %>
<% notifications.forEach(function(n) { %>
<div class="card" style="<%= n.read_at ? '' : 'border:2px solid #6a4fb3' %>">
  <p><strong><%= n.title %></strong> <span class="muted">· <%= new Date(Number(n.created_at)).toLocaleString() %></span></p>
  <p style="white-space:pre-wrap"><%= n.body %></p>
  <p>
    <% if (n.link) { %><a class="btn btn-secondary" href="<%= n.link %>">Open</a><% } %>
    <% if (!n.read_at) { %>
    <form method="post" action="/notifications/<%= n.id %>/read" style="display:inline">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button class="btn btn-secondary" type="submit">Mark read</button>
    </form>
    <% } %>
  </p>
</div>
<% }); %>
