<a class="deals-strip" href="/discounts" id="dealsStrip" aria-label="<%= t('design.kit_deals') %>"><span class="deals-strip-msg"><%= t('gallery.deals_banner_1') %></span><span class="deals-strip-msg" hidden><%= t('gallery.deals_banner_2') %></span></a>
<script>
(function () {
  var msgs = document.querySelectorAll('#dealsStrip .deals-strip-msg');
  if (msgs.length < 2) return;
  var i = 0;
  setInterval(function () {
    msgs[i].hidden = true;
    i = (i + 1) % msgs.length;
    msgs[i].hidden = false;
  }, 5000);
})();
</script>
<style>
.deals-strip { display: block; border: 1px solid var(--accent); color: var(--accent); padding: .5em 1em; border-radius: var(--radius); text-align: center; font-weight: bold; margin-bottom: 1rem; text-decoration: none; }
</style>

<h1><%= t('gallery.title') %></h1>
<p class="muted"><%= t('gallery.sub', { count: fmtNum(catalogCount) }) %></p>
<p class="mix-match"><strong><%= t('gallery.mix_match') %></strong></p>
<p><%= t('gallery.intro_top') %></p>
<p>
  <a class="btn<%= sort === 'newest' ? '' : ' btn-secondary' %>" href="<%= newestUrl %>"><%= t('gallery.sort_newest') %></a>
  <a class="btn<%= sort === 'newest' ? ' btn-secondary' : '' %>" href="<%= allUrl %>"><%= t('gallery.sort_all') %></a>
</p>
<% if (sale) { %><div class="sale-banner" role="status"><%= t('gallery.sale_banner', {price: fmtMoney(premadePrice)}) %></div><% } %>
<% if (vatNote) { %><p class="muted fineprint"><%= vatNote %></p><% } %>

<form method="get" action="/gallery" class="card" role="search" aria-label="<%= t('gallery.search_aria') %>">
  <div class="three-col">
    <div>
      <label for="q"><%= t('gallery.search_label') %></label>
      <input type="text" id="q" name="q" value="<%= q %>" placeholder="<%= t('gallery.search_ph') %>">
    </div>
    <div>
      <label for="cat"><%= t('gallery.category') %></label>
      <select id="cat" name="cat">
        <option value=""><%= t('gallery.all_categories') %></option>
        <% allCats.forEach(function(c) { %>
        <option value="<%= c %>" <%= cat === c ? 'selected' : '' %>><%= c %></option>
        <% }); %>
      </select>
    </div>
    <div>
      <label for="style"><%= t('gallery.style') %></label>
      <select id="style" name="style">
        <option value=""><%= t('gallery.all_styles') %></option>
        <% allStyles.forEach(function(s) { %>
        <option value="<%= s %>" <%= style === s ? 'selected' : '' %>><%= s %></option>
        <% }); %>
      </select>
    </div>
  </div>
  <p><button class="btn" type="submit"><%= t('gallery.search_btn') %></button></p>
</form>

<% if (typeof featuredColor !== 'undefined' && featuredColor.length) { %>
<%# Featured-in-color row (Batch #1 item 16): finished-color designs shown
    ONLY as their watermarked previews (img src points at the color-wm
    derivative's grid thumbnail). The clean color file is never referenced. %>
<section class="card featured-color">
  <h2><%= t('gallery.featured_color_h') %></h2>
  <p class="muted"><%= t('gallery.featured_color_sub') %></p>
  <div class="grid">
    <% featuredColor.forEach(function(d) { %>
    <article class="design-card">
      <a href="/design/<%= d.id %>"><img src="/img/designs/thumb/<%= d.colorFile %>" alt="<%= t('home.design_alt', {title: d.title}) %>" loading="lazy" decoding="async"></a>
      <div class="pad">
        <h3><a href="/design/<%= d.id %>"><%= d.title %></a></h3>
        <span class="like-count" title="<%= t('toploved.loves', {count: d.like_count || 0}) %>">♥ <%= d.like_count || 0 %></span>
      </div>
    </article>
    <% }); %>
  </div>
</section>
<% } %>

<%- include('../partials/ad-slot', {slot: 'gallery_inline'}) %>

<% if (typeof catIntro !== 'undefined' && catIntro) { %>
<section class="card cat-intro">
  <h2><%= catIntro.name %></h2>
  <% if (catIntro.blurb) { %><p><%= catIntro.blurb %></p><% } else { %><p><%= t('gallery.cat_fallback', {name: catIntro.name, count: catIntro.count}) %></p><% } %>
  <p class="muted"><%= t('gallery.cat_note', {name: catIntro.name}) %></p>
</section>
<% } %>

<% if (typeof styleIntro !== 'undefined' && styleIntro) { %>
<section class="card cat-intro">
  <h2><%= styleIntro.name %></h2>
  <% if (styleIntro.blurb) { %><p><%= styleIntro.blurb %></p><% } else { %><p><%= t('gallery.style_fallback', {name: styleIntro.name, count: styleIntro.count}) %></p><% } %>
  <p class="muted"><%= t('gallery.style_note', {name: styleIntro.name}) %></p>
</section>
<% } %>

<% if (!designs.length) { %><p><%= t('gallery.no_match') %></p><% } %>
<div class="grid">
  <% designs.forEach(function(d) { %>
  <article class="design-card">
    <a href="/design/<%= d.id %>"><span class="living-frame"><img class="living-picture" src="/img/designs/<%= d.thumb || d.linework_wm_path.split('/').pop() %>" alt="<%= t('home.design_alt', {title: d.title}) %>" loading="lazy" decoding="async"><span class="living-atmosphere" aria-hidden="true"></span></span></a>
    <button type="button" class="fav-heart" data-fav-id="<%= d.id %>" aria-pressed="false" aria-label="<%= t('fav.add') %>" title="<%= t('fav.add') %>"></button><span class="like-count" data-like-count="<%= d.id %>" title="<%= t('toploved.loves', {count: d.like_count || 0}) %>">♥ <%= d.like_count || 0 %></span>
    <div class="pad">
      <h3><a href="/design/<%= d.id %>"><%= d.title %></a></h3>
      <% if (d.show_featured) { %><span class="badge ok"><%= t('show.badge') %></span><% } %>
      <% d.categories.slice(0,3).forEach(function(c) { %><span class="tag"><%= c %></span><% }); %>
      <p class="muted"><%= fmtMoney(premadePrice) %><% if (sale) { %> <span class="badge ok"><%= t('common.sale') %></span><% } %></p>
    </div>
  </article>
  <% }); %>
</div>
<% if (pagination && pagination.totalPages > 1) { %>
<nav class="gallery-pagination" aria-label="Gallery pages" style="display:flex;gap:1rem;justify-content:center;align-items:center;margin:2rem 0;">
  <% if (pagination.prevUrl) { %><a class="btn" href="<%= pagination.prevUrl %>">&larr; Previous</a><% } %>
  <span class="muted">Page <%= pagination.page %> of <%= pagination.totalPages %> &middot; <%= pagination.total %> designs</span>
  <% if (pagination.nextUrl) { %><a class="btn" href="<%= pagination.nextUrl %>">Next &rarr;</a><% } %>
</nav>
<% } %>

<section class="card gallery-about" style="margin-top:2rem;">
  <h2><%= t('gallery.intro_h') %></h2>
  <p><%= t('gallery.intro_1') %></p>
  <p><%= t('gallery.intro_2') %></p>
  <p>
    <a href="/guides/choosing-a-design"><%= t('trust.guides') %></a> &middot;
    <a href="/guides/custom-design-process"><%= t('nav.custom_design') %></a> &middot;
    <a href="/guides/aftercare"><%= t('trust.aftercare') %></a>
  </p>
</section>

<%- include('../partials/trust-block') %>

<%- include('../partials/tip-jar') %>
