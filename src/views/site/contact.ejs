<h1>Contact Us</h1>
<p>Questions about an order, a custom design, selling your art, or anything else — send us a message and we'll get back to you.</p>
<p>Prefer email? Reach us directly at <a href="mailto:tattoo.art.customs@gmail.com">tattoo.art.customs@gmail.com</a>.</p>
<form method="post" action="/contact" class="stack">
  <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true">
  <label>Your name
    <input type="text" name="name" maxlength="120" required>
  </label>
  <label>Your email
    <input type="email" name="email" maxlength="120" required>
  </label>
  <label>Topic
    <select name="topic">
      <option value="order">Order question</option>
      <option value="custom">Custom design request</option>
      <option value="artist">Selling my art / artist signup</option>
      <option value="shop">Tattoo shop signup</option>
      <option value="other">Something else</option>
    </select>
  </label>
  <label>Message
    <textarea name="message" rows="6" maxlength="2000" required></textarea>
  </label>
  <button class="btn" type="submit">Send message</button>
</form>
