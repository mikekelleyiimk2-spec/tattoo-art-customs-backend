<h1><%= t('toploved.title') %></h1>
<p class="muted"><%= t('toploved.sub') %></p>

<section class="card toploved-intro">
  <h2><%= t('toploved.intro_h') %></h2>
  <p><%= t('toploved.intro_1') %></p>
  <p><%= t('toploved.intro_2') %></p>
</section>

<% if (!designs.length) { %>
  <p><strong><%= t('toploved.empty_title') %></strong></p>
  <p class="muted"><%= t('toploved.empty_text') %></p>
  <p><a class="btn" href="/gallery"><%= t('toploved.browse') %></a></p>
<% } %>
<div class="grid">
  <% designs.forEach(function(d, i) { %>
  <article class="design-card">
    <a href="/design/<%= d.id %>"><span class="living-frame"><img class="living-picture" src="/img/designs/<%= d.thumb %>" alt="<%= d.title %>" loading="lazy" decoding="async"><span class="living-atmosphere" aria-hidden="true"></span></span></a>
    <button type="button" class="fav-heart" data-fav-id="<%= d.id %>" aria-pressed="false" aria-label="<%= t('fav.add') %>" title="<%= t('fav.add') %>"></button>
    <% if (d.badge) { %><span class="badge <%= d.badge === 'selling_fast' ? 'ok' : 'warn' %> top-loved-badge"><%= t('toploved.badge_' + d.badge) %></span><% } %>
    <div class="pad">
      <p class="muted"><span class="badge ok">#<%= d.rank != null ? d.rank : i + 1 %></span> <span class="love-count" aria-label="<%= t('toploved.loves', {count: d.like_count}) %>">♥ <%= d.like_count %></span></p>
      <h3><a href="/design/<%= d.id %>"><%= d.title %></a></h3>
      <% d.categories.slice(0,3).forEach(function(c) { %><span class="tag"><%= c %></span><% }); %>
      <p class="muted"><%= d.price %></p>
    </div>
  </article>
  <% }); %>
</div>
<% if (typeof pagination !== 'undefined' && pagination && pagination.totalPages > 1) { %>
<nav class="gallery-pagination" aria-label="Top loved pages" style="display:flex;gap:1rem;justify-content:center;align-items:center;margin:2rem 0;">
  <% if (pagination.prevUrl) { %><a class="btn" href="<%= pagination.prevUrl %>">&larr; Previous</a><% } %>
  <span class="muted">Page <%= pagination.page %> of <%= pagination.totalPages %> &middot; <%= pagination.total %> designs</span>
  <% if (pagination.nextUrl) { %><a class="btn" href="<%= pagination.nextUrl %>">Next &rarr;</a><% } %>
</nav>
<% } %>

<%- include('../partials/trust-block') %>
