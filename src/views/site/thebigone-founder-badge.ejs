<% if (typeof founder !== 'undefined' && founder && founder.ordinal) { %><div class="tbo-card" style="text-align:center;background:var(--ink);border:3px solid var(--gold);padding:10px 16px;margin:12px 0;"><p class="src" style="letter-spacing:2px;margin:0;font-weight:900;color:var(--gold);">★ FOUNDING MEMBER — No. <%= founder.ordinal %> of the first <%= (typeof foundingCap !== 'undefined' && foundingCap) ? foundingCap : 500 %></p></div><% } %>