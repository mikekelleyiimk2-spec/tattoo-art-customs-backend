<h1><%= t('discounts.title') %></h1>
<p class="muted"><%= t('discounts.sub') %></p>

<div class="discount-grid">
  <div class="product-card discount-card">
    <div class="discount-badge"><%= t('discounts.electrum_badge') %></div>
    <h3><%= t('discounts.electrum_h') %></h3>
    <p><%= t('discounts.electrum_text') %></p>
    <p class="discount-code"><%= t('discounts.code_label') %>: <strong>TATART20</strong></p>
    <a class="btn" href="https://club.co/s/R6gQCOlWghEC9" target="_blank" rel="noopener nofollow sponsored"><%= t('discounts.electrum_cta') %></a>
  </div>

  <div class="product-card discount-card">
    <div class="discount-badge"><%= t('discounts.baselabs_badge') %></div>
    <h3><%= t('discounts.baselabs_h') %></h3>
    <p><%= t('discounts.baselabs_text') %></p>
    <p class="discount-code"><%= t('discounts.code_label') %>: <strong>TAC20</strong></p>
    <a class="btn" href="https://baselabs.is/?coupon=TAC20" target="_blank" rel="noopener nofollow sponsored"><%= t('discounts.baselabs_cta') %></a>
  </div>

  <div class="product-card discount-card">
    <div class="discount-badge"><%= t('discounts.recovery_badge') %></div>
    <h3><%= t('discounts.recovery_h') %></h3>
    <p><%= t('discounts.recovery_text') %></p>
    <!-- TODO: replace href with the Lasso "Get link" URL once generated in the Lasso Marketplace -->
    <a class="btn" href="https://recoveryaftercare.com/" target="_blank" rel="noopener nofollow sponsored"><%= t('discounts.recovery_cta') %></a>
  </div>

  <div class="product-card discount-card">
    <div class="discount-badge"><%= t('discounts.drtattoo_badge') %></div>
    <h3><%= t('discounts.drtattoo_h') %></h3>
    <p><%= t('discounts.drtattoo_text') %></p>
    <a class="btn" href="https://www.drtattooskin.com/TATTOOARTCUSTOMS" target="_blank" rel="noopener nofollow sponsored"><%= t('discounts.drtattoo_cta') %></a>
  </div>

  <div class="product-card discount-card">
    <div class="discount-badge"><%= t('discounts.amazon_badge') %></div>
    <h3><%= t('discounts.amazon_h') %></h3>
    <p><%= t('discounts.amazon_text') %></p>
    <a class="btn" href="https://www.amazon.com/s?k=tattoo+aftercare&tag=tattooartcust-20" target="_blank" rel="noopener nofollow sponsored"><%= t('discounts.amazon_cta') %></a>
  </div>
</div>

<p class="fineprint"><%= t('discounts.disclosure') %></p>

<style>
.discount-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; margin: 1.5rem 0; }
.discount-card { position: relative; }
.discount-badge { display: inline-block; background: var(--accent); color: #fff; font-size: .8rem; font-weight: bold; padding: .25rem .6rem; border-radius: 20px; margin-bottom: .5rem; }
.discount-code { font-size: 1.1rem; }
.discount-code strong { background: var(--surface); border: 1px dashed var(--border); padding: .2rem .5rem; border-radius: 6px; letter-spacing: 1px; }
</style>
