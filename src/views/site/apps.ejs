<h1>Apps by Usefulappz™</h1>
<img src="/img/logos/usefulappz-hero.webp" alt="Usefulappz™ logo" style="max-width:320px;width:100%;height:auto;display:block;margin:0 auto 1.5rem;" />
<p>Usefulappz™ builds the apps behind our businesses. More apps are on the way.</p>
<p style="text-align:center;margin:1rem 0;"><a class="btn" href="/testers"><%= t('testers.apps_link') %></a></p>

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.5rem;margin:1.5rem 0;">
  <div id="tac" style="text-align:center;border:1px solid var(--line,#ddd);border-radius:8px;padding:1.5rem;">
    <p style="font-size:2rem;">🎨</p>
    <p><strong>Tattoo Art Customs</strong></p>
    <p class="muted">Full design gallery, custom tattoos in 48 hours, memberships, shop tools.</p>
    <% if (playStoreUrl || playStoreProUrl) { %>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;margin:1rem 0;text-align:center;">
        <% if (playStoreUrl) { %>
        <div style="border:1px solid var(--line,#ddd);border-radius:8px;padding:1rem;">
          <p><strong><%= t('apps.free_label') %></strong></p>
          <p class="muted"><%= t('apps.free_text') %></p>
          <p><a class="btn" href="<%= playStoreUrl %>"><%= t('home.get_play_free') %></a></p>
        </div>
        <% } %>
        <% if (playStoreProUrl) { %>
        <div style="border:1px solid var(--line,#ddd);border-radius:8px;padding:1rem;">
          <p><strong><%= t('apps.pro_label') %></strong></p>
          <p class="muted"><%= t('apps.pro_text') %></p>
          <p><a class="btn" href="<%= playStoreProUrl %>"><%= t('home.get_play_pro') %></a></p>
        </div>
        <% } %>
      </div>
    <% } else { %>
      <p class="muted"><%= t('apps.play_soon') %></p>
    <% } %>
    <p><a class="btn" href="/tac-android"><%= t('apps.get_android_free') %></a></p>
    <p><a class="btn btn-secondary" href="/tac-android-pro"><%= t('apps.get_android_pro') %></a></p>
    <% if (appStoreUrl) { %>
      <p><a class="btn" href="<%= appStoreUrl %>">Download on the App Store</a></p>
    <% } else { %>
      <p><a class="btn" href="/ios-app">Get the iPhone app ($1.67)</a></p>
    <% } %>
  </div>
  <div id="little-inkers" style="text-align:center;border:1px solid var(--line,#ddd);border-radius:8px;padding:1.5rem;">
    <p style="font-size:2rem;">🖍️</p>
    <p><strong><%= t('apps.lil_title') %></strong></p>
    <p class="muted"><%= t('apps.lil_text') %></p>
    <% if (littleInkersYoutubeUrl) { %>
    <p><a class="btn btn-secondary" href="<%= littleInkersYoutubeUrl %>" target="_blank" rel="noopener">🖍️ <%= t('apps.lil_watch') %></a></p>
    <% } %>
    <p><a class="btn" href="https://facebook.com/reel/1117674510777106/" target="_blank" rel="noopener">🎬 <%= t('apps.lil_commercial') %></a></p>
    <p><a class="btn" href="/little-inkers-android"><%= t('apps.li_android_btn') %></a> <a class="btn btn-secondary" href="/little-inkers-ios"><%= t('apps.li_ios_btn') %></a></p>
    <p><span class="badge"><%= t('apps.free_label') %></span></p>
    <p class="muted fineprint"><%= t('apps.lil_notify') %></p>
  </div>
  <div style="text-align:center;border:1px solid var(--line,#ddd);border-radius:8px;padding:1.5rem;background:linear-gradient(135deg,#fff5f5,#f0f8ff);">
    <p style="font-size:2rem;">🌈</p>
    <p><strong>Poppy &amp; Ziggy Show</strong></p>
    <p class="muted">Our new kids' show! Poppy &amp; Ziggy learn colors, numbers, shapes and more through fun adventures. New episodes every Friday at 5pm.</p>
    <p><a class="btn" href="https://www.youtube.com/@ZiggyPoppy-l3b?sub_confirmation=1" target="_blank" rel="noopener">📺 Watch &amp; subscribe on YouTube</a></p>
    <p><a class="btn btn-secondary" href="/poppy-and-ziggy">🌈 Episode guide &amp; premiere dates</a></p>
    <p class="muted fineprint">Watch the promos:</p>
    <p>
      <a href="https://www.instagram.com/reel/DeVgo6xjspk/" target="_blank" rel="noopener">🎨 Crayon Treasure Hunt</a><br>
      <a href="https://www.facebook.com/122095865451512549" target="_blank" rel="noopener">🔢 Hide and Seek</a>
    </p>
  </div>
  <div id="odometer" style="text-align:center;border:1px solid var(--line,#ddd);border-radius:8px;padding:1.5rem;">
    <p style="font-size:2rem;">🚗</p>
    <p><strong>Odometer</strong></p>
    <p class="muted"><%= t('apps.odometer_text') %></p>
    <p><span class="badge"><%= t('apps.odometer_badge') %></span></p>
    <% if (dl && dl['com.usefulappz.odometer']) { %><p><a class="btn" href="/api/apps/com.usefulappz.odometer/apk"><%= t('apps.dl_now', {price: '$1.99'}) %></a></p><% } %>
  </div>
  <div id="aibutton" style="text-align:center;border:1px solid var(--line,#ddd);border-radius:8px;padding:1.5rem;">
    <p style="font-size:2rem;">🎙️</p>
    <p><strong>AI Button</strong></p>
    <p class="muted"><%= t('apps.aibutton_text') %></p>
    <p><span class="badge"><%= t('apps.aibutton_badge') %></span></p>
    <% if (dl && dl['com.usefulappz.aibar']) { %><p><a class="btn" href="/api/apps/com.usefulappz.aibar/apk"><%= t('apps.dl_now', {price: '$9.99'}) %></a></p><% } %>
  </div>
</div>

<p class="muted">New apps from Usefulappz™ will appear here as they launch.</p>

