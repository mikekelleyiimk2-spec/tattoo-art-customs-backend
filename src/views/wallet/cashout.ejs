<h1><%= t('wallet.title') %></h1>
<p><a href="/wallet/app"><%= t('wallet.refresh') %></a></p>

<section class="card">
  <h2><%= t('wallet.balance_h') %></h2>
  <p><strong><%= t('wallet.payable', {balance: money(balance)}) %></strong></p>
  <p class="muted"><%= t('wallet.auto_note') %></p>
</section>

<% if (!destinations.length) { %>
<section class="card">
  <h2><%= t('wallet.setup_h') %></h2>
  <p><%= t('wallet.setup_text') %></p>
</section>
<% } else { %>
<section class="card">
  <h2><%= t('wallet.cashout_h') %></h2>
  <p class="muted"><%- t('wallet.cashout_to', {dest: '<strong>' + destinations[0].summary + '</strong>'}) %></p>
  <% if (earlyQuote) { %>
  <p><%- t('wallet.cashout_math', {balance: money(balance), fee: money(earlyQuote.penaltyCents), net: '<strong>' + money(earlyQuote.netCents) + '</strong>'}) %></p>
  <form method="post" action="<%= payoutBase %>/cashout-now" onsubmit="return confirm('Cash out <%= money(earlyQuote.netCents) %> now? A 3% early-cashout fee (<%= money(earlyQuote.penaltyCents) %>) applies.')">
    <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
    <input type="hidden" name="destination_id" value="<%= destinations[0].id %>">
    <button class="btn" type="submit"><%= t('wallet.cashout_now', {net: money(earlyQuote.netCents)}) %></button>
  </form>
  <p class="muted"><%= t('wallet.keep') %></p>
  <form method="post" action="<%= payoutBase %>/commissions-to-credit" onsubmit="return confirm('Move <%= money(balance) %> to your site credit? No fee — spend it on the site anytime.')">
    <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
    <button class="btn btn-secondary" type="submit"><%= t('wallet.keep_credit', {balance: money(balance)}) %></button>
  </form>
  <% } else { %>
  <p class="muted"><%= t('wallet.min_cashout', {min: money(minCashoutCents)}) %></p>
  <% } %>
  <p class="muted"><%= t('wallet.setup_note') %></p>
</section>
<% } %>

<% if (cashoutRequests.length) { %>
<section class="card">
  <h2><%= t('wallet.requests_h') %></h2>
  <table>
    <thead><tr><th><%= t('wallet.th_date') %></th><th><%= t('wallet.th_amount') %></th><th><%= t('wallet.th_fee') %></th><th><%= t('wallet.th_you_get') %></th><th><%= t('wallet.th_to') %></th><th><%= t('wallet.th_status') %></th><th></th></tr></thead>
    <tbody>
    <% cashoutRequests.forEach(function(c) {
      var snap = {}; try { snap = JSON.parse(c.dest_snapshot || '{}'); } catch (e) {}
    %>
      <tr>
        <td><%= new Date(c.created_at).toLocaleDateString(localeTag) %></td>
        <td><%= money(c.amount_cents) %></td>
        <td><%= money(c.penalty_cents) %></td>
        <td><strong><%= money(c.net_cents) %></strong></td>
        <td><%= snap.label || '' %></td>
        <td><span class="badge"><%= c.status %></span></td>
        <td>
          <% if (c.status === 'pending') { %>
          <form method="post" action="<%= payoutBase %>/cashout/<%= c.id %>/cancel" style="display:inline">
            <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
            <button class="btn btn-secondary" type="submit"><%= t('wallet.cancel') %></button>
          </form>
          <% } %>
        </td>
      </tr>
    <% }); %>
    </tbody>
  </table>
</section>
<% } %>
