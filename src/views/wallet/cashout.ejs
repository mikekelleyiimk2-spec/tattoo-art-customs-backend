<h1>Cashout</h1>
<p><a href="/wallet/app">Refresh</a></p>

<section class="card">
  <h2>Your commission balance</h2>
  <p><strong><%= money(balance) %></strong> payable</p>
  <p class="muted">Payouts go out automatically every Monday morning, or cash out below anytime (3% early fee).</p>
</section>

<% if (!destinations.length) { %>
<section class="card">
  <h2>Set up your payouts</h2>
  <p>Commission payout setup happens on the Tattoo Art Customs website — add and verify your payout destinations (PayPal, Cash App, Zelle, Venmo, bank account) there. Once that's done, you can cash out right here in the app anytime.</p>
</section>
<% } else { %>
<section class="card">
  <h2>Cash out now</h2>
  <p class="muted">Cashing out to your default destination: <strong><%= destinations[0].summary %></strong></p>
  <% if (earlyQuote) { %>
  <p>Balance <%= money(balance) %> − 3% early fee <%= money(earlyQuote.penaltyCents) %> = <strong><%= money(earlyQuote.netCents) %></strong></p>
  <form method="post" action="<%= payoutBase %>/cashout-now" onsubmit="return confirm('Cash out <%= money(earlyQuote.netCents) %> now? A 3% early-cashout fee (<%= money(earlyQuote.penaltyCents) %>) applies.')">
    <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
    <input type="hidden" name="destination_id" value="<%= destinations[0].id %>">
    <button class="btn" type="submit">Cash out <%= money(earlyQuote.netCents) %> now</button>
  </form>
  <p class="muted">Or keep it on the site — no fee:</p>
  <form method="post" action="<%= payoutBase %>/commissions-to-credit" onsubmit="return confirm('Move <%= money(balance) %> to your site credit? No fee — spend it on the site anytime.')">
    <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
    <button class="btn btn-secondary" type="submit">Keep <%= money(balance) %> as site credit</button>
  </form>
  <% } else { %>
  <p class="muted">You need at least <%= money(minCashoutCents) %> payable to cash out.</p>
  <% } %>
  <p class="muted">To add, change, or verify payout destinations, set them up on the Tattoo Art Customs website — commission payout setup is website-only.</p>
</section>
<% } %>

<% if (cashoutRequests.length) { %>
<section class="card">
  <h2>Cashout requests</h2>
  <table>
    <thead><tr><th>Date</th><th>Amount</th><th>Fee</th><th>You get</th><th>To</th><th>Status</th><th></th></tr></thead>
    <tbody>
    <% cashoutRequests.forEach(function(c) {
      var snap = {}; try { snap = JSON.parse(c.dest_snapshot || '{}'); } catch (e) {}
    %>
      <tr>
        <td><%= new Date(c.created_at).toLocaleDateString() %></td>
        <td><%= money(c.amount_cents) %></td>
        <td><%= money(c.penalty_cents) %></td>
        <td><strong><%= money(c.net_cents) %></strong></td>
        <td><%= snap.label || '' %></td>
        <td><span class="badge"><%= c.status %></span></td>
        <td>
          <% if (c.status === 'pending') { %>
          <form method="post" action="<%= payoutBase %>/cashout/<%= c.id %>/cancel" style="display:inline">
            <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
            <button class="btn btn-secondary" type="submit">Cancel</button>
          </form>
          <% } %>
        </td>
      </tr>
    <% }); %>
    </tbody>
  </table>
</section>
<% } %>
