<h1>Upload a new piece</h1>
<% if (typeof remake !== 'undefined' && remake) { %>
<p class="card" style="border:2px solid #6a4fb3"><strong>Remake upload:</strong> this piece will replace your sold custom piece <strong><%= remake.title %></strong> once approved. Keep it a custom portfolio piece in the same style.</p>
<% } %>
<p class="muted">Your piece goes live in <strong>your portfolio</strong> after admin approval. Choose below whether it also appears on the main gallery as a pre-design.</p>
<p><a href="/artist/portfolio/upload-batch">Uploading several pieces? Use the batch uploader &rarr;</a></p>
<form method="post" action="<%= action %>" enctype="multipart/form-data" class="form">
  <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
  <% if (typeof remake !== 'undefined' && remake) { %><input type="hidden" name="remake" value="<%= remake.id %>"><% } %>
  <label for="title">Title</label>
  <input type="text" id="title" name="title" maxlength="120" required>
  <label for="description">Description</label>
  <textarea id="description" name="description" maxlength="2000"></textarea>
  <label for="style">Style (fixed at upload — this is where it appears in the gallery for pre-designs)</label>
  <select id="style" name="style" required>
    <option value="">— pick a style —</option>
    <% styles.forEach(function(s) { %><option value="<%= s %>"><%= s %></option><% }); %>
  </select>
  <label for="categories">Extra categories (comma-separated, optional)</label>
  <input type="text" id="categories" name="categories" maxlength="300">

  <h2>Listing type</h2>
  <label><input type="radio" name="listing_type" value="custom" checked>
    <strong>Custom portfolio piece</strong> — sells at the custom-design price (currently <%= money(customPrice) %>), shown <strong>only in your portfolio</strong>, never the main gallery. Buyers get it instantly after payment.</label>
  <label><input type="radio" name="listing_type" value="predesign">
    <strong>Pre-design</strong> — also listed on the <strong>main design gallery</strong> under the style above at the pre-design price (currently <%= money(premadePrice) %>), and stays in your portfolio too.</label>

  <h2>Watermark</h2>
  <p class="muted">Public visitors only ever see watermarked linework. <strong>The site's solid-black anti-trace marks are applied in both cases.</strong></p>
  <label><input type="radio" name="watermark_choice" value="site" checked>
    <strong>Site watermark</strong> — our standard watermark is applied automatically.</label>
  <label><input type="radio" name="watermark_choice" value="custom" id="wm-custom">
    <strong>My own watermark</strong> — upload your watermark image below, or leave it blank to use the mark you built on-site.</label>
  <div id="wm-warn" class="card" style="display:none;border:2px solid #b3541e">
    <strong>Warning:</strong> basic see-through marks or light colors can be cleaned off — then your art can be traced or stolen with no pay to you. For real protection, <a href="/artist/watermark-builder"><strong>build your mark on-site</strong></a>: signature + studio name, dark colors, multiple overlapping lines. The site's solid-black anti-trace marks are applied either way.
  </div>
  <label for="watermark">Your watermark image (only needed if you chose your own above <em>and</em> haven't built one on-site — JPG/PNG/WebP, max 15 MB)</label>
  <input type="file" id="watermark" name="watermark" accept="image/jpeg,image/png,image/webp">
  <script>
  (function () {
    var radio = document.getElementById('wm-custom');
    var warn = document.getElementById('wm-warn');
    function sync() { warn.style.display = radio.checked ? '' : 'none'; }
    document.querySelectorAll('input[name="watermark_choice"]').forEach(function (r) {
      r.addEventListener('change', sync);
    });
    sync();
  })();
  </script>

  <h2>Content rating</h2>
  <p class="muted">Rate your piece honestly. Linework-only pieces are fine. Nudity is allowed with a watermark. Sexual acts or highly offensive content show a blurred preview (age-verified users may opt in to view them unblurred). Hateful/racist content is held for review by an administrator.</p>
  <label for="sensitivity">Content rating</label>
  <select id="sensitivity" name="sensitivity" required>
    <option value="normal" selected>Normal</option>
    <option value="nude">Contains nudity</option>
    <option value="explicit">Explicit — sexual acts or highly offensive content (preview blurred)</option>
    <option value="racist">Contains racist/hateful content (held for admin review)</option>
  </select>

  <h2>Your art files</h2>
  <label for="linework">Clean linework image (JPG/PNG/WebP, max 15 MB) — required</label>
  <input type="file" id="linework" name="linework" accept="image/jpeg,image/png,image/webp" required>
  <label for="color">Full-color image (JPG/PNG/WebP, max 15 MB) — optional</label>
  <input type="file" id="color" name="color" accept="image/jpeg,image/png,image/webp">
  <p class="muted">No color version? Leave the color file blank — your linework can still be approved and posted (with our watermark) while we create the full-color version. On sales of pieces where you did not supply the color, the designer's commission rate is 5 points lower and the website keeps a 5-point colorization fee — see your commission dashboard.</p>
  <p class="muted">An administrator reviews every upload. Your piece enters your portfolio within <strong>2 hours</strong>, or you will receive a rejection reason.</p>
  <p><button class="btn" type="submit">Upload for review</button></p>
</form>
