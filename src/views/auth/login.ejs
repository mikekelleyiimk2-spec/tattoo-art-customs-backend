<h1><%= t('auth.login_title') %></h1>
<p class="muted">This is your <strong>OneMind sign-in</strong> — one account for everything Useful Appz makes. The same account signs you in on every surface, whether or not you ever open the OneMind app: this account <em>is</em> your OneMind account, and signing in here seats you at the table.</p>
<% if (locals.googleSignin) { %>
<p><a class="btn" href="/auth/google">Continue with Google</a></p>
<p class="muted">Door #1: the Google/Gmail account you already have. If its email matches your account here, it's the same seat — no new account, no new password to invent.</p>
<% } %>
<form method="post" action="/login" class="form">
  <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
  <label for="email"><%= t('auth.email') %></label>
  <input type="email" id="email" name="email" required autocomplete="email">
  <label for="password"><%= t('auth.password') %></label>
  <input type="password" id="password" name="password" required autocomplete="current-password">
  <p><button class="btn" type="submit"><%= t('auth.login_btn') %></button></p>
</form>
<p><a href="/forgot"><%= t('auth.forgot') %></a> · <a href="/signup"><%= t('auth.create_account') %></a></p>
