<h1><%= t('auth.login_title') %></h1>
<p class="muted">Sign in with the account you already have — or create one in a few seconds.</p>
<% if (locals.googleSignin) { %>
<p><a class="btn" href="/auth/google">Continue with Google</a></p>
<p class="muted">Use the Google account you already have — no new password to invent.</p>
<% } %>
<form method="post" action="/login" class="form">
  <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
  <label for="email"><%= t('auth.email') %></label>
  <input type="email" id="email" name="email" required autocomplete="email">
  <label for="password"><%= t('auth.password') %></label>
  <input type="password" id="password" name="password" required autocomplete="current-password">
  <p><button class="btn" type="submit"><%= t('auth.login_btn') %></button></p>
</form>
<p><a href="/forgot"><%= t('auth.forgot') %></a> · <a href="/signup"><%= t('auth.create_account') %></a></p>
