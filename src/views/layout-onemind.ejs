<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title : 'OneMind' %></title>
<% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
<meta name="description" content="<%= metaDescription %>">
<% } %>
<style>
  :root { color-scheme: light dark; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: Arial, Roboto, "Segoe UI", sans-serif; background: #ffffff; color: #202124; }
  @media (prefers-color-scheme: dark) { body { background: #202124; color: #e8eaed; } }
</style>
</head>
<body>
<%- body %>
</body>
</html>
