<%# Payout settings + cashout — shared by artist and shop dashboards.
    Expects: payoutBase ('/artist'|'/shop'), destinations, cashoutMode,
    balance, cashoutRequests, earlyQuote, destTypes, minCashoutCents, money %>
<section class="card" id="payouts">
  <h2>Payouts</h2>
  <p><strong><%= money(balance) %></strong> payable</p>

  <form method="post" action="<%= payoutBase %>/cashout-mode" class="form">
    <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
    <label>How do you want to be paid?</label>
    <label><input type="radio" name="mode" value="weekly" <%= cashoutMode !== 'manual' ? 'checked' : '' %>> Automatic weekly — full balance every Monday morning, no fee</label>
    <label><input type="radio" name="mode" value="manual" <%= cashoutMode === 'manual' ? 'checked' : '' %>> Manual — cash out whenever (3% early-cashout fee, once a day)</label>
    <p><button class="btn btn-secondary" type="submit">Save preference</button></p>
  </form>

  <h3>Where should the money go?</h3>
  <% if (destinations.length) { %>
  <table>
    <thead><tr><th>Destination</th><th>Type</th><th></th></tr></thead>
    <tbody>
    <% destinations.forEach(function(d) { %>
      <tr>
        <td><%= d.summary %> <% if (d.is_default) { %><span class="badge ok">default</span><% } %></td>
        <td><%= destTypes[d.dest_type] ? destTypes[d.dest_type].label : d.dest_type %></td>
        <td>
          <% if (!d.is_default) { %>
          <form method="post" action="<%= payoutBase %>/payout-destination/<%= d.id %>/default" style="display:inline">
            <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
            <button class="btn btn-secondary" type="submit">Make default</button>
          </form>
          <% } %>
          <form method="post" action="<%= payoutBase %>/payout-destination/<%= d.id %>/delete" style="display:inline">
            <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
            <button class="btn btn-secondary" type="submit" onclick="return confirm('Remove this payout destination?')">Remove</button>
          </form>
        </td>
      </tr>
    <% }); %>
    </tbody>
  </table>
  <% } else { %>
  <p class="muted">No payout destination yet — add one below so your commissions can reach you.</p>
  <% } %>

  <details>
    <summary>Add a payout destination</summary>
    <form method="post" action="<%= payoutBase %>/payout-destination/add" class="form" id="dest-form">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <label for="dest_type">Type</label>
      <select id="dest_type" name="dest_type">
        <% Object.keys(destTypes).forEach(function(k) { %>
        <option value="<%= k %>"><%= destTypes[k].label %> — <%= destTypes[k].hint %></option>
        <% }); %>
      </select>
      <% Object.keys(destTypes).forEach(function(k) { %>
      <div class="dest-fields" data-dest="<%= k %>" style="display:none">
        <% destTypes[k].fields.forEach(function(f) { %>
        <label><%= f.label %>
          <% if (f.type === 'select') { %>
          <select name="<%= f.key %>"><% f.options.forEach(function(o) { %><option value="<%= o %>"><%= o %></option><% }); %></select>
          <% } else { %>
          <input type="<%= f.type %>" name="<%= f.key %>" placeholder="<%= f.placeholder || '' %>" <%= k !== 'paypal' ? 'disabled' : '' %>>
          <% } %>
        </label>
        <% }); %>
      </div>
      <% }); %>
      <p><button class="btn" type="submit">Add destination</button></p>
    </form>
    <script>
      (function () {
        var sel = document.getElementById('dest_type');
        function show() {
          document.querySelectorAll('#dest-form .dest-fields').forEach(function (el) {
            var on = el.getAttribute('data-dest') === sel.value;
            el.style.display = on ? '' : 'none';
            el.querySelectorAll('input,select').forEach(function (i) { i.disabled = !on; });
          });
        }
        sel.addEventListener('change', show); show();
      })();
    </script>
  </details>

  <h3>Cash out now</h3>
  <% if (earlyQuote && destinations.length) { %>
  <p class="muted">Balance <%= money(balance) %> − 3% early fee <%= money(earlyQuote.penaltyCents) %> = <strong><%= money(earlyQuote.netCents) %></strong> to your default destination (<%= destinations[0].summary %>).</p>
  <form method="post" action="<%= payoutBase %>/cashout-now" onsubmit="return confirm('Cash out <%= money(earlyQuote.netCents) %> now? A 3% early-cashout fee (<%= money(earlyQuote.penaltyCents) %>) applies.')">
    <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
    <input type="hidden" name="destination_id" value="<%= destinations[0].id %>">
    <button class="btn" type="submit">Cash out <%= money(earlyQuote.netCents) %> now</button>
  </form>
  <p class="muted">Or keep it on the site — no fee:</p>
  <form method="post" action="<%= payoutBase %>/commissions-to-credit" onsubmit="return confirm('Move <%= money(balance) %> to your site credit? No fee — spend it on the site anytime.')">
    <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
    <button class="btn btn-secondary" type="submit">Keep <%= money(balance) %> as site credit</button>
  </form>
  <% } else if (!destinations.length) { %>
  <p class="muted">Add a payout destination above to enable cashout.</p>
  <% } else { %>
  <p class="muted">You need at least <%= money(minCashoutCents) %> payable to cash out.</p>
  <% } %>

  <% if (cashoutRequests.length) { %>
  <h3>Cashout requests</h3>
  <table>
    <thead><tr><th>Date</th><th>Amount</th><th>Fee</th><th>You get</th><th>To</th><th>Status</th><th></th></tr></thead>
    <tbody>
    <% cashoutRequests.forEach(function(c) {
      var snap = {}; try { snap = JSON.parse(c.dest_snapshot || '{}'); } catch (e) {}
    %>
      <tr>
        <td><%= new Date(c.created_at).toLocaleDateString() %></td>
        <td><%= money(c.amount_cents) %></td>
        <td><%= money(c.penalty_cents) %></td>
        <td><strong><%= money(c.net_cents) %></strong></td>
        <td><%= snap.label || '' %></td>
        <td><span class="badge"><%= c.status %></span></td>
        <td>
          <% if (c.status === 'pending') { %>
          <form method="post" action="<%= payoutBase %>/cashout/<%= c.id %>/cancel" style="display:inline">
            <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
            <button class="btn btn-secondary" type="submit">Cancel</button>
          </form>
          <% } %>
        </td>
      </tr>
    <% }); %>
    </tbody>
  </table>
  <% } %>
</section>
