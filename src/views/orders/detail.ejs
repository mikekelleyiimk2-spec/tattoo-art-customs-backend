<h1><%= t('orders.title', {id: order.id.slice(0,8)}) %></h1>
<table>
  <tbody>
    <tr><th><%= t('orders.type') %></th><td><%= order.order_type %></td></tr>
    <% if (design) { %><tr><th><%= t('orders.design') %></th><td><%= design.title %></td></tr><% } %>
    <tr><th><%= t('orders.amount') %></th><td><%= fmtMoney(order.amount_cents) %></td></tr>
    <% if (order.discount_applied === 'first_custom_20') { %>
      <tr><th><%= t('orders.discount') %></th><td><%= t('orders.discount_first') %> <span class="muted"><%= t('orders.discount_sub') %></span></td></tr>
    <% } %>
    <% if (order.order_type === 'custom' && depositTotal != null) { %>
      <tr><th><%= t('orders.deposit_due') %></th><td><%= fmtMoney(depositTotal) %> <span class="muted"><%= t('orders.deposit_includes', {fee: fmtMoney(order.fee_cents)}) %></span></td></tr>
      <tr><th><%= t('orders.total_fees') %></th><td><%= fmtMoney(fullTotal) %> <span class="muted"><%= t('orders.remainder') %></span></td></tr>
    <% } %>
    <tr><th><%= t('orders.paid') %></th><td><%= fmtMoney(order.amount_paid_cents) %></td></tr>
    <tr><th><%= t('orders.status') %></th><td><span class="badge"><%= order.status %></span></td></tr>
    <% if (order.delivery_due) { %><tr><th><%= t('orders.delivery_due') %></th><td><%= new Date(order.delivery_due).toLocaleString(localeTag) %></td></tr><% } %>
  </tbody>
</table>
<% if (vatNote) { %><p class="muted fineprint"><%= vatNote %></p><% } %>

<% if (order.status === 'paid') { %>
<section class="card">
  <h2><%= t('orders.your_download') %></h2>
  <form method="post" action="/orders/<%= order.id %>/download-token">
    <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
    <button class="btn" type="submit"><%= t('orders.gen_link') %></button>
  </form>
  <% if (downloads.length) { %>
  <ul><% downloads.forEach(function(d) { %>
    <li><a href="/orders/download/<%= d.token %>/view"><%= t('orders.download_files') %></a> <span class="muted"><%= t('orders.expires', {date: new Date(d.expires_at).toLocaleString(localeTag)}) %></span></li>
  <% }); %></ul>
  <% } %>
</section>
<% if (order.order_type === 'premade' && order.design_id) { %>
<section class="card">
  <h2><%= t('transfer.send_title') %></h2>
  <p class="muted"><%= t('transfer.send_short') %></p>
  <p><a class="btn btn-secondary" href="/transfers/send/<%= order.id %>"><%= t('transfer.send_btn') %></a></p>
  <% if (typeof transfers !== 'undefined' && transfers.length) { %>
  <ul><% transfers.forEach(function(s) { %>
    <li><%= s.to_email %> — <span class="badge"><%= s.status %></span> <span class="muted"><%= new Date(s.created_at).toLocaleString(localeTag) %></span></li>
  <% }); %></ul>
  <% } %>
</section>
<% } %>
<% } else if (order.status === 'pending') { %>
<section class="card">
  <h2><%= t('orders.complete_payment') %></h2>
  <% const _ofx = fxNote(order.amount_cents); if (_ofx) { %><p class="muted fineprint"><%= _ofx %></p><% } %>
  <p><a class="btn" href="/orders/manual/<%= order.id %>"><%= t('orders.pay_manual') %></a></p>
  <% if (Number(order.amount_paid_cents || 0) === 0) { %>
  <form method="post" action="/orders/<%= order.id %>/cancel" class="form" onsubmit="return confirm('Cancel this order?');">
    <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
    <p><button class="linklike" type="submit"><%= t('orders.cancel_order') %></button></p>
  </form>
  <% } %>
</section>
<% } %>
