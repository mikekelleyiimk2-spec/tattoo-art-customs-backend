<h1>Request a custom design</h1>
<% if (typeof firstCustom !== 'undefined' && firstCustom) { %>
<p class="notice"><strong>Opening sale — 20% off your first custom!</strong> Limited time — future sales will be announced. Your price: <strong><%= money(full) %></strong> (regular <%= money(15574) %>).</p>
<% } %>
<p>Custom designs are <strong><%= money(fullTotal) %></strong>. Pay a <strong><%= money(depositTotal) %></strong> deposit now <span class="muted">(includes <%= money(depositFee) %> processing fee)</span> — your design is delivered within <strong>48 hours</strong>, and the download unlocks in your account.</p>
<form method="post" action="/orders/custom" class="form">
  <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
  <label for="brief">Describe your design (subject, style, size, placement, colors…)</label>
  <textarea id="brief" name="brief" required minlength="20" maxlength="4000" placeholder="e.g. A black-and-grey wolf howling at a full moon for my upper arm, about 6 inches tall…"></textarea>
  <% if (typeof artists !== 'undefined' && artists.length) { %>
  <label for="requested_artist_id">Request a specific artist (optional)</label>
  <select id="requested_artist_id" name="requested_artist_id">
    <option value="">No preference — our team will create it</option>
    <% artists.forEach(function(a) { %>
    <option value="<%= a.id %>"><%= a.display_name || 'Artist' %></option>
    <% }); %>
  </select>
  <% } %>
  <% if (typeof rushFee !== 'undefined' && rushFee > 0) { %>
  <p class="rush-box" style="border:2px solid #e8a13d;border-radius:8px;padding:10px 12px;background:#fff8ec;">
    <label for="rush"><input type="checkbox" id="rush" name="rush" value="1"> <strong>&#9889; Rush my design &mdash; 24-hour delivery (+<%= money(rushFee) %>)</strong></label><br>
    <span class="muted">Add a <%= money(rushFee) %> rush fee to your deposit (<%= money(rushDepositTotal) %> total today, processing fee included). Your design jumps to the front of the line and is delivered within <strong>24 hours</strong> instead of 48. $18 of the fee goes straight to your designer as a rush incentive.</span>
  </p>
  <script>
  (function () {
    var box = document.getElementById('rush');
    var btn = document.getElementById('custom-submit-btn');
    if (!box || !btn) return;
    var std = btn.textContent;
    box.addEventListener('change', function () {
      btn.textContent = box.checked ? 'Pay <%= money(rushDepositTotal) %> deposit (rush)' : std;
    });
  })();
  </script>
  <% } %>
  <p><label><input type="checkbox" name="use_credit" value="1"> Pay the deposit with my site credit</label></p>
  <p><button class="btn" id="custom-submit-btn" type="submit">Pay <%= money(depositTotal) %> deposit</button></p>
</form>
<p class="muted">All sales are final. Prefer to pay another way? Place the request, then choose manual payment (CashApp/Venmo) on the order page.</p>
