<h1><%= t('customs.title') %></h1>
<% if (typeof firstCustom !== 'undefined' && firstCustom) { %>
<p class="notice"><strong><%= t('customs.first_sale') %></strong> <%= t('customs.first_sale_tail', {price: fmtMoney(full), regular: fmtMoney(15574)}) %></p>
<% } %>
<p><%= t('customs.intro', {full: fmtMoney(fullTotal), deposit: fmtMoney(depositTotal), fee_note: t('customs.fee_note', {fee: fmtMoney(depositFee)})}) %></p>
<% if (vatNote) { %><p class="muted fineprint"><%= vatNote %></p><% } %>
<form method="post" action="/orders/custom" class="form">
  <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
  <label for="brief"><%= t('customs.brief_label') %></label>
  <% if (typeof designTitle !== 'undefined' && designTitle) { %>
  <p class="notice"><%= t('customs.requesting_design', {title: designTitle}) %></p>
  <% } %>
  <textarea id="brief" name="brief" required minlength="20" maxlength="4000" placeholder="<%= t('customs.brief_ph') %>"><% if (typeof designBrief !== 'undefined' && designBrief) { %><%= designBrief %><% } %></textarea>
  <% if (typeof artists !== 'undefined' && artists.length) { %>
  <label for="requested_artist_id"><%= t('customs.artist_label') %></label>
  <select id="requested_artist_id" name="requested_artist_id">
    <option value=""><%= t('customs.no_pref') %></option>
    <% artists.forEach(function(a) { %>
    <option value="<%= a.id %>"><%= a.display_name || 'Artist' %></option>
    <% }); %>
  </select>
  <% } %>
  <% if (typeof rushFee !== 'undefined' && rushFee > 0) { %>
  <p class="rush-box" style="border:2px solid #e8a13d;border-radius:8px;padding:10px 12px;background:#fff8ec;">
    <label for="rush"><input type="checkbox" id="rush" name="rush" value="1"> <strong><%= t('customs.rush_title', {fee: fmtMoney(rushFee)}) %></strong></label><br>
    <span class="muted"><%= t('customs.rush_text', {fee: fmtMoney(rushFee), total: fmtMoney(rushDepositTotal), cut: fmtMoney(typeof rushDesignerCents !== 'undefined' ? rushDesignerCents : 1800)}) %></span>
  </p>
  <script>
  (function () {
    var box = document.getElementById('rush');
    var btn = document.getElementById('custom-submit-btn');
    if (!box || !btn) return;
    var std = btn.textContent;
    var rushLabel = <%- JSON.stringify(t('customs.pay_deposit_rush', {deposit: fmtMoney(typeof rushDepositTotal !== 'undefined' ? rushDepositTotal : 0)})) %>;
    box.addEventListener('change', function () {
      btn.textContent = box.checked ? rushLabel : std;
    });
  })();
  </script>
  <% } %>
  <p><label><input type="checkbox" name="use_credit" value="1"> <%= t('customs.pay_credit_deposit') %></label></p>
  <% const _cfx = fxNote(depositTotal); if (_cfx) { %><p class="muted fineprint"><%= _cfx %></p><% } %>
  <p><button class="btn" id="custom-submit-btn" type="submit"><%= t('customs.pay_deposit', {deposit: fmtMoney(depositTotal)}) %></button></p>
  <% if (typeof paypalClientId !== 'undefined' && paypalClientId && typeof depositTotal !== 'undefined' && depositTotal >= 3000) { %><div data-pp-message data-pp-amount="<%= (depositTotal/100).toFixed(2) %>"></div><% } %>
</form>
<p class="muted"><%= t('customs.final_note') %></p>
