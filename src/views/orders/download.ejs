<h1><%= t('orders.download_title') %></h1>
<% if (lineworkOnly) { %>
<p class="muted"><%= t('orders.linework_only_note') %></p>
<ul>
  <li><a class="btn" href="/orders/download/<%= token %>?file=linework"><%= t('orders.dl_linework') %></a></li>
</ul>
<% } else { %>
<p class="muted"><%= t('orders.both_note') %></p>
<ul>
  <li><a class="btn" href="/orders/download/<%= token %>?file=color"><%= t('orders.dl_color') %></a></li>
  <li><a class="btn btn-secondary" href="/orders/download/<%= token %>?file=linework"><%= t('orders.dl_linework') %></a></li>
</ul>
<% } %>
<p class="muted"><%= t('orders.dont_share') %></p>
