<h1><%= t('orders.download_title') %></h1>
<% if (typeof zipFile !== 'undefined' && zipFile) { %>
<p class="muted"><%= t('orders.zip_note', {label: zipLabel || ''}) %></p>
<ul>
  <li><a class="btn" href="/orders/download/<%= token %>"><%= t('orders.dl_zip') %></a></li>
</ul>
<% } else if (lineworkOnly) { %>
<p class="muted"><%= t('orders.linework_only_note') %></p>
<ul>
  <li><a class="btn" href="/orders/download/<%= token %>?file=linework"><%= t('orders.dl_linework') %></a></li>
</ul>
<% } else { %>
<p class="muted"><%= t('orders.both_note') %></p>
<ul>
  <li><a class="btn" href="/orders/download/<%= token %>?file=color"><%= t('orders.dl_color') %></a></li>
  <li><a class="btn btn-secondary" href="/orders/download/<%= token %>?file=linework"><%= t('orders.dl_linework') %></a></li>
</ul>
<% } %>
<p class="muted"><%= t('orders.dont_share') %></p>

<div class="aftercare-promo" style="margin-top:2rem;padding:1.25rem;border:1px solid #e0d5c1;border-radius:12px;background:#fdf8ef;">
  <h3 style="margin-top:0;"><%= t('orders.aftercare_title') %></h3>
  <p><%= t('orders.aftercare_text') %></p>
  <a class="btn" href="https://baselabs.is/?coupon=TAC20" target="_blank" rel="noopener nofollow sponsored"><%= t('orders.aftercare_cta') %></a>
  <p class="muted" style="font-size:0.85rem;margin-bottom:0;"><%= t('orders.aftercare_note') %></p>
</div>
