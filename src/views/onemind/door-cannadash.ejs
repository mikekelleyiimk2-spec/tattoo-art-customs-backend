<style>
  body { background:#000; }
  .cddoor { color:#f4f7f1; background:#000; }
  .cddoor .wrap { max-width:1060px; margin:0 auto; padding:0 20px; }
  /* Hero: the approved ring mark big on black, neon halo behind it —
     the Grok candidate's composition, the house's own art. */
  .cddoor .hero { text-align:center; padding:44px 20px 6px; position:relative; }
  .cddoor .halo { position:absolute; left:50%; top:38px; transform:translateX(-50%);
    width:min(460px,88vw); height:min(460px,88vw); border-radius:50%;
    background:radial-gradient(circle, rgba(88,214,30,.38) 0%, rgba(88,214,30,.12) 46%, rgba(88,214,30,0) 70%);
    pointer-events:none; }
  .cddoor .mark { position:relative; width:min(400px,80vw); height:auto; display:inline-block;
    filter:drop-shadow(0 0 26px rgba(88,214,30,.45)); }
  .cddoor h1 { position:relative; font-size:52px; line-height:1.05; margin:22px 0 26px; font-weight:800; letter-spacing:-.5px; }
  /* Area check: one pill, one action. */
  .cddoor .check { position:relative; max-width:720px; margin:0 auto; }
  .cddoor .pill { display:flex; align-items:center; gap:12px; background:#0d120c;
    border:1px solid #2c3d22; border-radius:16px; padding:10px 10px 10px 18px;
    box-shadow:0 0 0 1px rgba(88,214,30,.08), 0 14px 40px rgba(0,0,0,.6); }
  .cddoor .pill svg { flex:0 0 auto; }
  .cddoor .pill input { flex:1 1 auto; min-width:0; background:transparent; border:0; outline:0;
    color:#f4f7f1; font-size:18px; padding:12px 0; }
  .cddoor .pill input::placeholder { color:#8fa184; }
  .cddoor .pill button { flex:0 0 auto; background:#58d61e; color:#0a1206; border:0; cursor:pointer;
    font-size:18px; font-weight:800; padding:14px 34px; border-radius:11px; }
  .cddoor .pill button:hover { background:#6ee63a; }
  .cddoor .hp { position:absolute; left:-9999px; width:1px; height:1px; opacity:0; }
  .cddoor .answer { max-width:720px; margin:16px auto 0; text-align:left; background:#0d1a0a;
    border:1px solid #33511f; border-radius:14px; padding:16px 20px; font-size:16px; line-height:1.55; }
  .cddoor .answer strong { color:#8df35a; }
  /* Quiet trust line. */
  .cddoor .trust { display:flex; align-items:center; justify-content:center; gap:10px;
    margin:22px 0 34px; color:#c7d2bd; font-size:16px; }
  /* The three doors. */
  .cddoor .doors { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
  .cddoor a.door { display:block; text-decoration:none; color:#f4f7f1; border:1px solid #26331f;
    border-radius:16px; overflow:hidden; background:#0a0f08; transition:transform .18s ease, border-color .18s ease; }
  .cddoor a.door:hover { transform:translateY(-3px); border-color:#58d61e; }
  .cddoor .scene { height:300px; display:flex; align-items:center; justify-content:center; position:relative; }
  .cddoor .scene.order { background:linear-gradient(165deg, #274d16 0%, #12240a 58%, #060b04 100%); }
  .cddoor .scene.drive { background:linear-gradient(165deg, #173a2e 0%, #0d2018 55%, #050a08 100%); }
  .cddoor .scene.partner { background:linear-gradient(165deg, #3a2c10 0%, #1d1a0c 55%, #070604 100%); }
  .cddoor .scene::after { content:''; position:absolute; inset:auto 0 0 0; height:110px;
    background:linear-gradient(to top, rgba(0,0,0,.88), rgba(0,0,0,0)); }
  .cddoor .door-meta { position:relative; z-index:1; margin-top:-64px; padding:0 18px 20px; text-align:center; }
  .cddoor .door-meta h2 { font-size:27px; margin:0 0 5px; font-weight:800; letter-spacing:1px; }
  .cddoor .door-meta p { margin:0; color:#8df35a; font-size:16px; font-weight:600; }
  /* Founding partners offer (Bundle C Build 1, 2026-10-28). */
  .cddoor .founding { margin:34px auto 0; background:#0a0f08; border:1px solid #33511f;
    border-radius:16px; padding:24px 26px; display:flex; align-items:center;
    justify-content:space-between; gap:1.2rem; flex-wrap:wrap; }
  .cddoor .founding h2 { font-size:24px; margin:0 0 6px; font-weight:800; }
  .cddoor .founding p { margin:0; color:#c7d2bd; font-size:15.5px; line-height:1.55; max-width:640px; }
  .cddoor .founding p strong { color:#8df35a; }
  .cddoor .founding a.cta { flex:0 0 auto; background:#58d61e; color:#0a1206; text-decoration:none;
    font-size:16px; font-weight:800; padding:13px 26px; border-radius:11px; }
  .cddoor .founding a.cta:hover { background:#6ee63a; }
  /* Founding-list intake. */
  .cddoor .join { max-width:720px; margin:46px auto 0; background:#0a0f08;
    border:1px solid #26331f; border-radius:16px; padding:26px 26px 28px; }
  .cddoor .join h2 { font-size:26px; margin:0 0 8px; font-weight:800; }
  .cddoor .join .honest { color:#c7d2bd; font-size:15.5px; line-height:1.55; margin:0 0 18px; }
  .cddoor .tabs { display:flex; gap:8px; margin:0 0 20px; flex-wrap:wrap; }
  .cddoor .tabs a { color:#c7d2bd; text-decoration:none; border:1px solid #2c3d22; border-radius:999px;
    padding:8px 18px; font-size:15px; font-weight:700; }
  .cddoor .tabs a.on { background:#58d61e; color:#0a1206; border-color:#58d61e; }
  .cddoor .join label { display:block; font-size:13px; font-weight:700; letter-spacing:.06em;
    text-transform:uppercase; color:#8fa184; margin:14px 0 6px; }
  .cddoor .join input[type=text], .cddoor .join input[type=email] { width:100%; box-sizing:border-box;
    background:#0d120c; border:1px solid #2c3d22; border-radius:10px; color:#f4f7f1;
    font-size:17px; padding:13px 14px; outline:0; }
  .cddoor .join input:focus { border-color:#58d61e; }
  .cddoor .age { display:flex; gap:10px; align-items:flex-start; margin:18px 0 4px;
    font-size:15px; color:#c7d2bd; line-height:1.45; }
  .cddoor .age input { margin-top:3px; width:18px; height:18px; accent-color:#58d61e; }
  .cddoor .join button { margin-top:18px; width:100%; background:#58d61e; color:#0a1206; border:0;
    cursor:pointer; font-size:18px; font-weight:800; padding:15px; border-radius:11px; }
  .cddoor .join button:hover { background:#6ee63a; }
  .cddoor .ok { background:#0d1a0a; border:1px solid #33511f; border-radius:12px;
    padding:16px 18px; font-size:16px; line-height:1.55; margin:0 0 18px; }
  .cddoor .ok strong { color:#8df35a; }
  .cddoor .ok .driver-dl { display:block; text-align:center; background:#58d61e; color:#0a1206;
    text-decoration:none; font-size:18px; font-weight:800; padding:15px; border-radius:11px; margin:14px 0 10px; }
  .cddoor .ok .driver-dl:hover { background:#6ee63a; }
  .cddoor .ok .driver-note { margin:8px 0 0; }
  .cddoor .err { background:#1d0f0a; border:1px solid #5a2c17; border-radius:12px;
    padding:13px 16px; font-size:15.5px; margin:0 0 16px; color:#ffb59d; }
  /* Penny-sweeper stack (shared partials, door-native dress — same
     pattern as the other standalone doors). */
  .cddoor .sweep { max-width:1060px; margin:46px auto 10px; padding:0 20px; }
  .cddoor .sweep .fineprint { font-size:12px; letter-spacing:1px; text-transform:uppercase; color:#8fa184; margin:.2rem 0; }
  .cddoor .sweep a { color:#f4f7f1; }
  .cddoor .sweep .house-ad { text-align:left; border:1px solid #26331f; border-radius:12px; background:#0a0f08; padding:.9rem 1.1rem 1rem; margin:1.5rem 0; }
  .cddoor .house-ad-label { display:inline-block; font-size:11px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:#8fa184; border:1px solid #26331f; border-radius:999px; padding:2px 10px; margin-bottom:8px; }
  .cddoor .house-ad-body { display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; }
  .cddoor .house-ad-text { display:flex; flex-direction:column; gap:3px; min-width:0; }
  .cddoor .house-ad-headline { font-size:17px; }
  .cddoor .house-ad-pitch { color:#c7d2bd; font-size:14px; }
  .cddoor .house-ad-disclosure { font-size:12px; color:#8fa184; }
  .cddoor .sweep a.house-ad-cta { background:#58d61e; color:#0a1206; text-decoration:none; font-weight:700; padding:10px 22px; border-radius:999px; white-space:nowrap; }
  .cddoor .sweep .ad-slot { border-color:#2c3d22 !important; }
  .cddoor .sweep-jar { color:#17324a; border-radius:12px; overflow:hidden; }
  .cddoor .sweep-jar a.btn { display:inline-block; background:#17324a; color:#fff; text-decoration:none; font-weight:700; padding:12px 30px; border-radius:999px; }
  .cddoor .foot { text-align:center; color:#77876c; font-size:13.5px; line-height:1.6;
    max-width:720px; margin:26px auto 60px; padding:0 20px; }
  @media (max-width:760px){
    .cddoor h1{ font-size:38px; }
    .cddoor .doors{ grid-template-columns:1fr; }
    .cddoor .scene{ height:210px; }
    .cddoor .pill input{ font-size:16px; }
    .cddoor .pill button{ padding:13px 22px; }
  }
</style>
<main class="cddoor">
  <div class="hero">
    <div class="halo" aria-hidden="true"></div>
    <img class="mark" src="/img/logos/cannadash-logo.jpg" alt="CannaDash — legal cannabis delivery" width="800" height="800">
    <h1>Legal cannabis. Delivered.</h1>
    <div class="check" id="check">
      <% if (checkedArea) { %>
      <div class="answer" role="status">
        <strong>Not in <%= checkedArea %> yet.</strong>
        CannaDash is not live in any market yet — no area is open today. Join the founding
        list below and we will email you the day your area opens. That is the whole promise:
        a launch notice, nothing more.
      </div>
      <% } %>
      <form class="pill" method="post" action="/cannadash/check">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s-7-5.6-7-11a7 7 0 1 1 14 0c0 5.4-7 11-7 11z" fill="#58d61e"/><circle cx="12" cy="10" r="2.8" fill="#0a1206"/></svg>
        <input type="text" name="area" maxlength="80" autocomplete="address-level2"
          placeholder="Enter your area to check availability" aria-label="Enter your area to check availability">
        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <button type="submit">Check</button>
      </form>
    </div>
    <p class="trust">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2l8 3v6c0 5-3.4 9.3-8 11-4.6-1.7-8-6-8-11V5l8-3z" stroke="#58d61e" stroke-width="1.7"/><text x="12" y="14.5" text-anchor="middle" font-size="6.4" font-weight="800" fill="#58d61e">21+</text></svg>
      <span>Licensed dispensaries only</span>
    </p>
  </div>

  <div class="wrap">
    <div class="doors">
      <a class="door" href="/cannadash?join=order#join">
        <div class="scene order" aria-hidden="true">
          <svg width="120" height="120" viewBox="0 0 24 24" fill="none"><path d="M3 11.5L12 4l9 7.5" stroke="#b9ff8f" stroke-width="1.6" stroke-linecap="round"/><path d="M5.5 10.5V20h13v-9.5" stroke="#b9ff8f" stroke-width="1.6" stroke-linejoin="round"/><path d="M9.2 15.2l2.8-1.2 2.8 1.2v3.3l-2.8 1.2-2.8-1.2v-3.3z" fill="#58d61e"/><path d="M9.2 15.2L12 16.4l2.8-1.2M12 16.4v3.3" stroke="#0a1206" stroke-width="1.1"/></svg>
        </div>
        <div class="door-meta"><h2>ORDER</h2><p>From licensed shops.</p></div>
      </a>
      <a class="door" href="/cannadash?join=drive#join">
        <div class="scene drive" aria-hidden="true">
          <svg width="130" height="120" viewBox="0 0 24 24" fill="none"><path d="M3 15.5l1.6-5.2A2 2 0 0 1 6.5 8.8h6.9a2 2 0 0 1 1.7 1l2.5 3.4a2 2 0 0 1 .3 1.2v1.1" stroke="#b9ff8f" stroke-width="1.6" stroke-linejoin="round"/><path d="M3 15.5h15.5M6 18.2a1.9 1.9 0 1 0 0-.01M15.4 18.2a1.9 1.9 0 1 0 0-.01M7.9 18.2h5.6" stroke="#b9ff8f" stroke-width="1.6"/><path d="M12.2 5.2c.5-1.2 1.7-1.9 2.9-1.7.3 1.2-.4 2.4-1.5 2.8.9-.1 1.9.3 2.4 1.1-.7.9-2 1.2-3 .7.7.6.9 1.6.6 2.5-1.1-.3-1.9-1.2-2-2.3-.7.6-1.7.8-2.6.4.3-1.1 1.2-1.9 2.3-2-.8-.4-1.3-1.2-1.3-2.1 1-.2 2 .2 2.6.9.1-.9.7-1.7 1.6-2.1z" fill="#58d61e"/></svg>
        </div>
        <div class="door-meta"><h2>DRIVE</h2><p>Earn on your schedule</p></div>
      </a>
      <a class="door" href="/cannadash?join=partner#join">
        <div class="scene partner" aria-hidden="true">
          <svg width="120" height="120" viewBox="0 0 24 24" fill="none"><path d="M4 9.5l1.2-4h13.6l1.2 4a2.6 2.6 0 0 1-5 .6 2.6 2.6 0 0 1-5.2 0A2.6 2.6 0 0 1 4 9.5z" stroke="#ffe9a8" stroke-width="1.6" stroke-linejoin="round"/><path d="M5.5 12v7.5h13V12M9.5 19.5v-4.5h5v4.5" stroke="#ffe9a8" stroke-width="1.6" stroke-linejoin="round"/><path d="M12 5.9c.3-.7 1-1.1 1.7-1 .2.7-.2 1.4-.9 1.6.5-.1 1.1.2 1.4.6-.4.5-1.1.7-1.7.4.4.3.5.9.3 1.4-.6-.2-1.1-.7-1.1-1.3-.4.3-1 .4-1.5.2.2-.6.7-1.1 1.3-1.1-.4-.2-.7-.7-.7-1.2.6-.1 1.1.1 1.5.5 0-.5.4-1 1-1.2z" fill="#58d61e" transform="translate(0,-1.4)"/></svg>
        </div>
        <div class="door-meta"><h2>PARTNER</h2><p>Reach more patients</p></div>
      </a>
    </div>

    <section class="founding" aria-labelledby="cd-founding">
      <div>
        <h2 id="cd-founding">Founding partners</h2>
        <p>Licensed dispensaries: join the first cohort and your <strong>founding rate is
          locked at joining</strong> — the structure, the lock, and how to apply are on the
          founding partner page. The full rate sheet goes to founding partners first.</p>
      </div>
      <a class="cta" href="/cannadash/founding">Founding partners</a>
    </section>

    <section class="join" id="join">
      <% const roleMeta = {
        order:   { tab: 'Order',   head: 'Order — the founding customer list', area: 'Your city & state', detail: 'Anything we should know? (optional)', btn: 'Join the founding list' },
        drive:   { tab: 'Drive',   head: 'Drive — the founding driver list', area: 'City & state you want to drive in', detail: 'Your vehicle (year, make, model)', btn: 'Join the founding list' },
        partner: { tab: 'Partner', head: 'Partner — the founding dispensary list', area: 'Dispensary city & state', detail: 'Dispensary / business name', btn: 'Join the founding list' },
      }; const meta = roleMeta[joinRole]; %>
      <% if (joined) { %>
      <div class="ok" role="status">
        <strong>You are on the list.</strong>
        <% if (joinedAgain) { %>That email was already on the <%= joined %> founding list — we refreshed your details.<% } else { %>You joined the <%= joined %> founding list.<% } %>
        CannaDash is not live in any market yet, so there is nothing to pay and nothing to
        order today — joining means one thing: we email you the day your market opens.
        <% if (joined === 'drive') { %>
        <% if (typeof driverApkUrl !== 'undefined' && driverApkUrl) { %>
        <a class="driver-dl" href="<%= driverApkUrl %>">Install the driver app now</a>
        <p class="driver-note">Development build (v1.0.2) — Android will ask you to allow installs from your browser; that's expected for a pre-release build.</p>
        <% } %>
        <p class="driver-note">Prefer Google Play? The Play invite goes to the email you just signed up with — we add founding-driver Gmails to the CannaDash Driver tester list in batches, so watch that inbox.</p>
        <% } %>
      </div>
      <% } %>
      <h2><%= meta.head %></h2>
      <p class="honest">CannaDash is being built to plug licensed dispensaries into delivery —
        ordering, driving and partnering open market by market, only where legal, only after
        counsel clears it and a licensed partner signs. Until then this list is the front door:
        no payment is taken, ever, on this page.</p>
      <div class="tabs" role="navigation" aria-label="Choose your list">
        <% for (const r of ['order','drive','partner']) { %>
        <a href="/cannadash?join=<%= r %>#join" class="<%= joinRole === r ? 'on' : '' %>"><%= roleMeta[r].tab %></a>
        <% } %>
      </div>
      <% if (joinError) { %>
      <p class="err" role="alert"><%= joinError === 'email' ? 'That email does not look right — check it and try again.' : joinError === 'name' ? 'We need a name for the list — add yours and try again.' : joinError === 'driver' ? 'Drivers need all three boxes checked — license, insured vehicle, and work authorization.' : 'Please confirm you are 21 or older to join the list.' %></p>
      <% } %>
      <form method="post" action="/cannadash/join">
        <input type="hidden" name="role" value="<%= joinRole %>">
        <label for="cd-name">Your name</label>
        <input type="text" id="cd-name" name="name" maxlength="80" autocomplete="name" required>
        <label for="cd-email">Email</label>
        <input type="email" id="cd-email" name="email" maxlength="120" autocomplete="email" required>
        <label for="cd-area"><%= meta.area %></label>
        <input type="text" id="cd-area" name="area" maxlength="120" autocomplete="address-level2">
        <label for="cd-detail"><%= meta.detail %></label>
        <input type="text" id="cd-detail" name="detail" maxlength="200">
        <div class="age">
          <input type="checkbox" id="cd-age" name="age_ok" value="1" required>
          <label for="cd-age" style="display:inline;font-size:15px;font-weight:400;letter-spacing:0;text-transform:none;color:#c7d2bd;margin:0;">I confirm I am 21 or older.</label>
        </div>
        <% if (joinRole === 'drive') { %>
        <div class="age">
          <input type="checkbox" id="cd-driver" name="driver_ok" value="1" required>
          <label for="cd-driver" style="display:inline;font-size:15px;font-weight:400;letter-spacing:0;text-transform:none;color:#c7d2bd;margin:0;">I hold a valid driver's license, my vehicle is insured, and I am authorized to work in the United States.</label>
        </div>
        <% } %>
        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <button type="submit"><%= meta.btn %></button>
      </form>
    </section>
  </div>

  <div class="sweep">
    <%- include('../partials/house-ad', {slot: 'door_cannadash'}) %>
    <%- include('../partials/sponsor-slot') %>
    <div class="sweep-jar"><%- include('../partials/tip-jar') %></div>
  </div>

  <p class="foot">CannaDash is a delivery platform for licensed cannabis retailers — the retailer is
    always the seller of record. Adults 21+ only. Not live in any market yet; joining the
    founding list promises a launch notice and nothing more.</p>
</main>
