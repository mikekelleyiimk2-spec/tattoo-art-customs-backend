        <a href="#omt-debate">Debate</a>
        <a href="#omt-search-panel">Research</a>
        <a href="#omt-learn">Learn</a>
        <a href="#omt-search-panel">Sources</a>
      </nav>
      <button type="button" class="omt-share" id="omt-share">Share</button>
    </div>

    <section class="omt-stage" id="omt-answers" aria-label="Answers from your AIs">
      <% if (user) { %>
      <div class="omt-empty">
        <strong>Answers from your AIs land here</strong>
        <span>Ask the table below and each AI&rsquo;s answer appears side by side — compare them here instead of copy-pasting between apps.</span>
      </div>
      <% } else { %>
      <div class="omt-signin" id="omt-signin">
        <h2>Sign in</h2>
        <% if (typeof googleSignin !== 'undefined' && googleSignin) { %>
        <a class="omt-google-btn" href="/auth/google">Continue with Google</a>
        <% } %>
        <form method="post" action="/login" class="omt-signin-form">
          <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <label for="omt-email">Email</label>
          <input type="email" id="omt-email" name="email" required autocomplete="email">
          <label for="omt-password">Password</label>
          <input type="password" id="omt-password" name="password" required autocomplete="current-password">
          <button class="omt-send" type="submit">Sign in</button>
        </form>
        <p class="omt-signin-links"><a href="/forgot">Forgot your password?</a> · <a href="/signup">Create your account</a></p>
        <div class="omt-signin-or">
          <form id="omt-link-form" class="omt-signin-form">
            <label for="omt-link-email">Email for your one-tap link</label>
            <input type="email" id="omt-link-email" required autocomplete="email">
            <button class="omt-share" type="submit">Email me my sign-in link</button>
          </form>
          <p id="omt-link-msg" class="omt-signin-note" hidden></p>
          <noscript><p class="omt-signin-note">The one-tap email door needs JavaScript — the password form above works without it.</p></noscript>
        </div>
      </div>
      <% } %>
    </section>

    <section class="omt-panels">
      <div class="omt-panel" id="omt-search-panel">
        <h2>🔍 Live Web Search <span class="omt-live">Live</span></h2>
        <p>Search from the bar at the top — results open on the web in front of you, sources first, ready to bring into the session.</p>
      </div>
      <div class="omt-panel" id="omt-debate">
        <h2>⚖ AI Debate</h2>
        <p>No debate yet. When your AIs disagree, the argument plays out here — point by point, where you can judge it.</p>
      </div>
      <div class="omt-panel" id="omt-learn">
        <h2>📖 Learning Resources</h2>
        <p>Nothing saved yet. Lessons and guides the table builds out of your sessions will collect here.</p>
      </div>
    </section>

    <form class="omt-composer" id="omt-composer" data-omt-form autocomplete="off">
      <span class="omt-composer-dot" aria-hidden="true"></span>
      <input type="text" placeholder="Ask a question, give a prompt, or tell the AI what to explore…" aria-label="Ask a question, give a prompt, or tell the AI what to explore">
      <button type="submit" class="omt-send">➤ Send</button>
    </form>
  </main>

  <aside class="omt-people">
    <div class="omt-people-head">
      <h2>AI Participants</h2>
      <span><%= bars.length %> AI<% if (user) { %> + you<% } %></span>
    </div>
    <ul class="omt-people-list">
      <% bars.forEach(function (b) { %>
      <li>
        <% if (b.url) { %><a class="omt-person" href="<%= b.url %>"><% } else { %><span class="omt-person"><% } %>
          <span class="omt-avatar"><% if (b.favicon) { %><img alt="" src="https://www.google.com/s2/favicons?domain=<%= b.favicon %>&sz=128"><% } else { %>M<% } %></span>
          <span class="omt-person-meta"><strong><%= b.name %></strong><small><%= b.chip %></small></span>
          <span class="omt-dot<%= b.configured ? ' is-on' : '' %>"></span>
        <% if (b.url) { %></a><% } else { %></span><% } %>
      </li>
      <% }); %>
      <li class="omt-person-you-row">
        <% if (user) { %>
        <span class="omt-person">
          <span class="omt-avatar omt-avatar-you"><%= (user.name || 'Y').trim().charAt(0).toUpperCase() %></span>
          <span class="omt-person-meta"><strong><%= user.name %></strong><small>You — seated at the table</small></span>
          <span class="omt-dot is-on"></span>
        </span>
        <% } else { %>
        <a class="omt-person" href="#omt-signin">
          <span class="omt-avatar omt-avatar-you">?</span>
          <span class="omt-person-meta"><strong>You</strong><small>Not signed in — take your seat</small></span>
          <span class="omt-dot"></span>
        </a>
        <% } %>
      </li>
    </ul>
    <% if (typeof lesser !== 'undefined' && lesser.length) { %>
    <div class="omt-side-label">Lesser Table</div>
    <p class="omt-lesser-note">The understudies — secondary seats under their own names, a bench of their own outside the main roster.</p>
    <ul class="omt-people-list">
      <% lesser.forEach(function (b) { %>
      <li>
        <% if (b.url) { %><a class="omt-person" href="<%= b.url %>"><% } else { %><span class="omt-person"><% } %>
          <span class="omt-avatar"><% if (b.favicon) { %><img alt="" src="https://www.google.com/s2/favicons?domain=<%= b.favicon %>&sz=128"><% } else { %><%= b.name.charAt(0) %><% } %></span>
          <span class="omt-person-meta"><strong><%= b.name %></strong><small><%= b.chip %></small></span>
          <span class="omt-dot<%= b.configured ? ' is-on' : '' %>"></span>
        <% if (b.url) { %></a><% } else { %></span><% } %>
      </li>
      <% }); %>
    </ul>
    <% } %>
    <div class="omt-side-label">Quick Tools</div>
    <div class="omt-actions">
      <a href="#omt-omnibox"><span class="omt-ic">🔍</span>Search Any Topic</a>
      <a href="#omt-answers"><span class="omt-ic">⚖</span>Compare AI Responses</a>
      <a href="#omt-composer"><span class="omt-ic">✦</span>Ask the Table</a>
    </div>
    <p class="omt-people-foot">More perspectives.<br>Deeper understanding.</p>
  </aside>
</div>
<script>
  // The table's one input behavior — unchanged from the browser face
  // this rebuild replaces: a URL goes to the URL, anything else is a
  // Google search. Both inputs (the browser bar and the composer)
  // run it, exactly as the old face's single bar did.
  document.querySelectorAll('form[data-omt-form]').forEach(function (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var input = form.querySelector('input');
      var q = (input.value || '').trim();
      if (!q) return;
      if (/^https?:\/\//i.test(q)) { window.location.href = q; return; }
      if (!/\s/.test(q) && /\.[a-z]{2,}$/i.test(q)) { window.location.href = 'https://' + q; return; }
      window.location.href = 'https://www.google.com/search?q=' + encodeURIComponent(q);
    });
  });
  var shareBtn = document.getElementById('omt-share');
  if (shareBtn) {
    shareBtn.addEventListener('click', function () {
      var data = { title: 'Chorvix — the Table', url: window.location.href };
      if (navigator.share) { navigator.share(data).catch(function () {}); return; }
      if (navigator.clipboard) {
        navigator.clipboard.writeText(window.location.href).then(function () {
          shareBtn.textContent = 'Link copied';
          setTimeout(function () { shareBtn.textContent = 'Share'; }, 1800);
        }).catch(function () {});
      }
    });
  }
</script>
<script>
  // The one-tap email door in the guest sign-in card — the same pipe
  // (and the same answers) the hub's form used: POST
  // /api/onemind/link/start with {email, surface:'website'}.
  (function () {
    var form = document.getElementById('omt-link-form');
    if (!form) return;
    var msg = document.getElementById('omt-link-msg');
    form.addEventListener('submit', function (ev) {
      ev.preventDefault();
      var email = document.getElementById('omt-link-email').value;
      msg.hidden = false;
      msg.textContent = 'Sending your link…';
      fetch('/api/onemind/link/start', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email, surface: 'website' })
      }).then(function (r) { return r.json(); }).then(function (j) {
        msg.textContent = j && j.ok
          ? 'Your sign-in link is on its way to ' + email + ' — tap it within the hour and you\'re seated.'
          : 'That email didn\'t take — check it and try again, or use the password form above.';
      }).catch(function () {
        msg.textContent = 'The link door didn\'t answer — the password form above will get you in.';
      });
    });
  })();
</script>
