<style>
  .om-ntp { min-height: 100vh; display: flex; flex-direction: column; align-items: center; padding: 14vh 1rem 2rem; }
  .om-wordmark { font-size: 4.2rem; font-weight: 500; letter-spacing: -.02em; margin: 0 0 2rem; color: #202124; user-select: none; }
  @media (prefers-color-scheme: dark) { .om-wordmark { color: #e8eaed; } }
  .om-search { display: flex; align-items: center; gap: .6rem; width: 100%; max-width: 560px; background: #fff; border: 1px solid transparent; border-radius: 999px; box-shadow: 0 1px 6px rgba(32,33,36,.28); padding: .8rem 1.1rem; }
  @media (prefers-color-scheme: dark) { .om-search { background: #303134; box-shadow: none; } }
  .om-search svg { flex: 0 0 auto; fill: #5f6368; }
  @media (prefers-color-scheme: dark) { .om-search svg { fill: #9aa0a6; } }
  .om-search input { flex: 1 1 auto; border: 0; outline: 0; background: transparent; font-size: 1rem; color: inherit; min-width: 0; }
  .om-tiles { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem .25rem; max-width: 640px; margin-top: 2.2rem; }
  .om-tile { display: flex; flex-direction: column; align-items: center; gap: .45rem; width: 96px; padding: .8rem 0 .6rem; border-radius: 12px; text-decoration: none; color: #202124; }
  @media (prefers-color-scheme: dark) { .om-tile { color: #e8eaed; } }
  .om-tile:hover { background: rgba(32,33,36,.06); }
  @media (prefers-color-scheme: dark) { .om-tile:hover { background: rgba(232,234,237,.08); } }
  .om-tile .om-ic { width: 48px; height: 48px; border-radius: 50%; background: #f1f3f4; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  @media (prefers-color-scheme: dark) { .om-tile .om-ic { background: #303134; } }
  .om-tile .om-ic img { width: 24px; height: 24px; }
  .om-tile .om-ic span { font-size: 1.15rem; font-weight: 500; color: #fff; }
  .om-tile .om-lb { font-size: .78rem; text-align: center; line-height: 1.15; max-width: 88px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>
<div class="om-ntp">
  <h1 class="om-wordmark">OneMind</h1>
  <form class="om-search" id="om-search" role="search" autocomplete="off">
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 4.99L20.49 19zm-6 0A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14"/></svg>
    <input id="om-q" type="text" placeholder="Search Google or type URL" aria-label="Search Google or type URL">
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15a3 3 0 0 0 3-3V6a3 3 0 1 0-6 0v6a3 3 0 0 0 3 3zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-2.08A7 7 0 0 0 19 12z"/></svg>
  </form>
  <nav class="om-tiles" aria-label="Shortcuts">
    <a class="om-tile" href="https://chatgpt.com"><span class="om-ic"><img alt="" src="https://www.google.com/s2/favicons?domain=chatgpt.com&sz=128"></span><span class="om-lb">ChatGPT</span></a>
    <a class="om-tile" href="https://claude.ai"><span class="om-ic"><img alt="" src="https://www.google.com/s2/favicons?domain=claude.ai&sz=128"></span><span class="om-lb">Claude</span></a>
    <a class="om-tile" href="https://gemini.google.com"><span class="om-ic"><img alt="" src="https://www.google.com/s2/favicons?domain=gemini.google.com&sz=128"></span><span class="om-lb">Gemini</span></a>
    <a class="om-tile" href="https://grok.com"><span class="om-ic"><img alt="" src="https://www.google.com/s2/favicons?domain=grok.com&sz=128"></span><span class="om-lb">Grok</span></a>
    <a class="om-tile" href="https://www.perplexity.ai"><span class="om-ic"><img alt="" src="https://www.google.com/s2/favicons?domain=perplexity.ai&sz=128"></span><span class="om-lb">Perplexity</span></a>
    <a class="om-tile" href="https://copilot.microsoft.com"><span class="om-ic"><img alt="" src="https://www.google.com/s2/favicons?domain=copilot.microsoft.com&sz=128"></span><span class="om-lb">Copilot</span></a>
    <a class="om-tile" href="https://chat.deepseek.com"><span class="om-ic"><img alt="" src="https://www.google.com/s2/favicons?domain=deepseek.com&sz=128"></span><span class="om-lb">DeepSeek</span></a>
    <a class="om-tile" href="/"><span class="om-ic" style="background:#7a1f1f;"><span>T</span></span><span class="om-lb">Tattoo Art Customs</span></a>
    <a class="om-tile" href="/onemind"><span class="om-ic" style="background:#14532d;"><span>O</span></span><span class="om-lb">OneMind</span></a>
    <a class="om-tile" href="/onemind/tester-hub"><span class="om-ic" style="background:#1d4ed8;"><span>H</span></span><span class="om-lb">Tester Hub</span></a>
    <a class="om-tile" href="/onemind/tools"><span class="om-ic" style="background:#6d28d9;"><span>T</span></span><span class="om-lb">The Tools</span></a>
    <a class="om-tile" href="/onemind/poppy-and-ziggy"><span class="om-ic" style="background:#db2777;"><span>P</span></span><span class="om-lb">Poppy &amp; Ziggy</span></a>
    <a class="om-tile" href="/onemind/little-inkers"><span class="om-ic" style="background:#ea580c;"><span>L</span></span><span class="om-lb">Little Inkers</span></a>
    <a class="om-tile" href="/onemind/killintime"><span class="om-ic" style="background:#111827;"><span>K</span></span><span class="om-lb">KillinTime</span></a>
  </nav>
</div>
<script>
  document.getElementById('om-search').addEventListener('submit', function (e) {
    e.preventDefault();
    var q = document.getElementById('om-q').value.trim();
    if (!q) return;
    if (/^https?:\/\//i.test(q)) { window.location.href = q; return; }
    if (!/\s/.test(q) && /\.[a-z]{2,}$/i.test(q)) { window.location.href = 'https://' + q; return; }
    window.location.href = 'https://www.google.com/search?q=' + encodeURIComponent(q);
  });
</script>
