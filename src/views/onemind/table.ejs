<style>
  /* Chorvix table face — dark browser-grammar workspace, rebuilt
     2026-10-27 to the owner's GPT-built reference (Eye corpus:
     REF-2026-10-27-gpt-onemind-landing-owner-built-first-try).
     Palette (N-W3): deep navy ground, electric blue, cyan glow —
     one hue family plus neutrals. Everything on the face is a door
     or a real state from the Codex; panels with no live data yet
     render their honest empty state in the same language. */
  body { background: #060b16; }
  .omt { min-height: 100vh; display: grid; grid-template-columns: 236px minmax(0, 1fr) 288px; background: #060b16; color: #e7eef8; font-family: "Segoe UI", Arial, Roboto, sans-serif; }
  .omt a { color: inherit; }
  .omt ::selection { background: rgba(53, 196, 255, .35); }

  /* --- rails, shared furniture --- */
  .omt-rail, .omt-people { background: #081120; border-right: 1px solid #16263f; padding: 1.1rem .9rem 1.4rem; display: flex; flex-direction: column; gap: .35rem; }
  .omt-people { border-right: 0; border-left: 1px solid #16263f; }
  .omt-brand { display: flex; align-items: center; gap: .6rem; text-decoration: none; padding: .2rem .4rem 1rem; }
  .omt-brand svg { flex: 0 0 auto; filter: drop-shadow(0 0 6px rgba(53, 196, 255, .55)); }
  .omt-brand strong { display: block; font-size: 1.28rem; letter-spacing: .01em; line-height: 1.05; }
  .omt-brand small { display: block; color: #7f95b5; font-size: .72rem; margin-top: .15rem; }
  .omt-nav { display: flex; flex-direction: column; gap: .15rem; }
  .omt-nav a, .omt-actions a { display: flex; align-items: center; gap: .55rem; padding: .5rem .6rem; border-radius: 9px; text-decoration: none; font-size: .92rem; color: #c6d4e8; }
  .omt-nav a:hover, .omt-actions a:hover { background: rgba(47, 123, 255, .14); color: #fff; }
  .omt-nav a.is-active { background: linear-gradient(90deg, rgba(47, 123, 255, .35), rgba(47, 123, 255, .12)); color: #fff; box-shadow: inset 2px 0 0 #35c4ff; }
  .omt-nav .omt-ic, .omt-actions .omt-ic { width: 1.05rem; text-align: center; flex: 0 0 auto; opacity: .85; }
  .omt-side-label { margin: 1.05rem .4rem .35rem; font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; color: #63789a; }
  .omt-actions { display: flex; flex-direction: column; gap: .3rem; }
  .omt-actions a { border: 1px solid #1b2c49; background: #0b1730; font-size: .88rem; }
  .omt-rail-foot, .omt-people-foot { margin-top: auto; padding: .9rem .4rem 0; color: #7f95b5; font-style: italic; font-size: .85rem; line-height: 1.45; }
  .omt-session-card { border: 1px solid #1b2c49; background: linear-gradient(160deg, #0c1830, #0a1425); border-radius: 12px; padding: .7rem .75rem; display: flex; flex-direction: column; gap: .3rem; }
  .omt-session-card strong { font-size: .92rem; }
  .omt-session-card span { font-size: .78rem; color: #8fa3bf; line-height: 1.4; }
  .omt-session-card .omt-live-dot { color: #34d399; }

  /* --- main column --- */
  .omt-main { padding: 1rem 1.2rem 1.4rem; display: flex; flex-direction: column; gap: .9rem; min-width: 0; }
  .omt-omnibox { display: flex; align-items: center; gap: .6rem; background: #0c1730; border: 1px solid #1e3050; border-radius: 999px; padding: .55rem 1rem; box-shadow: 0 2px 14px rgba(0, 0, 0, .35); }
  .omt-omnibox:focus-within { border-color: #2f7bff; box-shadow: 0 0 0 3px rgba(47, 123, 255, .25); }
  .omt-omnibox svg { flex: 0 0 auto; fill: #7f95b5; }
  .omt-omnibox input, .omt-composer input { flex: 1 1 auto; min-width: 0; border: 0; outline: 0; background: transparent; color: #e7eef8; font-size: .98rem; }
  .omt-omnibox input::placeholder, .omt-composer input::placeholder { color: #63789a; }

  .omt-hero { position: relative; overflow: hidden; border: 1px solid #1b2c49; border-radius: 16px; padding: 1.3rem 1.4rem 1.2rem; background:
      radial-gradient(560px 240px at 72% -10%, rgba(53, 196, 255, .20), rgba(53, 196, 255, 0) 62%),
      radial-gradient(480px 220px at 8% 115%, rgba(47, 123, 255, .18), rgba(47, 123, 255, 0) 60%),
      radial-gradient(2px 2px at 12% 22%, rgba(255,255,255,.75) 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 34% 12%, rgba(255,255,255,.55) 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 88% 30%, rgba(255,255,255,.5) 50%, transparent 51%),
      radial-gradient(2px 2px at 58% 18%, rgba(255,255,255,.45) 50%, transparent 51%),
      linear-gradient(168deg, #0c1a33 0%, #081426 55%, #060f1f 100%); }
  .omt-hero-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .9fr) minmax(0, 1fr); gap: 1.2rem; align-items: center; position: relative; }
  .omt-hero h1 { margin: 0; font-size: 2.6rem; font-weight: 650; letter-spacing: -.01em; line-height: 1.02; }
  .omt-hero-line { margin: .35rem 0 0; font-size: 1.06rem; font-weight: 600; color: #dbe7fa; }
  .omt-hero-sub { margin: .55rem 0 0; color: #9db1cf; font-size: .92rem; line-height: 1.5; max-width: 34ch; }
  .omt-hero-live { margin: .8rem 0 0; font-size: .8rem; color: #35c4ff; letter-spacing: .02em; }
  .omt-orbit { position: relative; height: 168px; }
  .omt-orbit .omt-ring { position: absolute; inset: 0; width: 100%; height: 100%; }
  .omt-orbit-core { position: absolute; left: 50%; top: 50%; width: 74px; height: 74px; margin: -37px 0 0 -37px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
      background: radial-gradient(circle at 38% 32%, rgba(140, 225, 255, .95), rgba(47, 123, 255, .75) 45%, rgba(14, 42, 90, .95) 78%);
      box-shadow: 0 0 34px rgba(53, 196, 255, .55), inset 0 0 18px rgba(255, 255, 255, .25); animation: omt-pulse 3.2s ease-in-out infinite; }
  @keyframes omt-pulse { 0%, 100% { box-shadow: 0 0 26px rgba(53, 196, 255, .45), inset 0 0 18px rgba(255,255,255,.22); } 50% { box-shadow: 0 0 44px rgba(53, 196, 255, .7), inset 0 0 22px rgba(255,255,255,.3); } }
  @media (prefers-reduced-motion: reduce) { .omt-orbit-core { animation: none; } }
  .omt-orbit-node { position: absolute; width: 34px; height: 34px; border-radius: 50%; background: #0d1a30; border: 1px solid #2a4a7d; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 12px rgba(53, 196, 255, .3); }
  .omt-orbit-node img { width: 19px; height: 19px; }
  .omt-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .8rem; }
  .omt-chips li { display: flex; flex-direction: column; gap: .12rem; padding-left: 2.1rem; position: relative; }
  .omt-chips .omt-chip-ic { position: absolute; left: 0; top: .05rem; width: 1.55rem; height: 1.55rem; border-radius: 8px; border: 1px solid #2a4a7d; background: rgba(47, 123, 255, .15); display: flex; align-items: center; justify-content: center; font-size: .85rem; }
  .omt-chips strong { font-size: .9rem; color: #eaf2fd; }
  .omt-chips span { font-size: .78rem; color: #8fa3bf; line-height: 1.4; }

  .omt-strip { display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; border: 1px solid #1b2c49; background: #0b1730; border-radius: 12px; padding: .55rem .9rem; }
  .omt-strip-topic { font-weight: 650; font-size: .95rem; }
  .omt-strip-state { color: #8fa3bf; font-size: .85rem; }
  .omt-strip-tabs { display: flex; gap: .3rem; margin-left: auto; }
  .omt-strip-tabs a { padding: .38rem .8rem; border-radius: 999px; text-decoration: none; font-size: .85rem; color: #c6d4e8; border: 1px solid transparent; }
  .omt-strip-tabs a:hover { border-color: #2a4a7d; color: #fff; }
  .omt-strip-tabs a:first-child { background: rgba(47, 123, 255, .3); color: #fff; }
  .omt-share { border: 1px solid #2a4a7d; background: #0d1c38; color: #dbe7fa; border-radius: 999px; padding: .42rem .95rem; font-size: .85rem; cursor: pointer; }
  .omt-share:hover { background: #12305f; }

  .omt-stage { border: 1px solid #16263f; border-radius: 14px; background: linear-gradient(180deg, rgba(17, 32, 58, .55), rgba(10, 20, 38, .55)); padding: 1rem; }
  .omt-empty { border: 1px dashed #24406b; border-radius: 12px; padding: 1.4rem 1.2rem; text-align: center; display: flex; flex-direction: column; gap: .4rem; align-items: center; }
  .omt-empty strong { font-size: 1.02rem; color: #eaf2fd; }
  .omt-empty span { color: #8fa3bf; font-size: .88rem; line-height: 1.5; max-width: 56ch; }

  /* --- guest sign-in card (the standard sign-in shape, in the
     face's own dark system — same fields, same doors as everywhere:
     Google, email + password, one-tap email link) --- */
  .hp { position: absolute; left: -9999px; }
  .omt-signin { max-width: 430px; margin: 0 auto; border: 1px solid #1b2c49; background: #0a1528; border-radius: 12px; padding: 1.3rem 1.4rem 1.2rem; }
  .omt-signin h2 { margin: 0 0 .9rem; font-size: 1.25rem; }
  .omt-google-btn { display: block; text-align: center; background: #fff; color: #202124; border-radius: 999px; padding: .55rem 1rem; font-weight: 600; font-size: .92rem; text-decoration: none; margin-bottom: .6rem; }
  .omt-google-btn:hover { background: #e8eaed; }
  .omt-signin-form { display: flex; flex-direction: column; gap: .35rem; }
  .omt-signin-form label { font-size: .8rem; color: #8fa3bf; margin-top: .45rem; }
  .omt-signin-form input { background: #0c1730; border: 1px solid #1e3050; border-radius: 9px; padding: .55rem .8rem; color: #e7eef8; font-size: .95rem; outline: 0; font-family: inherit; }
  .omt-signin-form input:focus { border-color: #2f7bff; box-shadow: 0 0 0 3px rgba(47, 123, 255, .25); }
  .omt-signin-form .omt-send { margin-top: .7rem; align-self: flex-start; }
  .omt-signin-form .omt-share { margin-top: .7rem; align-self: flex-start; }
  .omt-signin-links { margin: .9rem 0 0; font-size: .88rem; color: #8fa3bf; }
  .omt-signin-links a { color: #7dd3fc; }
  .omt-signin-or { border-top: 1px solid #16263f; margin-top: 1.1rem; padding-top: .9rem; }
  .omt-signin-note { color: #8fa3bf; font-size: .88rem; line-height: 1.5; margin: .6rem 0 0; }

  .omt-panels { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .9rem; }
  .omt-panel { border: 1px solid #1b2c49; background: #0a1528; border-radius: 14px; padding: .95rem 1rem; min-height: 128px; }
  .omt-panel h2 { margin: 0 0 .5rem; font-size: .95rem; display: flex; align-items: center; gap: .5rem; }
  .omt-panel h2 .omt-live { margin-left: auto; font-size: .68rem; letter-spacing: .07em; color: #34d399; text-transform: uppercase; display: flex; align-items: center; gap: .3rem; }
  .omt-panel h2 .omt-live::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: #34d399; box-shadow: 0 0 8px rgba(52, 211, 153, .8); }
  .omt-panel p { margin: 0; color: #8fa3bf; font-size: .85rem; line-height: 1.55; }

  .omt-composer { position: sticky; bottom: .9rem; display: flex; align-items: center; gap: .7rem; background: #0c1730; border: 1px solid #24406b; border-radius: 999px; padding: .5rem .55rem .5rem 1.05rem; box-shadow: 0 8px 28px rgba(0, 0, 0, .5); }
  .omt-composer:focus-within { border-color: #2f7bff; box-shadow: 0 0 0 3px rgba(47, 123, 255, .25), 0 8px 28px rgba(0, 0, 0, .5); }
  .omt-composer-dot { width: 10px; height: 10px; border-radius: 50%; background: #35c4ff; box-shadow: 0 0 10px rgba(53, 196, 255, .8); flex: 0 0 auto; }
  .omt-send { flex: 0 0 auto; border: 0; border-radius: 999px; background: linear-gradient(135deg, #2f7bff, #1f6ae0); color: #fff; font-size: .92rem; font-weight: 600; padding: .55rem 1.25rem; cursor: pointer; }
  .omt-send:hover { background: linear-gradient(135deg, #4a8dff, #2f7bff); }

  /* --- participants rail --- */
  .omt-people-head { display: flex; align-items: baseline; gap: .5rem; padding: 0 .4rem .55rem; }
  .omt-people-head h2 { margin: 0; font-size: 1rem; }
  .omt-people-head span { color: #63789a; font-size: .78rem; }
  .omt-people-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .12rem; }
  .omt-person { display: flex; align-items: center; gap: .65rem; padding: .42rem .5rem; border-radius: 10px; text-decoration: none; }
  a.omt-person:hover { background: rgba(47, 123, 255, .13); }
  .omt-avatar { width: 32px; height: 32px; border-radius: 50%; background: #0d1a30; border: 1px solid #22385e; display: flex; align-items: center; justify-content: center; overflow: hidden; flex: 0 0 auto; font-weight: 650; color: #9fd8ff; }
  .omt-avatar img { width: 19px; height: 19px; }
  .omt-avatar-you { background: linear-gradient(135deg, #2f7bff, #35c4ff); color: #fff; border-color: transparent; }
  .omt-person-meta { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; }
  .omt-person-meta strong { font-size: .9rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .omt-person-meta small { color: #7f95b5; font-size: .72rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .omt-dot { width: 8px; height: 8px; border-radius: 50%; background: #3a4f74; flex: 0 0 auto; }
  .omt-dot.is-on { background: #34d399; box-shadow: 0 0 8px rgba(52, 211, 153, .75); }
  .omt-person-you-row { border-top: 1px solid #16263f; margin-top: .45rem; padding-top: .45rem; }
  .omt-lesser-note { margin: 0 .4rem .45rem; color: #7f95b5; font-size: .8rem; line-height: 1.45; }

  @media (max-width: 1180px) {
    .omt { grid-template-columns: 208px minmax(0, 1fr); }
    .omt-people { grid-column: 1 / -1; border-left: 0; border-top: 1px solid #16263f; }
    .omt-people-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); }
    .omt-hero-grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); }
    .omt-orbit { display: none; }
  }
  @media (max-width: 720px) {
    .omt { grid-template-columns: minmax(0, 1fr); }
    .omt-rail { border-right: 0; border-bottom: 1px solid #16263f; }
