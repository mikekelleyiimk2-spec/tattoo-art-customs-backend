<style>
  body { background:#070714; }
  .ports { color:#e8e6ff; max-width:980px; margin:0 auto; padding:8vh 20px 70px; text-align:center;
    font-family:ui-monospace,'Courier New',monospace; }
  .ports .cab { border:3px solid #3b2d8f; border-radius:18px; padding:44px 26px 40px;
