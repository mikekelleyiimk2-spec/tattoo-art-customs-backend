<style>
  body { background:#0b0b0d; }
  .tacdoor { color:#f2ede6; }
  .tacdoor .hero { position:relative; border-radius:0 0 18px 18px; overflow:hidden; }
  .tacdoor .hero img.bg { width:100%; height:430px; object-fit:cover; display:block; }
  .tacdoor .hero .shade { position:absolute; inset:0; background:linear-gradient(to top, rgba(5,5,8,.92) 8%, rgba(5,5,8,.25) 55%, rgba(5,5,8,.15)); }
  .tacdoor .hero .over { position:absolute; inset:auto 0 0 0; padding:26px 22px 30px; text-align:center; }
  .tacdoor .mark { font-size:14px; letter-spacing:6px; text-transform:uppercase; color:#ff7a5c; margin:0 0 10px; }
  .tacdoor h1 { font-size:60px; line-height:1.0; margin:0 0 12px; font-weight:800; text-shadow:0 4px 30px rgba(0,0,0,.8); }
  .tacdoor .lede { font-size:19px; line-height:1.5; color:#e6ded2; margin:0 auto 24px; max-width:580px; text-shadow:0 2px 12px rgba(0,0,0,.8); }
  .tacdoor a.enter { display:inline-block; background:#c8432b; color:#fff; text-decoration:none;
    font-size:20px; font-weight:700; padding:16px 44px; border-radius:999px; box-shadow:0 10px 30px rgba(200,67,43,.45); }
  .tacdoor a.enter:hover { background:#e0522f; }
  .tacdoor .row { text-align:center; margin:22px 0 8px; font-size:15px; color:#8f897d; }
  .tacdoor .row a { color:#f2ede6; }
  .tacdoor .show { max-width:1060px; margin:26px auto 60px; padding:0 20px;
    display:grid; grid-template-columns:repeat(3,1fr); gap:12px; }
  .tacdoor .show img { width:100%; height:250px; object-fit:cover; border-radius:12px; display:block;
    box-shadow:0 12px 32px rgba(0,0,0,.5); }
  /* Penny-sweeper stack (shared partials, door-native dress): the
     OneMind layout loads no site CSS, so the partials' classes are
     styled here, in the door's own palette. */
  .tacdoor .sweep { max-width:1060px; margin:0 auto 60px; padding:0 20px; }
  .tacdoor .sweep .fineprint { font-size:12px; letter-spacing:1px; text-transform:uppercase; color:#8f897d; margin:.2rem 0; }
  .tacdoor .sweep a { color:#f2ede6; }
  .tacdoor .sweep .house-ad { text-align:left; border:1px solid #33302a; border-radius:12px; background:#141417; padding:.9rem 1.1rem 1rem; margin:1.5rem 0; }
  .tacdoor .house-ad-label { display:inline-block; font-size:11px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:#8f897d; border:1px solid #33302a; border-radius:999px; padding:2px 10px; margin-bottom:8px; }
  .tacdoor .house-ad-body { display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; }
  .tacdoor .house-ad-text { display:flex; flex-direction:column; gap:3px; min-width:0; }
  .tacdoor .house-ad-headline { font-size:17px; }
  .tacdoor .house-ad-pitch { color:#c9c2b4; font-size:14px; }
  .tacdoor .house-ad-disclosure { font-size:12px; color:#8f897d; }
  .tacdoor .sweep a.house-ad-cta { background:#c8432b; color:#fff; text-decoration:none; font-weight:700; padding:10px 22px; border-radius:999px; white-space:nowrap; }
  .tacdoor .sweep-jar { color:#17324a; }
  .tacdoor .sweep-jar a.btn { display:inline-block; background:#c8432b; color:#fff; text-decoration:none; font-weight:700; padding:12px 30px; border-radius:999px; }
  @media (max-width:640px){ .tacdoor h1{ font-size:40px; } .tacdoor .hero img.bg{ height:360px; } .tacdoor .show img{ height:150px; } }
</style>
<main class="tacdoor">
  <div class="hero">
    <img class="bg" id="tacHero" src="/img/designs/color/nightly-black-and-grey-realism-time-clocks.jpg" alt="Tattoo Art Customs — featured design collection">
    <script>
      // The door is alive: the featured art rotates daily (Not-Flat
      // study §1 — a surface that changed since the last visit).
      (function () {
        var covers = [
          '/img/designs/color/nightly-black-and-grey-realism-time-clocks.jpg',
          '/img/designs/color/nightly-blackwork-nautical-ocean.jpg',
          '/img/designs/color/nightly-aurora-horror.jpg',
          '/img/designs/color/nightly-bioluminescent-characters.jpg'
        ];
        var day = Math.floor(Date.now() / 86400000);
        document.getElementById('tacHero').src = covers[day % covers.length];
      })();
    </script>
    <div class="shade"></div>
    <div class="over">
      <p class="mark">The Tattoo Shop</p>
      <h1><span translate="no">Tattoo Art Customs</span></h1>
      <p class="lede">Custom tattoo designs, a gallery of real artists, clean linework with every full-color piece. The shop lives at its own address — this is its door.</p>
      <a class="enter" href="<%= shopUrl %>">Enter the shop →</a>
    </div>
  </div>
  <p class="row">Already a customer? <a href="/login">Sign in</a> — one sign-in works everywhere we are.</p>
  <div class="show" aria-hidden="true">
    <img src="/img/designs/color/nightly-blackwork-nautical-ocean.jpg" alt="">
    <img src="/img/designs/color/nightly-aurora-horror.jpg" alt="">
    <img src="/img/designs/color/nightly-bioluminescent-characters.jpg" alt="">
  </div>
  <div class="sweep">
    <%- include('../partials/house-ad', {slot: 'door_tac'}) %>
    <%- include('../partials/sponsor-slot') %>
    <div class="sweep-jar"><%- include('../partials/tip-jar') %></div>
  </div>
</main>
