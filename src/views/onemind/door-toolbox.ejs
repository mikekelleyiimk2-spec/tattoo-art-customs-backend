<style>
  body { background:#171310; }
  .bench { color:#f3e9d8; max-width:1020px; margin:0 auto; padding:7vh 20px 70px; }
  .bench h1 { font-size:50px; margin:0 0 8px; font-weight:800; }
  .bench h1 .amp { color:#f59e0b; }
  .bench .lede { font-size:18px; color:#c9b797; margin:0 0 30px; max-width:600px; line-height:1.5; }
  .bench .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:14px; }
  .bench .tool { background:#221b16; border:1px solid #3d3125; border-top:4px solid #f59e0b;
    border-radius:10px; padding:18px 16px; }
  .bench .tool .chip { width:46px; height:46px; border-radius:12px; display:flex; align-items:center;
    justify-content:center; font-size:19px; font-weight:900; color:#14100c; margin-bottom:12px;
    box-shadow:0 6px 16px rgba(0,0,0,.45); }
  .bench .tool h2 { font-size:19px; margin:0 0 6px; }
  .bench .tool p { font-size:14px; line-height:1.45; color:#b3a184; margin:0 0 10px; }
  .bench .tool .price { font-size:14px; font-weight:700; color:#f59e0b; }
  .bench .cta { margin-top:32px; }
  .bench a.open { display:inline-block; background:#f59e0b; color:#1a1000; text-decoration:none;
    font-size:18px; font-weight:800; padding:14px 34px; border-radius:8px; }
  .bench a.open:hover { background:#fbbf24; }
  /* Penny-sweeper stack (shared partials, door-native dress): the
     OneMind layout loads no site CSS, so the partials' classes are
     styled here, in the door's own palette. */
  .bench .sweep .fineprint { font-size:12px; letter-spacing:1px; text-transform:uppercase; color:#b3a184; margin:.2rem 0; }
  .bench .sweep a { color:#f3e9d8; }
  .bench .sweep .house-ad { text-align:left; border:1px solid #3d3125; border-radius:10px; background:#221b16; padding:.9rem 1.1rem 1rem; margin:1.5rem 0; }
  .bench .house-ad-label { display:inline-block; font-size:11px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:#b3a184; border:1px solid #3d3125; border-radius:999px; padding:2px 10px; margin-bottom:8px; }
  .bench .house-ad-body { display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; }
  .bench .house-ad-text { display:flex; flex-direction:column; gap:3px; min-width:0; }
  .bench .house-ad-headline { font-size:17px; }
  .bench .house-ad-pitch { color:#c9b797; font-size:14px; }
  .bench .house-ad-disclosure { font-size:12px; color:#b3a184; }
  .bench .sweep a.house-ad-cta { background:#f59e0b; color:#1a1000; text-decoration:none; font-weight:800; padding:10px 22px; border-radius:8px; white-space:nowrap; }
  .bench .sweep-jar { color:#17324a; }
  .bench .sweep-jar a.btn { display:inline-block; background:#f59e0b; color:#1a1000; text-decoration:none; font-weight:800; padding:12px 30px; border-radius:8px; }
  @media (max-width:560px){ .bench h1{ font-size:36px; } }
</style>
<main class="bench">
  <h1>Toolbox <span class="amp">&amp;</span> Plugs</h1>
  <p class="lede">Tools built from real wounds — every one of these exists because the problem cost us first. Pick the one that's costing you.</p>
  <div class="grid">
    <div class="tool"><div class="chip" style="background:linear-gradient(140deg,#f59e0b,#fbbf24);">AR</div><h2>Affiliate Rolodex</h2><p>Every affiliate program, link, code and disclosure in one rolodex that plugs into every page you own.</p><span class="price">$4.99</span></div>
    <div class="tool"><div class="chip" style="background:linear-gradient(140deg,#22c55e,#86efac);">TH</div><h2>Tester Hub</h2><p>The 12-tester problem, fixed: one pool, sign-up is the opt-in, your list fills itself.</p><span class="price">Fill-My-List $24.99</span></div>
    <div class="tool"><div class="chip" style="background:linear-gradient(140deg,#14b8a6,#5eead4);">MW</div><h2>Money Watch</h2><p>Watches every account and flashes the moment money lands. Never search for a payment again.</p><span class="price">$4.99</span></div>
    <div class="tool"><div class="chip" style="background:linear-gradient(140deg,#8b5cf6,#c4b5fd);">AI</div><h2>AI to AI</h2><p>Your AIs, talking to each other across phones — one command, the team moves.</p><span class="price">$9.99</span></div>
    <div class="tool"><div class="chip" style="background:linear-gradient(140deg,#ef4444,#fca5a5);">CD</div><h2>Connection Doctor</h2><p>Finds the dead connection before it costs you — and keeps every plug alive.</p><span class="price">$29</span></div>
    <div class="tool"><div class="chip" style="background:linear-gradient(140deg,#3b82f6,#93c5fd);">SP</div><h2>Service Plug</h2><p>The whole service, plugged in and kept alive: door, drawer and plumbing.</p><span class="price">$49</span></div>
  </div>
  <p class="cta"><a class="open" href="/onemind/tools">Open the full toolbox →</a></p>
  <div class="sweep">
    <%- include('../partials/house-ad', {slot: 'door_toolbox'}) %>
    <%- include('../partials/sponsor-slot') %>
    <div class="sweep-jar"><%- include('../partials/tip-jar') %></div>
  </div>
</main>
