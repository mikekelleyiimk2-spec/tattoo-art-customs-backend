<h1>Shop dashboard</h1>

<% if (typeof artInbox !== 'undefined' && artInbox.length) { %>
<section class="card">
  <h2><%= t('transfer.inbox_title') %></h2>
  <ul><% artInbox.forEach(function(x) { %>
    <li><strong><%= x.design_title || x.design_id %></strong> <%= t('transfer.inbox_from', {name: x.from_name || x.to_email}) %>
      — <a href="/transfers/<%= x.token %>"><%= t('transfer.inbox_download') %></a>
      <span class="badge"><%= x.status %></span>
      <span class="muted"><%= new Date(x.created_at).toLocaleString() %></span></li>
  <% }); %></ul>
</section>
<% } %>

<% if (typeof clientOrders !== 'undefined' && clientOrders.length) { %>
<section class="card">
  <h2><%= t('transfer.client_orders_title') %></h2>
  <ul><% clientOrders.forEach(function(o) { %>
    <li><strong><%= o.design_title || o.design_id %></strong> — <%= o.client_email %>
      <span class="badge"><%= o.status %></span>
      <% if (o.status === 'paid') { %>
      <form method="post" action="/transfers/send-client/<%= o.id %>" style="display:inline">
        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <button class="btn secondary" type="submit"><%= t('transfer.forward_client') %></button>
      </form>
      <% } %></li>
  <% }); %></ul>
</section>
<% } %>

<% if (typeof clientBills !== 'undefined' && clientBills.length) { %>
<section class="card">
  <h2><%= t('transfer.bills_title') %></h2>
  <ul><% clientBills.forEach(function(b) { %>
    <li><strong><%= b.design_title || '' %></strong> — <%= b.client_email %> — <%= money(b.amount_cents) %>
      <span class="badge"><%= b.status %></span>
      <% if (b.status !== 'paid') { %>
      <form method="post" action="/shop/client-bills/<%= b.id %>/paid" style="display:inline">
        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <button class="btn secondary" type="submit"><%= t('transfer.mark_paid') %></button>
      </form>
      <% } %></li>
  <% }); %></ul>
</section>
<% } %>

<section class="card">
  <h2>Shop toolkit</h2>
  <p>
    <a class="btn secondary" href="/toolkit/waivers">Waivers</a>
    <a class="btn secondary" href="/toolkit/aftercare">Aftercare</a>
    <a class="btn secondary" href="/toolkit/autofill">Auto-fill</a>
    <a class="btn secondary" href="/toolkit/blasts">Blasts</a>
    <a class="btn secondary" href="/toolkit/healed">Healed wall</a>
    <a class="btn secondary" href="/toolkit/noshow">No-shows</a>
    <a class="btn secondary" href="/toolkit/plans">Payment plans</a>
    <a class="btn secondary" href="/toolkit/scale-print">Scale &amp; print</a>
    <a class="btn secondary" href="/shop/clients"><%= t('shop.clients.title') %></a>
    <a class="btn secondary" href="/shop/reviews"><%= t('shop.reviews.title') %></a>
    <a class="btn secondary" href="/shop/artists"><%= t('shop.artists.title') %></a>
    <a class="btn secondary" href="/shop/inventory"><%= t('shop.inventory.title') %></a>
    <a class="btn secondary" href="/shop/expenses"><%= t('shop.expenses.title') %></a>
    <a class="btn secondary" href="/store/manage/settings"><%= t('shop.storefront_settings_title') %></a>
  </p>
</section>

<section class="card">
  <h2><%= t('nav.tap_to_pay') %></h2>
  <% if (typeof tapIsComped !== 'undefined' && tapIsComped) { %>
    <p><span class="badge ok"><%= t('tappay.badge_comped') %></span>
      <span class="muted"><%= t('tappay.badge_comped_note') %></span></p>
  <% } else if (typeof tapSub !== 'undefined' && tapSub && tapIsActive && tapTier) { %>
    <p><span class="badge ok"><%= t('tappay.badge_active') %></span>
      <strong><%= tapTier.label %></strong> — $<%= (tapTier.priceCents / 100).toFixed(2) %>/mo · <%= tapTier.chairs %></p>
    <form method="post" action="/tap/cancel" style="display:inline">
      <button class="btn secondary" type="submit"><%= t('tappay.cancel_cta') %></button>
    </form>
  <% } else if (typeof tapSub !== 'undefined' && tapSub) { %>
    <p><span class="badge warn"><%= tapSub.status %></span>
      <span class="muted"><%= t('tappay.dash_lapsed') %></span></p>
    <p><a class="btn" href="/tap-to-pay"><%= t('tappay.activate_cta') %></a></p>
  <% } else { %>
    <p class="muted"><%= t('tappay.dash_blurb') %></p>
    <p>
      <% for (const key of ['solo', 'studio', 'shop']) { const tr = tapTiers[key]; %>
        <form method="post" action="/tap/subscribe/<%= key %>" style="display:inline;margin-right:.5rem">
          <button class="btn secondary" type="submit"><%= t('tappay.activate_cta') %> — <%= tr.label %> $<%= (tr.priceCents / 100).toFixed(2) %>/mo</button>
        </form>
      <% } %>
    </p>
  <% } %>
  <p class="muted">Booking calendar, deposits, receipts, reminders, waitlist, and gift cards live under <a href="/bookings/manage">Manage bookings</a>.</p>
</section>
<% if (isFoundingShop) { %>
<p><span class="badge ok">Founding Shop</span>
  <% if (foundingEndsAt && foundingEndsAt > Date.now()) { %>
  <span class="muted">— your 25% referral commission boost runs through <%= new Date(foundingEndsAt).toLocaleDateString() %></span>
  <% } %></p>
<p class="muted">Note: on sales of founding artists' designs the referral commission is 20% — the artist's 70% boost already uses the available bonus pool, so the extra 5% doesn't apply on those sales.</p>
<% } %>
<p class="muted">Tattoo shops earn <strong>20% on every verified sale</strong> they refer. Payouts require a registered account, an active subscription, and a payout destination set.</p>
<% if (typeof dualBonus !== 'undefined' && dualBonus) { %>
<p class="muted"><span class="badge ok">Dual-subscription bonus active</span> — you hold both a designer and a shop subscription, so your referral commission is <strong>22%</strong> instead of 20%, funded from the owner's share.</p>
<% } %>

<section class="card">
  <h2>Your referral link</h2>
  <% if (refLink) { %>
  <p><input type="text" readonly value="<%= refLink %>" onclick="this.select()" aria-label="Your referral link" style="font-size:.9rem"></p>
  <p class="muted">Share this link — sales made through it are attributed to your shop. You referred <strong><%= referralSales %></strong> paid sale(s) totaling <strong><%= money(referralTotal) %></strong>.</p>
  <% } else { %><p class="muted">Referral link will appear once your shop profile is created.</p><% } %>
</section>

<section class="card">
  <h2>Referral volume tier</h2>
  <p>You earn <strong><%= Math.round(tier.rate * 100) %>%</strong> on verified referral sales — <%= tier.salesThisMonth %> verified sale(s) so far this month.</p>
  <% if (tier.nextTierRate) { %>
  <p><strong><%= tier.salesToNext %></strong> more verified referral sale(s) this month to reach <strong><%= Math.round(tier.nextTierRate * 100) %>%</strong>.</p>
  <% } else { %>
  <p><span class="badge ok">Top tier</span> — you're earning the maximum referral rate this month.</p>
  <% } %>
  <p class="muted">20% base, 22% at 25+ verified referral sales in a calendar month, 25% at 50+. Tiers reset on the 1st of each month. The tier uplift is funded from the site's share — designer commissions never change.</p>
</section>

<section class="card">
  <h2>Designer membership — included</h2>
  <p><span class="badge ok">Active</span> <span class="muted">— every shop subscription includes the full designer membership</span></p>
  <p class="muted">Upload your own designs through the <a href="/artist/portfolio">artist portfolio</a> and earn designer commissions on them (<% if (typeof dualBonus !== 'undefined' && dualBonus) { %>62% premade with a referring shop, 72% without, 72% custom, 57% linework-only — includes your +2% dual-subscription bonus<% } else { %>60% premade with a referring shop, 70% without, 70% custom, 55% linework-only<% } %>). Your public designer portfolio is live on the site. Note: referring your <em>own</em> designs earns no referral commission — those sales are booked as if there were no referring shop.</p>
</section>

<div class="two-col">
  <section class="card">
    <h2>Balance</h2>
    <p><strong><%= money(balance) %></strong> payable</p>
    <p class="muted"><a href="#payouts">Manage payout destinations and cashout options ↓</a></p>
  </section>
  <section class="card">
    <h2>Shop profile</h2>
    <p class="muted">You may list <strong>only</strong>: business location, business hours, appointment requirements. No emails, phones, links, socials, or payment info. <% if (!profile.verified) { %><span class="badge warn">pending verification</span><% } %></p>
    <form method="post" action="/shop/profile" class="form">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <label for="business_name">Business name</label>
      <input type="text" id="business_name" name="business_name" value="<%= profile.business_name || '' %>" maxlength="120">
      <label for="location">Business location (city/state only)</label>
      <input type="text" id="location" name="location" value="<%= profile.location || '' %>" maxlength="200">
      <label for="hours">Business hours</label>
      <textarea id="hours" name="hours" maxlength="300"><%= profile.hours || '' %></textarea>
      <label for="appointment_requirements">Appointment requirements</label>
      <textarea id="appointment_requirements" name="appointment_requirements" maxlength="600"><%= profile.appointment_requirements || '' %></textarea>
      <p><button class="btn" type="submit">Save profile</button></p>
    </form>
  </section>
</div>

<h2>Commission ledger</h2>
<table>
  <thead><tr><th>Date</th><th>Order</th><th>Amount</th><th>Status</th></tr></thead>
  <tbody>
  <% ledger.forEach(function(l) { %>
    <tr><td><%= new Date(l.created_at).toLocaleDateString() %></td><td><%= l.order_id.slice(0,8) %></td><td><%= money(l.amount_cents) %></td><td><span class="badge"><%= l.status.replace('_',' ') %></span></td></tr>
  <% }); %>
  </tbody>
</table>
<p class="muted">Shop shares stay <em>pending</em> until an admin verifies the sale, then become payable.</p>

<h2>Payout history</h2>
<table>
  <thead><tr><th>Date</th><th>Amount</th><th>To</th><th>Status</th></tr></thead>
  <tbody>
  <% payouts.forEach(function(p) { %>
    <tr><td><%= new Date(p.created_at).toLocaleDateString() %></td><td><%= money(p.amount_cents) %></td><td><%= p.paypal_email %></td><td><span class="badge"><%= p.status %></span></td></tr>
  <% }); %>
  </tbody>
</table>

<%- include('../partials/payout-settings', { payoutBase: '/shop', destinations, cashoutMode, balance, cashoutRequests, earlyQuote, destTypes, minCashoutCents, money }) %>
