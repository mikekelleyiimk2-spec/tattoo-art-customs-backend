<h1><%= artist.name %>
  <% if (!artist.active) { %><span class="badge"><%= t('shop.artists.inactive_badge') %></span><% } %></h1>
<p><a class="btn secondary" href="/shop/artists"><%= t('shop.artists.back') %></a></p>

<section class="card">
  <h2><%= t('shop.artists.totals') %> · <%= t('shop.artists.period') %></h2>
  <form method="get" action="/shop/artists/<%= artist.id %>" class="form inline">
    <label><%= t('shop.common.from') %> <input type="date" name="from" value="<%= new Date(from).toISOString().slice(0, 10) %>"></label>
    <label><%= t('shop.common.to') %> <input type="date" name="to" value="<%= new Date(to).toISOString().slice(0, 10) %>"></label>
    <p><button type="submit" class="secondary"><%= t('shop.common.filter') %></button></p>
  </form>
  <p><strong><%= t('shop.artists.total_booked') %>:</strong> <%= money(totals.amount_cents) %>
    · <strong><%= t('shop.artists.artist_share') %>:</strong> <%= money(totals.artist_share_cents) %>
    · <strong><%= t('shop.artists.shop_share') %>:</strong> <%= money(totals.shop_share_cents) %>
    · <strong><%= t('shop.artists.bookings') %>:</strong> <%= totals.entries %></p>
</section>

<section class="card">
  <h2><%= t('shop.artists.edit_heading') %></h2>
  <form method="post" action="/shop/artists/<%= artist.id %>" class="form">
    <label><%= t('shop.artists.name') %>
      <input type="text" name="name" value="<%= artist.name %>" required maxlength="120">
    </label>
    <label><%= t('shop.artists.rate_label') %>
      <input type="number" name="commission_rate_pct" min="0" max="100" value="<%= artist.commission_rate_pct %>">
    </label>
    <p><button type="submit"><%= t('shop.common.save') %></button></p>
  </form>
</section>

<h2><%= t('shop.artists.earnings_heading') %></h2>
<% if (!earnings.length) { %><p class="muted"><%= t('shop.artists.no_earnings') %></p><% } %>
<% for (const e of earnings) { %>
<section class="card">
  <h3><%= money(e.amount_cents) %></h3>
  <p class="muted"><%= t('shop.artists.artist_share') %>: <%= money(e.artist_share_cents) %>
    · <%= t('shop.artists.shop_share') %>: <%= money(e.shop_share_cents) %>
    <br><%= new Date(e.earned_at).toLocaleString('en-US', { timeZone: 'America/Chicago' }) %>
    <% if (e.booking_id) { %> · booking <%= e.booking_id %><% } %>
    <% if (e.note) { %><br><%= e.note %><% } %></p>
</section>
<% } %>
