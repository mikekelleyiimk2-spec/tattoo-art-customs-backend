<h1><%= t('shop.perks.title') %></h1>
<p class="muted"><%= t('shop.perks.sub') %></p>

<div class="discount-grid">
  <div class="product-card discount-card">
    <div class="discount-badge"><%= t('shop.perks.cnc_badge') %></div>
    <h3><%= t('shop.perks.cnc_h') %></h3>
    <p><%= t('shop.perks.cnc_text') %></p>
    <a class="btn" href="https://www.cnctattoo.com/?ref=jvlrjxit" target="_blank" rel="noopener nofollow sponsored"><%= t('shop.perks.cnc_cta') %></a>
  </div>
</div>

<p class="fineprint"><%= t('shop.perks.disclosure') %></p>

<style>
.discount-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, min(100%, 320px))); gap: 1rem; margin: 1.5rem 0; }
.discount-card { position: relative; }
.discount-badge { display: inline-block; background: var(--accent); color: #fff; font-size: .8rem; font-weight: bold; padding: .25rem .6rem; border-radius: 20px; margin-bottom: .5rem; }
</style>
