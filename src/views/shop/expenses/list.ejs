<h1><%= t('shop.expenses.title') %></h1>
<p class="muted"><%= t('shop.expenses.subtitle') %></p>

<section class="card">
  <h2><%= t('shop.expenses.add_expense') %></h2>
  <form method="post" action="/shop/expenses" class="form">
    <label><%= t('shop.expenses.amount') %>
      <input type="number" name="amount_dollars" step="0.01" min="0.01" required>
    </label>
    <label><%= t('shop.expenses.category') %>
      <select name="category">
        <% for (const c of categories) { %><option value="<%= c %>"><%= c %></option><% } %>
      </select>
    </label>
    <label><%= t('shop.expenses.description') %>
      <input type="text" name="description" maxlength="500">
    </label>
    <label><%= t('shop.expenses.date') %>
      <input type="date" name="spent_on" value="<%= new Date().toISOString().slice(0, 10) %>">
    </label>
    <input type="hidden" name="month" value="<%= month %>">
    <p><button type="submit"><%= t('shop.expenses.log') %></button></p>
  </form>
</section>

<section class="card">
  <h2><%= t('shop.expenses.monthly_totals') %></h2>
  <form method="get" action="/shop/expenses" class="form inline">
    <label><%= t('shop.common.month') %> <input type="month" name="month" value="<%= month %>"></label>
    <p><button type="submit" class="secondary"><%= t('shop.common.filter') %></button></p>
  </form>
  <p>
    <% for (const m of monthlyTotals) { %>
    <a href="/shop/expenses?month=<%= m.month %>" <%= m.month === month ? 'class="current"' : '' %>><%= m.month %>: <strong><%= money(m.amount_cents) %></strong></a>
    <% if (m !== monthlyTotals[monthlyTotals.length - 1]) { %> · <% } %>
    <% } %>
  </p>
</section>

<h2><%= t('shop.expenses.month_expenses') %> (<%= month %>) — <%= t('shop.common.total') %>: <%= money(monthTotal) %></h2>
<% if (!expenses.length) { %><p class="muted"><%= t('shop.expenses.no_expenses') %></p><% } %>
<% for (const e of expenses) { %>
<section class="card">
  <h3><%= money(e.amount_cents) %> <span class="muted"><%= e.category %></span></h3>
  <p class="muted"><%= new Date(e.spent_at).toLocaleDateString('en-US', { timeZone: 'America/Chicago' }) %>
    <% if (e.description) { %><br><%= e.description %><% } %></p>
  <form method="post" action="/shop/expenses/<%= e.id %>/delete" class="form inline">
    <input type="hidden" name="month" value="<%= month %>">
    <button type="submit" class="secondary danger" onclick="return confirm('<%= t('shop.common.confirm_delete') %>')"><%= t('shop.common.delete') %></button>
  </form>
</section>
<% } %>

<section class="card">
  <h2><%= t('shop.expenses.category_breakdown') %> (<%= month %>)</h2>
  <% if (!categoryTotals.length) { %><p class="muted">—</p><% } %>
  <ul>
    <% for (const c of categoryTotals) { %>
    <li><strong><%= c.category %></strong>: <%= money(c.amount_cents) %> (<%= c.count %>)</li>
    <% } %>
  </ul>
</section>
