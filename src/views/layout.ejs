<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title : 'Tattoo Art Customs' %></title>
<% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
<meta name="description" content="<%= metaDescription %>">
<% } %>
<% if (typeof googleVerification !== 'undefined' && googleVerification) { %>
<meta name="google-site-verification" content="<%= googleVerification %>">
<% } %>
<meta name="p:domain_verify" content="29d0a3d3520145229ad9e0301b3dc5b1">
<% if (typeof canonical !== 'undefined' && canonical) { %>
<link rel="canonical" href="<%= canonical %>">
<% } %>
<meta property="og:site_name" content="Tattoo Art Customs">
<meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
<% if (typeof canonical !== 'undefined' && canonical) { %>
<meta property="og:url" content="<%= canonical %>">
<% } %>
<meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Tattoo Art Customs' %>">
<% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
<meta property="og:description" content="<%= metaDescription %>">
<% } %>
<% if (typeof ogImage !== 'undefined' && ogImage) { %>
<meta property="og:image" content="<%= ogImage %>">
<% } %>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'Tattoo Art Customs' %>">
<% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
<meta name="twitter:description" content="<%= metaDescription %>">
<% } %>
<% if (typeof ogImage !== 'undefined' && ogImage) { %>
<meta name="twitter:image" content="<%= ogImage %>">
<% } %>
<link rel="stylesheet" href="/css/style.css">
<% if (typeof adsenseId !== 'undefined' && adsenseId) { %>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= adsenseId %>" crossorigin="anonymous"></script>
<% } %>
</head>
<body>
<a class="skip" href="#main">Skip to main content</a>
<header class="site-header">
  <nav class="nav" aria-label="Main navigation">
    <a class="brand" href="/">Tattoo Art Customs</a>
    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" onclick="document.querySelector('.nav').classList.toggle('open');this.setAttribute('aria-expanded',document.querySelector('.nav').classList.contains('open'))">☰</button>
    <div class="nav-links">
      <a href="/gallery">Gallery</a>
      <a href="/orders/custom">Custom Design</a>
      <a href="/membership">Membership</a>
      <a href="/gift-cards/buy">Gift Cards</a>
      <a href="/merch">Merch</a>
      <a href="/contests">Contests</a>
      <a href="/about">About</a>
      <% if (playStoreUrl) { %><a class="btn" href="<%= playStoreUrl %>" target="_blank" rel="noopener">Get the app</a><% } %>
      <% if (currentUser) { %>
        <a href="/account">Account</a>
        <a href="/wallet">Wallet</a>
        <a href="/studio">Design Studio</a>
        <% if (currentUser.role === 'design_artist') { %><a href="/artist">Artist</a><% } %>
        <% if (currentUser.role === 'tattoo_shop') { %><a href="/shop">Shop</a><% } %>
        <% if (currentUser.role === 'admin' || currentUser.role === 'head_admin') { %><a href="/admin">Admin</a><% } %>
        <a href="/messages">Messages</a>
        <a href="/notifications">Notifications<% if (typeof notifCount !== 'undefined' && notifCount > 0) { %> <span class="badge warn"><%= notifCount %></span><% } %></a>
        <a href="/logout">Log out</a>
      <% } else { %>
        <a href="/login">Log in</a>
        <a class="btn" href="/signup">Sign up</a>
      <% } %>
    </div>
  </nav>
</header>

<% if (flash) { %>
<div class="flash" role="alert"><%= flash %></div>
<% } %>

<%- include('partials/ad-slot', {slot: 'leaderboard'}) %>

<main id="main" class="container">
  <%- body %>
</main>

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <strong>Tattoo Art Customs</strong>
      <p>Original tattoo designs. Custom work with 48-hour delivery.</p>
    </div>
    <nav aria-label="Footer navigation">
      <a href="/gallery">Gallery</a>
      <a href="/membership">Membership</a>
      <a href="/gift-cards/buy">Gift Cards</a>
      <a href="/merch">Merch</a>
      <a href="/contests">Contests</a>
      <a href="/advertise">Advertise</a>
      <a href="/terms">Terms</a>
      <a href="/privacy">Privacy</a>
      <a href="/about">About</a>
      <% if (playStoreUrl) { %><a href="<%= playStoreUrl %>" target="_blank" rel="noopener">Get the app</a><% } %>
    </nav>
  </div>
  <p class="fineprint">© <%= new Date().getFullYear() %> Tattoo Art Customs. All sales, subscriptions, and memberships are final.</p>
</footer>
<div id="cookie-banner" style="display:none;position:fixed;left:0;right:0;bottom:0;background:#1a1a1a;color:#fff;padding:12px 16px;gap:12px;align-items:center;justify-content:space-between;z-index:9999;font-size:14px;">
  <span>We use cookies for sign-in, preferences, and — once enabled — Google advertising. See our <a href="/privacy" style="color:#ffd166;">Privacy Policy</a>.</span>
  <button id="cookie-ok" class="btn" style="white-space:nowrap;">Got it</button>
</div>
<script>
(function () {
  // NOTE: do NOT use the `hidden` attribute on #cookie-banner — its inline
  // display:flex overrides hidden's display:none, which made the dismiss
  // button a no-op. Visibility is controlled purely via style.display.
  var b = document.getElementById('cookie-banner');
  var seen = false;
  try { seen = !!localStorage.getItem('tac_cookie_ok'); } catch (e) {}
  if (!seen) b.style.display = 'flex';
  document.getElementById('cookie-ok').addEventListener('click', function () {
    try { localStorage.setItem('tac_cookie_ok', '1'); } catch (e) {}
    b.style.display = 'none';
  });
})();
// Double-submit protection + feedback: every POST form disables its submit
// buttons on submit so rapid clicks can't stack duplicate orders or
// subscriptions, and the user sees that something is happening.
document.addEventListener('submit', function (ev) {
  var f = ev.target;
  if (!f || f.tagName !== 'FORM') return;
  if ((f.getAttribute('method') || 'get').toLowerCase() !== 'post') return;
  if (f.dataset.submitted) { ev.preventDefault(); return; }
  f.dataset.submitted = '1';
  Array.prototype.forEach.call(f.querySelectorAll('button[type="submit"], input[type="submit"]'), function (el) {
    el.disabled = true;
    if (el.tagName === 'BUTTON' && !el.dataset.label) {
      el.dataset.label = el.textContent;
      el.textContent = 'Working…';
    }
  });
});
// Give every table cell a data-label from its column header, so the
// small-screen stacked-card table CSS can label each value.
(function () {
  document.querySelectorAll('table').forEach(function (t) {
    var heads = Array.prototype.map.call(
      t.querySelectorAll('thead th'), function (h) { return h.textContent.trim(); });
    if (!heads.length) return;
    t.querySelectorAll('tbody tr').forEach(function (r) {
      Array.prototype.forEach.call(r.children, function (c, i) {
        if (c.tagName === 'TD' && heads[i]) c.setAttribute('data-label', heads[i]);
      });
    });
  });
})();
</script>
</body>
</html>
