<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title : 'Tattoo Art Customs' %></title>
<% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
<meta name="description" content="<%= metaDescription %>">
<% } %>
<meta property="og:site_name" content="Tattoo Art Customs">
<meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Tattoo Art Customs' %>">
<link rel="stylesheet" href="/css/style.css">
<% if (typeof adsenseId !== 'undefined' && adsenseId) { %>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= adsenseId %>" crossorigin="anonymous"></script>
<% } %>
</head>
<body>
<a class="skip" href="#main">Skip to main content</a>
<header class="site-header">
  <nav class="nav" aria-label="Main navigation">
    <a class="brand" href="/">Tattoo Art Customs</a>
    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" onclick="document.querySelector('.nav').classList.toggle('open');this.setAttribute('aria-expanded',document.querySelector('.nav').classList.contains('open'))">☰</button>
    <div class="nav-links">
      <a href="/gallery">Gallery</a>
      <a href="/orders/custom">Custom Design</a>
      <a href="/membership">Membership</a>
      <a href="/about">About</a>
      <% if (currentUser) { %>
        <a href="/account">Account</a>
        <a href="/studio">Design Studio</a>
        <% if (currentUser.role === 'design_artist') { %><a href="/artist">Artist</a><% } %>
        <% if (currentUser.role === 'tattoo_shop') { %><a href="/shop">Shop</a><% } %>
        <% if (currentUser.role === 'admin') { %><a href="/admin">Admin</a><% } %>
        <a href="/messages">Messages</a>
        <a href="/logout">Log out</a>
      <% } else { %>
        <a href="/login">Log in</a>
        <a class="btn" href="/signup">Sign up</a>
      <% } %>
    </div>
  </nav>
</header>

<% if (flash) { %>
<div class="flash" role="alert"><%= flash %></div>
<% } %>

<%- include('partials/ad-slot', {slot: 'leaderboard'}) %>

<main id="main" class="container">
  <%- body %>
</main>

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <strong>Tattoo Art Customs</strong>
      <p>Original tattoo designs. Custom work with 48-hour delivery.</p>
    </div>
    <nav aria-label="Footer navigation">
      <a href="/gallery">Gallery</a>
      <a href="/membership">Membership</a>
      <a href="/advertise">Advertise</a>
      <a href="/terms">Terms</a>
      <a href="/privacy">Privacy</a>
      <a href="/about">About</a>
    </nav>
  </div>
  <p class="fineprint">© <%= new Date().getFullYear() %> Tattoo Art Customs. All sales, subscriptions, and memberships are final.</p>
</footer>
</body>
</html>
