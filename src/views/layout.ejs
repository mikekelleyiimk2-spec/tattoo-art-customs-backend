<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title : 'Tattoo Art Customs' %></title>
<% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
<meta name="description" content="<%= metaDescription %>">
<% } %>
<% if (typeof googleVerification !== 'undefined' && googleVerification) { %>
<meta name="google-site-verification" content="<%= googleVerification %>">
<% } %>
<meta name="p:domain_verify" content="29d0a3d3520145229ad9e0301b3dc5b1">
<% if (typeof canonical !== 'undefined' && canonical) { %>
<link rel="canonical" href="<%= canonical %>">
<% supportedLocales.forEach(function(l) { %><link rel="alternate" hreflang="<%= l %>" href="<%= canonical %>?hl=<%= l %>">
<% }); %><link rel="alternate" hreflang="x-default" href="<%= canonical %>">
<% } %>
<meta property="og:site_name" content="Tattoo Art Customs">
<meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
<% if (typeof canonical !== 'undefined' && canonical) { %>
<meta property="og:url" content="<%= canonical %>">
<% } %>
<meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Tattoo Art Customs' %>">
<% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
<meta property="og:description" content="<%= metaDescription %>">
<% } %>
<% if (typeof ogImage !== 'undefined' && ogImage) { %>
<meta property="og:image" content="<%= ogImage %>">
<% } %>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'Tattoo Art Customs' %>">
<% if (typeof metaDescription !== 'undefined' && metaDescription) { %>
<meta name="twitter:description" content="<%= metaDescription %>">
<% } %>
<% if (typeof ogImage !== 'undefined' && ogImage) { %>
<meta name="twitter:image" content="<%= ogImage %>">
<% } %>
<link rel="stylesheet" href="/css/style.css">
<style>
/* Sitewide rotating linework background: one of 12 collage tiles, picked per
   page render below. Fixed div (never background-attachment:fixed — iOS) at
   z-index:-1 so it sits behind all content without disturbing stacking. */
.site-bg { position: fixed; inset: 0; background-repeat: repeat;
  background-size: 1600px auto; opacity: .12; pointer-events: none; z-index: -1; }
</style>
<% if (typeof adsenseId !== 'undefined' && adsenseId) { %>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= adsenseId %>" crossorigin="anonymous"></script>
<% } %>
</head>
<body>
<% /* Rotating sitewide linework background — one of 12 tiles per page render. */ %>
<% const bgTiles = ['/img/landing/linework-bg.webp','/img/landing/linework-bg-02.webp','/img/landing/linework-bg-03.webp','/img/landing/linework-bg-04.webp','/img/landing/linework-bg-05.webp','/img/landing/linework-bg-06.webp','/img/landing/linework-bg-07.webp','/img/landing/linework-bg-08.webp','/img/landing/linework-bg-09.webp','/img/landing/linework-bg-10.webp','/img/landing/linework-bg-11.webp','/img/landing/linework-bg-12.webp']; %>
<% const bgTile = bgTiles[Math.floor(Math.random() * bgTiles.length)]; %>
<div class="site-bg" aria-hidden="true" style="background-image:url('<%= bgTile %>')"></div>
<a class="skip" href="#main"><%= t('nav.skip') %></a>
<header class="site-header">
  <nav class="nav" aria-label="<%= t('nav.main') %>">
    <a class="brand" href="/">Tattoo Art Customs™</a>
    <button class="nav-toggle" aria-label="<%= t('nav.toggle_menu') %>" aria-expanded="false" onclick="document.querySelector('.nav').classList.toggle('open');this.setAttribute('aria-expanded',document.querySelector('.nav').classList.contains('open'))">☰</button>
    <div class="nav-links">
      <a href="/gallery"><%= t('nav.gallery') %></a>
      <a href="/orders/custom"><%= t('nav.custom_design') %></a>
      <a href="/membership"><%= t('nav.membership') %></a>
      <a href="/gift-cards/buy"><%= t('nav.gift_cards') %></a>
      <a href="/merch"><%= t('nav.custom_tees') %></a>
      <a href="/contests"><%= t('nav.contests') %></a>
      <a href="/about"><%= t('nav.about') %></a>
      <% if (playStoreUrl) { %><a class="btn" href="<%= playStoreUrl %>" target="_blank" rel="noopener"><%= t('nav.get_app') %></a><% } %>
      <% if (currentUser) { %>
        <a href="/account"><%= t('nav.account') %></a>
        <a href="/wallet"><%= t('nav.wallet') %></a>
        <a href="/studio"><%= t('nav.studio') %></a>
        <% if (currentUser.role === 'design_artist') { %><a href="/artist"><%= t('nav.artist') %></a><% } %>
        <% if (currentUser.role === 'tattoo_shop') { %><a href="/shop"><%= t('nav.shop') %></a><% } %>
        <% if (currentUser.role === 'admin' || currentUser.role === 'head_admin') { %><a href="/admin"><%= t('nav.admin') %></a><% } %>
        <a href="/messages"><%= t('nav.messages') %></a>
        <a href="/notifications"><%= t('nav.notifications') %><% if (typeof notifCount !== 'undefined' && notifCount > 0) { %> <span class="badge warn"><%= notifCount %></span><% } %></a>
        <a href="/logout"><%= t('nav.logout') %></a>
      <% } else { %>
        <a href="/login"><%= t('nav.login') %></a>
        <a class="btn" href="/signup"><%= t('nav.signup') %></a>
      <% } %>
    </div>
    <% if (currentUser) { %>
    <% const chipName = currentUser.display_name || currentUser.email || ''; %>
    <a class="user-chip" href="/account" aria-label="<%= t('nav.account') %>">
      <% if (currentUser.avatar_url) { %>
      <img class="user-avatar-img" src="<%= currentUser.avatar_url %>" alt="">
      <% } else { %>
      <span class="user-avatar" aria-hidden="true"><%= (chipName.charAt(0) || '?').toUpperCase() %></span>
      <% } %>
      <span class="user-name"><%= chipName %></span>
    </a>
    <% } %>
  </nav>
</header>

<% if (typeof impersonator !== 'undefined' && impersonator) { %>
<div class="flash" role="alert" style="background:#7c2d12;border-color:#f59e0b">
  Viewing as <%= currentUser.email %> (<%= currentUser.role %>)
  <form method="post" action="/admin/stop-impersonating" style="display:inline;margin-left:12px">
    <button class="btn btn-secondary" type="submit">Stop impersonating</button>
  </form>
</div>
<% } %>
<% if (flash) { %>
<div class="flash" role="alert"><%= flash %></div>
<% } %>

<%- include('partials/ad-slot', {slot: 'leaderboard'}) %>

<main id="main" class="container">
  <%- body %>
</main>

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <strong>Tattoo Art Customs™</strong>
      <p><%= t('footer.tagline') %></p>
    </div>
    <nav aria-label="<%= t('footer.nav') %>">
      <a href="/gallery"><%= t('nav.gallery') %></a>
      <a href="/membership"><%= t('nav.membership') %></a>
      <a href="/gift-cards/buy"><%= t('nav.gift_cards') %></a>
      <a href="/merch"><%= t('nav.custom_tees') %></a>
      <a href="/contests"><%= t('nav.contests') %></a>
      <a href="/aftercare"><%= t('footer.aftercare') %></a>
      <a href="/advertise"><%= t('footer.advertise') %></a>
      <a href="/terms"><%= t('footer.terms') %></a>
      <a href="/privacy"><%= t('footer.privacy') %></a>
      <a href="/about"><%= t('nav.about') %></a>
      <a href="/contact"><%= t('footer.contact') %></a>
      <% if (youtubeUrl) { %><a href="<%= youtubeUrl %>" target="_blank" rel="noopener"><%= t('footer.youtube') %></a><% } %>
      <% if (playStoreUrl) { %><a href="<%= playStoreUrl %>" target="_blank" rel="noopener"><%= t('nav.get_app') %></a><% } %>
    </nav>
  </div>
  <p class="fineprint">© <%= new Date().getFullYear() %> Tattoo Art Customs. <%= t('footer.rights') %></p>
</footer>
<div id="cookie-banner" style="display:none;position:fixed;left:0;right:0;bottom:0;background:#1a1a1a;color:#fff;padding:12px 16px;gap:12px;align-items:center;justify-content:space-between;z-index:9999;font-size:14px;">
  <span><%- t('cookie.text', {privacy: '<a href="/privacy" style="color:#ffd166;">' + t('cookie.privacy') + '</a>'}) %></span>
  <button id="cookie-ok" class="btn" style="white-space:nowrap;"><%= t('cookie.got_it') %></button>
</div>
<script>
(function () {
  // NOTE: do NOT use the `hidden` attribute on #cookie-banner — its inline
  // display:flex overrides hidden's display:none, which made the dismiss
  // button a no-op. Visibility is controlled purely via style.display.
  var b = document.getElementById('cookie-banner');
  var seen = false;
  try { seen = !!localStorage.getItem('tac_cookie_ok'); } catch (e) {}
  if (!seen) b.style.display = 'flex';
  document.getElementById('cookie-ok').addEventListener('click', function () {
    try { localStorage.setItem('tac_cookie_ok', '1'); } catch (e) {}
    b.style.display = 'none';
  });
})();
var TAC_WORKING_LABEL = <%- JSON.stringify(t('common.working')) %>;
// Double-submit protection + feedback: every POST form disables its submit
// buttons on submit so rapid clicks can't stack duplicate orders or
// subscriptions, and the user sees that something is happening.
document.addEventListener('submit', function (ev) {
  var f = ev.target;
  if (!f || f.tagName !== 'FORM') return;
  if ((f.getAttribute('method') || 'get').toLowerCase() !== 'post') return;
  if (f.dataset.submitted) { ev.preventDefault(); return; }
  f.dataset.submitted = '1';
  Array.prototype.forEach.call(f.querySelectorAll('button[type="submit"], input[type="submit"]'), function (el) {
    el.disabled = true;
    if (el.tagName === 'BUTTON' && !el.dataset.label) {
      el.dataset.label = el.textContent;
      el.textContent = TAC_WORKING_LABEL;
    }
  });
});
// Give every table cell a data-label from its column header, so the
// small-screen stacked-card table CSS can label each value.
(function () {
  document.querySelectorAll('table').forEach(function (t) {
    var heads = Array.prototype.map.call(
      t.querySelectorAll('thead th'), function (h) { return h.textContent.trim(); });
    if (!heads.length) return;
    t.querySelectorAll('tbody tr').forEach(function (r) {
      Array.prototype.forEach.call(r.children, function (c, i) {
        if (c.tagName === 'TD' && heads[i]) c.setAttribute('data-label', heads[i]);
      });
    });
  });
})();
</script>
</body>
</html>
