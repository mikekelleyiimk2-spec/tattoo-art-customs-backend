<% if (flash) { %><p class="flash"><%= flash %></p><% } %>
<h1>Payment plans</h1>
<p class="muted">Split big work across sessions. Automatic charging activates when the shop connects PayPal — until then installments are tracked here and the shop collects manually.</p>

<form method="post" action="/toolkit/plans" class="form">
  <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
  <section class="card">
    <h2>New plan</h2>
    <% if (customers && customers.length) { %>
    <label for="customer_id">Customer</label>
    <select id="customer_id" name="customer_id">
      <% customers.forEach(function(c) { %>
      <option value="<%= c.id %>"><%= c.display_name %></option>
      <% }); %>
    </select>
    <% } else { %>
    <p class="muted">No recent customers to attach a plan to yet.</p>
    <% } %>
    <label for="title">Plan title</label>
    <input type="text" id="title" name="title" maxlength="200" placeholder="e.g. Sleeve — arm 2" required>
    <label for="total_dollars">Total (dollars)</label>
    <input type="number" id="total_dollars" name="total_dollars" min="1" step="0.01" required>
    <label for="sessions_count">Sessions (2–12)</label>
    <input type="number" id="sessions_count" name="sessions_count" min="2" max="12" value="2" required>
    <label for="first_due_date">First installment due date</label>
    <input type="date" id="first_due_date" name="first_due_date">
    <p><button class="btn" type="submit">Create plan</button></p>
  </section>
</form>

<section class="card">
  <h2>Plans</h2>
  <% if (plans && plans.length) { %>
  <table class="table">
    <thead>
      <tr><th>Title</th><th>Client</th><th>Total</th><th>Sessions</th><th>Status</th></tr>
    </thead>
    <tbody>
      <% plans.forEach(function(p) { %>
      <tr>
        <td><a href="/toolkit/plans/<%= p.id %>"><%= p.title %></a></td>
        <td><%= p.customer_name %></td>
        <td>$<%= (Number(p.total_cents) / 100).toFixed(2) %></td>
        <td><%= p.sessions_count %></td>
        <td><span class="badge"><%= p.status %></span></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } else { %>
  <p class="muted">No payment plans yet.</p>
  <% } %>
</section>
