<h1><%= waiver.title %></h1>
<p class="muted">From <%= waiver.shop_name %> · appointment <%= new Date(Number(booking.start_at)).toLocaleString() %></p>
<p>Tattoo Art Customs provides this tool only and is not your lawyer. This waiver is a legal document — read it carefully before signing.</p>

<div class="legal-box">
  <pre><%= waiver.legal_text %></pre>
</div>

<% if (error) { %><p class="flash error"><%= error %></p><% } %>

<section class="card">
  <h2>Sign below</h2>
  <form method="post" action="/toolkit/waivers/sign/<%= booking.id %>" class="form" enctype="multipart/form-data">
    <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
    <label for="signer_name">Full legal name</label>
    <input type="text" id="signer_name" name="signer_name" required maxlength="200" autocomplete="name">

    <label>Signature (draw with your finger or mouse)</label>
    <canvas id="sigpad" width="600" height="220" class="sigpad"></canvas>
    <input type="hidden" id="signature_svg" name="signature_svg" value="">
    <p><button class="btn secondary" type="button" id="sigclear">Clear signature</button></p>

    <% if (idCaptureConfigured) { %>
      <label for="id_photo">ID photo (optional — encrypted at rest)</label>
      <input type="file" id="id_photo" name="id_photo" accept="image/*">
    <% } %>

    <label class="check">
      <input type="checkbox" name="agree" value="1" required>
      I have read and agree to the waiver above, and I confirm I am 18 or older.
    </label>
    <p><button class="btn" type="submit">Sign waiver</button></p>
  </form>
</section>

<script>
(function () {
  var cv = document.getElementById('sigpad');
  if (!cv) return;
  var ctx = cv.getContext('2d');
  var out = document.getElementById('signature_svg');
  var drawing = false, strokes = [], cur = [];
  function pos(e) {
    var r = cv.getBoundingClientRect();
    var t = e.touches && e.touches[0] ? e.touches[0] : e;
    return [(t.clientX - r.left) * (cv.width / r.width), (t.clientY - r.top) * (cv.height / r.height)];
  }
  function start(e) { e.preventDefault(); drawing = true; cur = [pos(e)]; strokes.push(cur); }
  function move(e) {
    if (!drawing) return;
    e.preventDefault();
    cur.push(pos(e));
    var n = cur.length;
    ctx.beginPath(); ctx.strokeStyle = '#111'; ctx.lineWidth = 3; ctx.lineCap = 'round';
    ctx.moveTo(cur[n - 2][0], cur[n - 2][1]);
    ctx.lineTo(cur[n - 1][0], cur[n - 1][1]);
    ctx.stroke();
  }
  function end(e) { if (drawing) e.preventDefault(); drawing = false; save(); }
  function save() {
    var polylines = strokes.map(function (s) {
      return '<polyline points="' + s.map(function (p) { return p[0].toFixed(1) + ',' + p[1].toFixed(1); }).join(' ') + '" fill="none" stroke="#111" stroke-width="3" stroke-linecap="round"/>';
    }).join('');
    out.value = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ' + cv.width + ' ' + cv.height + '">' + polylines + '</svg>';
  }
  cv.addEventListener('mousedown', start);
  cv.addEventListener('mousemove', move);
  document.addEventListener('mouseup', end);
  cv.addEventListener('touchstart', start, { passive: false });
  cv.addEventListener('touchmove', move, { passive: false });
  cv.addEventListener('touchend', end);
  document.getElementById('sigclear').addEventListener('click', function () {
    ctx.clearRect(0, 0, cv.width, cv.height);
    strokes = []; out.value = '';
  });
})();
</script>
