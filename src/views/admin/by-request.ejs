<h1>By-request catalog</h1>
<p><a href="/admin">← Dashboard</a></p>

<div class="grid">
  <div class="card"><h3>Total</h3><p><strong><%= total %></strong></p></div>
  <div class="card"><h3>Drawn</h3><p><strong><%= doneCount %></strong></p></div>
  <div class="card"><h3>Missing</h3><p><strong><%= missingCount %></strong></p></div>
</div>
<% if (updated) { %><p class="muted fineprint">Catalog updated <%= updated.slice(0, 10) %></p><% } %>

<div class="grid">
  <% items.forEach(function(item) { %>
  <div class="card" style="text-align:center">
    <p style="margin:0 0 8px;font-size:14px"><strong><%= item.name %></strong></p>
    <% var imgs = item.allImages || (item.img ? [item.img] : []); %>
    <% if (imgs.length) { %>
    <div style="display:flex;gap:6px;overflow-x:auto;padding-bottom:4px;justify-content:<%= imgs.length === 1 ? 'center' : 'flex-start' %>">
      <% imgs.forEach(function(src) { %>
      <img src="<%= src %>" alt="<%= item.name %>" loading="lazy" style="flex:0 0 auto;max-width:140px;height:120px;object-fit:contain;background:#f5f2ec;border-radius:4px">
      <% }); %>
    </div>
    <% } else { %>
    <div class="muted" style="height:120px;line-height:120px">—</div>
    <% } %>
  </div>
  <% }); %>
</div>
