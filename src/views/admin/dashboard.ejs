<h1>Admin dashboard</h1>
<% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'head_admin' && typeof testAccounts !== 'undefined' && testAccounts.length) { %>
<div class="card" id="view-as-switcher" style="border:2px solid #6a4fb3;margin-bottom:16px">
  <h3>View site as</h3>
  <p class="muted">Jump into your test accounts to see the site exactly as each one does. The "Stop impersonating" banner brings you back here.</p>
  <p style="margin:0">
    <span class="badge" style="background:#6a4fb3;color:#fff">Site administrator — you are here</span>
    <% testAccounts.forEach(function(a) { %>
      <a class="btn btn-secondary" style="margin:4px 4px 4px 0" href="/admin/members/<%= a.id %>/impersonate">View as <%= a.role === 'tattoo_shop' ? 'tattoo shop' : a.role === 'design_artist' ? 'designer' : a.role === 'customer' ? 'customer' : a.role %> (<%= a.display_name || a.email %>)</a>
    <% }); %>
  </p>
</div>
<% } %>
<div class="card" id="push-nudge" style="display:none;border:2px solid #6a4fb3">
  <strong>Get pushed the moment a design needs review.</strong>
  <span class="muted">Push notifications are off on this device.</span>
  <a class="btn btn-secondary" href="/notifications">Turn on push</a>
</div>
<script>
(function () {
  if (!('serviceWorker' in navigator) || !('PushManager' in window)) return;
  navigator.serviceWorker.register('/sw.js').then(function () {
    return navigator.serviceWorker.ready;
  }).then(function (reg) {
    return reg.pushManager.getSubscription();
  }).then(function (sub) {
    if (!sub) document.getElementById('push-nudge').style.display = '';
  }).catch(function () {});
})();
</script>
<div class="grid">
  <div class="card"><h3>Members</h3><p><strong><%= stats.users %></strong></p><p><a href="/admin/members">Manage</a></p></div>
  <div class="card"><h3>Designs</h3><p><strong><%= stats.designs %></strong> (<%= stats.pendingDesigns %> pending)</p><p><a href="/admin/designs">Review</a></p></div>
  <div class="card"><h3>Orders</h3><p><strong><%= stats.orders %></strong></p><p><a href="/admin/orders">Sales log</a></p></div>
  <div class="card"><h3>Custom orders</h3><p>48h fulfillment queue</p><p><a href="/admin/custom-orders">Open queue</a></p></div>
  <div class="card"><h3>Private library</h3><p>Request-only ZIP packs (admin only)</p><p><a href="/admin/library">Open library</a></p></div>
  <div class="card"><h3>Print queue</h3><p><a href="/admin/prints">Fulfill prints</a></p></div>  <div class="card"><h3>Design contests</h3><p><a href="/admin/contests">Bounty board</a></p></div>  <div class="card"><h3>Revenue (paid)</h3><p><strong><%= money(stats.revenue) %></strong></p></div>
  <div class="card"><h3>Open reviews</h3><p><strong><%= stats.openReviews %></strong></p><p><a href="/admin/reviews">Review queue</a></p></div>
  <div class="card"><h3>Design appeals</h3><p><a href="/admin/appeals">Appeals</a></p></div>
  <div class="card"><h3>Payable commissions</h3><p><strong><%= money(stats.payableOut) %></strong></p><p><a href="/admin/payouts">Payouts</a></p></div>
  <div class="card"><h3>Admins</h3><p><a href="/admin/admins">Manage admins</a></p></div>
  <div class="card"><h3>Founding program</h3><p>Caps, raffle entries, draw</p><p><a href="/admin/founding">Open</a></p></div>
  <div class="card"><h3>Ad space</h3><p>Orders + record ad-revenue payouts</p><p><a href="/admin/ads">Open</a></p></div>
</div>

<% if ((typeof designerWatch !== 'undefined' && designerWatch.length) || (typeof terminatedOrders !== 'undefined' && terminatedOrders.length)) { %>
<h2>Designer deadline watch</h2>
<div class="grid">
  <% (designerWatch || []).forEach(function(d) { %>
  <div class="card" style="<%= d.repeat_offender || d.commission_suspended ? 'border:2px solid #b3261e' : '' %>">
    <h3><%= d.display_name || d.email %></h3>
    <p class="muted"><%= d.email %></p>
    <p>
      <% if (d.commission_suspended) { %>
        <span class="badge" style="background:#b3261e;color:#fff">commissions paused</span>
      <% } else if (d.repeat_offender) { %>
        <span class="badge" style="background:#b3261e;color:#fff">repeat offender (2x penalties)</span>
      <% } else { %>
        <span class="badge warn">at risk</span>
      <% } %>
      <%= d.misses %> missed deadline<%= d.misses === 1 ? '' : 's' %> in 30 days
    </p>
    <% if (d.repeat_offender && d.liftsAt) { %>
    <p class="muted">2x penalties lift on <%= new Date(d.liftsAt).toLocaleDateString() %>.</p>
    <% } %>
    <% if (d.commission_suspended) { %>
    <p class="muted">0% commission on new sales until <%= new Date(d.commission_suspended_until).toLocaleDateString() %> — 6+ missed deadlines in 60 days. Listings stay up; account and subscription unaffected.</p>
    <form method="post" action="/admin/designers/<%= d.id %>/lift-suspension" style="margin:0 0 8px">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button class="btn btn-secondary" type="submit">Lift suspension early</button>
    </form>
    <% } %>
    <form method="post" action="/admin/designers/<%= d.id %>/forgive" style="margin:0 0 8px">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button class="btn btn-secondary" type="submit">Forgive / reset count</button>
    </form>
    <% if (d.manual_restricted) { %>
    <p><span class="badge">manually restricted</span></p>
    <form method="post" action="/admin/designers/<%= d.id %>/unsuspend" style="margin:0">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button class="btn btn-secondary" type="submit">Lift manual restriction</button>
    </form>
    <% } else { %>
    <form method="post" action="/admin/designers/<%= d.id %>/restrict" style="margin:0">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button class="btn btn-secondary" type="submit">Restrict designer (manual)</button>
    </form>
    <% } %>
  </div>
  <% }); %>
  <% (terminatedOrders || []).forEach(function(o) { %>
  <div class="card">
    <h3>Order <%= o.id.slice(0, 8) %></h3>
    <p class="muted"><%= o.buyer_email %> — replacement: <strong><%= (o.replacement_status || 'offered').replace(/_/g, ' ') %></strong></p>
    <p><a href="/admin/custom-orders/<%= o.id %>">Open order</a></p>
  </div>
  <% }); %>
</div>
<% } %>
