<h1>Designs</h1>
<p><a href="/admin">← Dashboard</a> · <a href="/admin/colorization">Colorization queue</a></p>
<table>
  <thead><tr><th>Art</th><th>Title</th><th>Artist</th><th>Status</th><th>Listing</th><th>Sales</th><th>Members</th><th></th></tr></thead>
  <tbody>
  <% designs.forEach(function(d) { %>
    <tr>
      <td>
        <% const artFile = String(d.linework_wm_path || d.linework_path || '').split('/').pop(); %>
        <% if (artFile) { %>
          <a href="/img/designs/<%= artFile %>" target="_blank" rel="noopener" title="Open full size">
            <img src="/img/designs/<%= artFile %>" alt="Artwork for <%= d.title %>" style="width:120px;height:auto;display:block;border:1px solid #ccc;">
          </a>
        <% } else { %><span class="muted">no image</span><% } %>
      </td>
      <td><%= d.title %></td>
      <td><%= d.artist_email || 'site' %></td>
      <td><span class="badge <%= d.status === 'approved' ? 'ok' : (d.status === 'pending' ? 'warn' : 'bad') %>"><%= d.status %></span>
        <% if (d.sensitivity && d.sensitivity !== 'normal') { %><span class="badge warn"><%= d.sensitivity %></span><% } %>
        <% if (d.color_pending) { %><span class="badge">color pending</span><% } %>
      </td>
      <td><span class="badge"><%= d.listing_type === 'custom' ? 'custom · portfolio' : 'pre-design · gallery' %></span></td>
      <td><%= d.sale_count %></td>
      <td>
        <% if (d.members_only) { %><span class="badge ok">members only</span><% } %>
        <form method="post" action="/admin/designs/<%= d.id %>/members-only" style="display:inline">
          <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <input type="hidden" name="members_only" value="<%= d.members_only ? '0' : '1' %>">
          <button class="btn btn-secondary" type="submit"><%= d.members_only ? 'Make public' : 'Members only' %></button>
        </form>
      </td>
      <td>
        <% if (d.status !== 'approved') { %>
        <form method="post" action="/admin/designs/<%= d.id %>/watermark" enctype="multipart/form-data" style="display:inline">
          <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <label class="muted">Watermarked linework <input type="file" name="watermark" accept="image/jpeg,image/png,image/webp"></label>
          <button class="btn btn-secondary" type="submit">Upload WM</button>
        </form>
        <% if (!d.linework_wm_path) { %><span class="badge warn">no watermarked linework</span><% } %>
        <form method="post" action="/admin/designs/<%= d.id %>/approve" style="display:inline">
          <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <button class="btn" type="submit">Approve</button>
        </form>
        <% } %>
        <% /* Reject doubles as takedown for live designs: unlists from gallery, reversible via re-approve. */ %>
        <form method="post" action="/admin/designs/<%= d.id %>/reject" style="display:inline" onsubmit="return this.reason.value.trim() ? true : (alert('Give a reason — the artist must be told why.'), false);">
          <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <input type="text" name="reason" placeholder="Reason (sent to artist)<%= d.status === 'approved' ? ' — takedown reason' : '' %>" size="28" maxlength="1000">
          <button class="btn btn-secondary" type="submit"><%= d.status === 'approved' ? 'Take down' : 'Reject' %></button>
        </form>
        <% if (d.status !== 'approved') { %>
        <% if (d.status !== 'on_hold') { %>
        <form method="post" action="/admin/designs/<%= d.id %>/hold" style="display:inline" onsubmit="return confirm('Place this piece on hold? Only a personal admin decision can approve or reject it afterwards — it will never be auto-approved.');">
          <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <button class="btn btn-secondary" type="submit">Hold</button>
        </form>
        <% } %>
        <form method="post" action="/admin/designs/<%= d.id %>/delete" style="display:inline" class="del-form">
          <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <button class="linklike del-btn" type="submit">Delete</button>
        </form>
        <% } %>
      </td>
    </tr>
  <% }); %>
  </tbody>
</table>
<script>
// Two-step delete confirmation (no native confirm() dialog, so it works with
// keyboard, automation, and mobile browsers): first click arms, second submits.
document.querySelectorAll('form.del-form').forEach(function(f) {
  f.addEventListener('submit', function(e) {
    if (!f.dataset.armed) {
      e.preventDefault();
      f.dataset.armed = '1';
      var btn = f.querySelector('.del-btn');
      btn.textContent = 'Confirm delete?';
      btn.style.color = '#c00';
      btn.style.fontWeight = 'bold';
    }
  });
});
</script>
<p class="muted">Before approving an artist upload, make sure its watermarked linework was generated (the pipeline stores it under the uploads dir, served at <code>/img/designs/</code>) and the <code>linework_wm_path</code> is set.</p>
