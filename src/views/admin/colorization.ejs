<h1>Colorization queue</h1>
<p><a href="/admin/designs">← Designs</a> · <a href="/admin">← Dashboard</a></p>
<p class="muted">Linework-only uploads waiting on the site-created color version. The piece itself
goes through the normal approval flow and may already be live with its watermarked linework —
attaching the finished color file here makes it the <strong>purchase deliverable</strong>
(delivered to buyers after purchase; never publicly listed, never watermarked for display,
never added to the designer's portfolio).</p>
<% if (!queue.length) { %>
<p class="muted">Queue is empty — nothing waiting on color.</p>
<% } %>
<table>
  <thead><tr><th>Piece</th><th>Artist</th><th>Approval status</th><th></th></tr></thead>
  <tbody>
  <% queue.forEach(function(d) { %>
    <tr>
      <td><%= d.title %></td>
      <td><%= d.artist_name || d.artist_email || '—' %></td>
      <td><span class="badge <%= d.status === 'approved' ? 'ok' : (d.status === 'pending' ? 'warn' : 'bad') %>"><%= d.status %></span></td>
      <td>
        <form method="post" action="/admin/colorization/<%= d.id %>/attach" enctype="multipart/form-data" style="display:inline">
          <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <label class="muted">Color version <input type="file" name="color" accept="image/jpeg,image/png,image/webp" required></label>
          <button class="btn btn-secondary" type="submit">Attach color version</button>
        </form>
      </td>
    </tr>
  <% }); %>
  </tbody>
</table>
