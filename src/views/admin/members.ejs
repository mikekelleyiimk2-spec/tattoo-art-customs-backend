<h1>Members</h1>
<p><a href="/admin">← Dashboard</a></p>
<table>
  <thead><tr><th>Email</th><th>Name</th><th>Role</th><th>Plan</th><th>Joined</th><th></th></tr></thead>
  <tbody>
  <% users.forEach(function(u) { %>
    <tr>
      <td><%= u.email %></td>
      <td><%= u.display_name %></td>
      <td><%= u.role %></td>
      <td><%= u.plan_name || '—' %></td>
      <td><%= new Date(u.created_at).toLocaleDateString() %></td>
      <td>
        <% if (u.role === 'tattoo_shop') { %>
        <form method="post" action="/admin/members/<%= u.id %>/verify-shop" style="display:inline">
          <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <button class="btn btn-secondary" type="submit">Verify shop</button>
        </form>
        <% } %>
        <% if (u.role !== 'admin') { %>
        <form method="post" action="/admin/members/<%= u.id %>/cancel-membership" style="display:inline" onsubmit="return confirm('Cancel this membership? No refunds per the Terms.')">
          <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <input type="hidden" name="reason" value="Terms violation">
          <button class="btn btn-secondary" type="submit">Cancel membership</button>
        </form>
        <% } %>
        <% if (isHead && u.role !== 'admin' && u.role !== 'head_admin') { %>
        <a class="btn btn-secondary" href="/admin/members/<%= u.id %>/impersonate" title="Browse the site as this account">Impersonate</a>
        <form method="post" action="/admin/members/<%= u.id %>/grant-comp" style="display:inline" onsubmit="return confirm('Grant a complimentary membership? No charge is made.')">
          <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <select name="plan">
            <option value="customer">Customer</option>
            <option value="customer_annual">Customer Annual</option>
            <option value="design_artist">Design Artist</option>
            <option value="tattoo_shop">Tattoo Shop</option>
          </select>
          <input type="number" name="months" min="1" max="36" value="12">
          <label><input type="checkbox" name="lifetime" value="1"> Lifetime</label>
          <button class="btn btn-secondary" type="submit">Grant comp</button>
        </form>
        <% } %>
      </td>
    </tr>
  <% }); %>
  </tbody>
</table>
