<h1>Custom order <%= order.id.slice(0, 8) %></h1>
<p><a href="/admin/custom-orders">← Custom orders</a></p>

<% var left = order.delivery_due ? order.delivery_due - now : null; %>
<div class="two-col">
  <section class="card">
    <h2>Brief</h2>
    <p style="white-space:pre-wrap"><%= order.custom_brief || '(no brief)' %></p>
    <p class="muted">Buyer: <strong><%= order.buyer_name || order.buyer_email %></strong> (<%= order.buyer_email %>)</p>
    <p class="muted">Deposit paid: <%= money(order.amount_paid_cents) %> via <%= order.payment_method %></p>
    <p>Status: <span class="badge"><%= order.custom_status.replace(/_/g, ' ') %></span></p>
    <p>Deadline:
      <% if (left === null) { %>—<% } else if (left < 0) { %>
        <strong class="sla-overdue">OVERDUE by <%= Math.floor(-left / 3600000) %>h</strong>
      <% } else { %>
        <%= Math.floor(left / 3600000) %>h <%= Math.floor((left % 3600000) / 60000) %>m left
        (<%= new Date(order.delivery_due).toLocaleString() %>)
      <% } %>
    </p>
    <p class="muted">Requested artist: <strong><%= order.artist_name || 'none (draft pipeline)' %></strong></p>
    <% if (order.admin_notes) { %>
    <h2>Admin notes</h2>
    <p style="white-space:pre-wrap" class="muted"><%= order.admin_notes %></p>
    <% } %>

    <h2>Late penalties</h2>
    <% if (order.designer_contract_terminated) { %>
    <p><span class="badge" style="background:#b3261e;color:#fff">Order TERMINATED at 7d overdue — designer's assignment ended (their account is unaffected)</span></p>
    <% } %>
    <% if (!penalties.length) { %>
      <p class="muted">No penalties charged. Days charged: <%= order.late_penalty_days || 0 %>.</p>
    <% } else { %>
    <table>
      <thead><tr><th>Day</th><th>Rate</th><th>Deducted</th><th>→ Owner</th><th>→ Buyer credit</th></tr></thead>
      <tbody>
      <% penalties.forEach(function(p) { %>
        <tr>
          <td>Day <%= p.day_number %></td>
          <td><% var base = p.day_number <= 4 ? 3.7 : 4.3; var mult = p.rate_mult || 1; %><%= (base * mult).toFixed(1).replace(/\.0$/, '') %>%<%= mult > 1 ? ' (2x)' : '' %> of <%= money(p.original_cents) %></td>
          <td><%= money(p.deduction_cents) %></td>
          <td><%= money(p.owner_cents) %></td>
          <td><%= money(p.credit_cents) %> (late-delivery credit)</td>
        </tr>
      <% }); %>
      </tbody>
    </table>
    <p class="muted">Totals — deducted: <strong><%= money(penaltyTotals.deduction) %></strong> ·
      owner: <%= money(penaltyTotals.owner) %> · buyer credit: <%= money(penaltyTotals.credit) %></p>
    <% } %>
    <% if (designerLedger.length) { %>
    <p class="muted">Designer commission now: <strong><%= money(designerLedger[0].amount_cents) %></strong> (<%= designerLedger[0].status %>)</p>
    <% } %>

    <% if (order.designer_contract_terminated && order.replacement_status === 'offered') { %>
    <h2>Replacement — buyer's choice</h2>
    <p class="muted">The order was terminated at 7 days overdue — the designer's assignment ended and their account is unaffected. Offer the buyer one of:</p>
    <form method="post" action="/admin/custom-orders/<%= order.id %>/replacement" class="form" style="margin-bottom:12px">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <input type="hidden" name="action" value="new_designer">
      <label for="repl_artist">1. New designer (fresh 48h deadline)</label>
      <select id="repl_artist" name="requested_artist_id">
        <% artists.forEach(function(a) { %><option value="<%= a.id %>"><%= a.display_name || 'Artist' %></option><% }); %>
      </select>
      <p><button class="btn" type="submit">Assign new designer</button></p>
    </form>
    <form method="post" action="/admin/custom-orders/<%= order.id %>/replacement" style="margin-bottom:12px">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <input type="hidden" name="action" value="owner_makes">
      <button class="btn btn-secondary" type="submit">2. Owner makes it</button>
    </form>
    <form method="post" action="/admin/custom-orders/<%= order.id %>/replacement" class="form" style="margin-bottom:12px">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <input type="hidden" name="action" value="credit">
      <label for="credit_cents">3. Website credit for a replacement design (cents)</label>
      <input id="credit_cents" name="credit_cents" type="number" min="0" value="<%= order.amount_paid_cents %>">
      <p><button class="btn btn-secondary" type="submit">Issue credit</button></p>
    </form>
    <form method="post" action="/admin/custom-orders/<%= order.id %>/replacement" style="margin-bottom:12px">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <input type="hidden" name="action" value="predesigns">
      <button class="btn btn-secondary" type="submit">4. Equivalent value in pre-designs + edits</button>
    </form>
    <% } else if (order.replacement_status && order.replacement_status !== 'offered') { %>
    <p class="muted">Replacement choice: <strong><%= order.replacement_status.replace(/_/g, ' ') %></strong></p>
    <% } %>
  </section>

  <section class="card">
    <h2>Drafts (<%= drafts.length %>)</h2>
    <% if (!drafts.length) { %>
      <p class="muted">No drafts yet. The draft worker picks this order up automatically when it is in “needs drafts”.</p>
    <% } %>
    <% drafts.forEach(function(d, i) { %>
      <figure style="margin:0 0 16px">
        <img src="/admin/custom-orders/<%= order.id %>/draft/<%= d.file %>" alt="Draft <%= i + 1 %>" style="max-width:100%;border-radius:8px">
        <% if (d.note) { %><figcaption class="muted"><%= d.note %></figcaption><% } %>
      </figure>
    <% }); %>

    <h2>Actions</h2>
    <% if (['drafts_ready', 'in_revision'].includes(order.custom_status)) { %>
    <form method="post" action="/admin/custom-orders/<%= order.id %>/approve" style="margin-bottom:12px">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button class="btn" type="submit">Approve drafts</button>
    </form>
    <form method="post" action="/admin/custom-orders/<%= order.id %>/request-changes" class="form" style="margin-bottom:12px">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <label for="note">Request changes (notes for the artist / draft run)</label>
      <textarea id="note" name="note" maxlength="2000" placeholder="What needs fixing…"></textarea>
      <p><button class="btn btn-secondary" type="submit">Send back for revision</button></p>
    </form>
    <% } %>
    <form method="post" action="/admin/custom-orders/<%= order.id %>/reassign" class="form" style="margin-bottom:12px">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <label for="requested_artist_id">Reassign to artist</label>
      <select id="requested_artist_id" name="requested_artist_id">
        <option value="">— draft pipeline (no artist) —</option>
        <% artists.forEach(function(a) { %>
        <option value="<%= a.id %>"<%= order.requested_artist_id === a.id ? ' selected' : '' %>><%= a.display_name || 'Artist' %></option>
        <% }); %>
      </select>
      <p><button class="btn btn-secondary" type="submit">Reassign</button></p>
    </form>
    <% if (order.custom_status !== 'delivered') { %>
    <form method="post" action="/admin/custom-orders/<%= order.id %>/deliver" style="margin-bottom:12px"
          onsubmit="return confirm('Mark this custom order delivered? Attach the final files first if you have not.')">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button class="btn" type="submit">Mark delivered</button>
    </form>
    <p class="muted">Attach final color + linework files from the <a href="/admin/orders">sales log</a> (order <%= order.id.slice(0, 8) %>) before delivering.</p>
    <% } %>
  </section>
</div>
<style>.sla-overdue { color: #b3261e; }</style>
