# Tattoo Art Customs — backend configuration
# Copy to .env and fill in. NEVER commit a real .env.

# --- Server ---
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-this-to-a-long-random-string

# --- Database ---
# Production: set DATABASE_URL to your PostgreSQL connection string.
# Local dev: leave DATABASE_URL empty to use SQLite at SQLITE_PATH.
DATABASE_URL=
SQLITE_PATH=./data/app.db

# --- File assets (design images, uploads) ---
# Layout inside ASSET_DIR:
#   designs/color/        full-color designs (PRIVATE — never served publicly)
#   designs/linework/     clean linework (PRIVATE — never served publicly)
#   designs/linework-wm/  watermarked linework (PUBLIC gallery serves ONLY these)
#   uploads/photos/       member tattoo photos
#   uploads/designs/      artist upload staging (color + linework)
ASSET_DIR=./assets

# --- PayPal (owner: paste from https://developer.paypal.com/dashboard/) ---
# 1. Create a REST app at developer.paypal.com -> Apps & Credentials.
# 2. Copy the Client ID and Secret below.
# 3. Create one Product, then three Subscription Plans (see SETUP.md) and
#    paste the Plan IDs. Mode is "sandbox" for testing, "live" for real money.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_CUSTOMER=
PAYPAL_PLAN_ARTIST=
PAYPAL_PLAN_SHOP=

# --- Admin seed (used by `npm run seed` only) ---
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-this-immediately

# --- Email (optional; password resets print to console when unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Tattoo Art Customs <no-reply@example.com>
